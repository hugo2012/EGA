FUNCTION ZWF_APP_STA_HTML.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  TABLES
*"      IT_APP_STAT TYPE  ZPPM_WF_APP_STAT_TT
*"      ET_APP_STAT_HTML TYPE  ZTT_SOLISTI1
*"----------------------------------------------------------------------

"Function Group - ZWF_MOBILE
***********************************************************************
*  M O D I F I C A T I O N    L O G                                   *
***********************************************************************
*    Date   | TR Number  | Developement/  |       Description         *
*           |            | Modification   |                           *
***********************************************************************
*09.10.2026  DSDK9A0FBW  CRQ#CHG0029188   Log Issue E454
*                                         add time to display under approve on
*
*
*
*---------------------------------------------------------------------

  DATA lv_date(10) TYPE c.
  DATA lv_datetime(25) TYPE c.
  DATA lv_time(10) TYPE c.
  DATA: lv_text1   TYPE char255,
    lv_discurr TYPE text20.

  CLEAR : it_html_contents.
  lv_text1 =  '<table border="1" width="70%"><col width="40" /><col width="20" />'.
  PERFORM fill_lines6 USING lv_text1.
  CLEAR: lv_text1.

  lv_text1 =  '<col width="40" /><col width="20" /><col width="20" /><col width="20" />'.
  PERFORM fill_lines6 USING lv_text1.
  CLEAR: lv_text1.


  lv_text1 = '<tr>'.
  PERFORM fill_lines6 USING lv_text1.
  CLEAR: lv_text1.

  CONCATENATE '<th>' '<p><code><B>'
                      'Seq no' '</B></p></code>' '</th>'
                INTO  lv_text1.
  PERFORM fill_lines6 USING lv_text1.
  CLEAR: lv_text1.

  CONCATENATE '<th>' '<p><code><B>'
                      'Role' '</B></p></code>' '</th>'
                INTO  lv_text1.
  PERFORM fill_lines6 USING lv_text1.
  CLEAR: lv_text1.

  CONCATENATE '<th>' '<p><code><B>'
                      'Status' '</B></p></code>' '</th>'
                INTO  lv_text1.
  PERFORM fill_lines6 USING lv_text1.
  CLEAR: lv_text1.

  CONCATENATE '<th>' '<p><code><B>'
                      'Approver' '</B></p></code>' '</th>'
                INTO  lv_text1.
  PERFORM fill_lines6 USING lv_text1.
  CLEAR: lv_text1.

  CONCATENATE '<th>' '<p><code><B>'
                      'Approved By' '</B></p></code>' '</th>'
                INTO  lv_text1.
  PERFORM fill_lines6 USING lv_text1.
  CLEAR: lv_text1.

  CONCATENATE '<th>' '<p><code><B>'
                      'Approved on' '</B></p></code>' '</th>'
                INTO  lv_text1.
  PERFORM fill_lines6 USING lv_text1.
  CLEAR: lv_text1.

  lv_text1 =  '</tr>'.
  PERFORM fill_lines6 USING lv_text1.
  CLEAR: lv_text1, wa_body.

  LOOP AT IT_APP_STAT INTO DATA(ls_ppm).
*    CHECK wa_ppm-tdline IS NOT INITIAL.
    "1
    lv_text1 =  '<tr>'.
    PERFORM fill_lines6 USING lv_text1.
    CLEAR: lv_text1.

    CONCATENATE '<td>' '<p><code><B>'
                ls_ppm-seqno '</B></p></code>' '</td>'
          INTO  lv_text1.
    PERFORM fill_lines6 USING lv_text1.
    CLEAR: lv_text1.

    CONCATENATE '<td>' '<p><code><B>'
                ls_ppm-role '</B></p></code>' '</td>'
          INTO  lv_text1.
    PERFORM fill_lines6 USING lv_text1.
    CLEAR: lv_text1.

    CONCATENATE '<td>' '<p><code><B>'
                ls_ppm-status '</B></p></code>' '</td>'
          INTO  lv_text1.
    PERFORM fill_lines6 USING lv_text1.
    CLEAR: lv_text1.

    CONCATENATE '<td>' '<p><code><B>'
                ls_ppm-app_name '</B></p></code>' '</td>'
          INTO  lv_text1.

    PERFORM fill_lines6 USING lv_text1.
    CLEAR: lv_text1.

    CONCATENATE '<td>' '<p><code><B>'
        ls_ppm-app_by '</B></p></code>' '</td>'
          INTO  lv_text1.

    PERFORM fill_lines6 USING lv_text1.
    CLEAR: lv_text1.

********begin of DSDK9A0FBW ***************************************************
     IF ls_ppm-ap_datetim  IS NOT INITIAL.
        WRITE ls_ppm-ap_datetim TO lv_date  DD/MM/YYYY .
     ELSE.
        CLEAR lv_date .
     ENDIF.

    " 2. Format Time to HH:MM:SS (e.g., 09:00:10)
    IF ls_ppm-ap_time IS NOT INITIAL.
      WRITE ls_ppm-ap_time TO lv_time USING EDIT MASK '__:__:__'.
    ELSE.
      CLEAR : lv_time .
    ENDIF.

    " 3. Combine Date and Time with space separator (e.g., "09/10/2026 09:00:19")
    CONCATENATE lv_date lv_time INTO lv_datetime SEPARATED BY space.

    CONCATENATE '<td>' '<p><code><B>'
        lv_datetime  '</B></p></code>' '</td>'
                 INTO  lv_text1.
********End of DSDK9A0FBW ***************************************************
    PERFORM fill_lines6 USING lv_text1.
    CLEAR: lv_text1.

    lv_text1 =  '</tr>'.
    PERFORM fill_lines6 USING lv_text1.
    CLEAR: lv_text1, wa_body.


  ENDLOOP.
  lv_text1 =  '</table>'.
  PERFORM fill_lines6 USING lv_text1.
  CLEAR: lv_text1.
  IF it_html_contents is NOT INITIAL.
   LOOP AT it_html_contents ASSIGNING FIELD-SYMBOL(<fs_html_content>).
     APPEND INITIAL LINE TO et_app_stat_html ASSIGNING FIELD-SYMBOL(<fs_app_html>).
     MOVE-CORRESPONDING <fs_html_content> to <fs_app_html>.
   ENDLOOP.
  ENDIF.
  CLEAR : it_html_contents.
ENDFUNCTION.
