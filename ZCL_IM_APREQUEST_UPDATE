* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_IM_APREQUEST_UPDATE=>GET_RULE_DETTAILS
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_RULE_ID                      TYPE        HR_SOBJID (default ='90000054')
* | [<---] T_PTNR_CHECKS                  TYPE        ZFI_AR_PATNR_CHKS_TBL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_rule_dettails.

    DATA: respo_tab    TYPE STANDARD TABLE OF hrobject,
          ls_ptnr_chks TYPE zfi_ar_patnr_chks,
          i1218        TYPE STANDARD TABLE OF p1218,
          it1218       TYPE STANDARD TABLE OF hrt1218,
          contdef      TYPE STANDARD TABLE OF swcontdef,
          objects      TYPE STANDARD TABLE OF hrobject.

    CALL FUNCTION 'RH_GET_ACTOR_ATTRIBUTES'
      EXPORTING
        act_otype        = 'AC'
        act_objid        = i_rule_id
        AUTHORITY_CHECK  = ' '
      TABLES
        act_cont_def     = contdef
      EXCEPTIONS
        object_not_found = 1
        OTHERS           = 2.
    IF sy-subrc GT 0.
    ENDIF.

    CALL FUNCTION 'RH_DEPENDENT_OBJECTS_HANDLE'
      EXPORTING
        act_plvar         = '01'
        parent_otype      = 'AC'
        parent_objid      = i_rule_id
        act_begda         = sy-datum
        act_endda         = sy-datum
        confirm_flag      = ''
      TABLES
        dependent_objects = respo_tab
      EXCEPTIONS
        OTHERS            = 0.
    LOOP AT respo_tab INTO DATA(ls_respo).
      REFRESH: i1218, it1218, objects.

      CALL FUNCTION 'RH_READ_INFTY_NNNN'
        EXPORTING
          AUTHORITY = ' '
          infty   = '1218'
          plvar   = ls_respo-plvar
          otype   = ls_respo-otype
          objid   = ls_respo-objid
          begda   = sy-datum
          endda   = sy-datum
        TABLES
          innnn   = i1218
          objects = objects
        EXCEPTIONS
          OTHERS  = 0.

      CALL FUNCTION 'RH_READ_INFTY_TABDATA'
        EXPORTING
          infty          = '1218'
          return_initial = space
        TABLES
          innnn          = i1218
          hrtnnnn        = it1218
        EXCEPTIONS
          no_table_infty = 1
          innnn_empty    = 2
          nothing_found  = 3
          OTHERS         = 4.

      READ TABLE it1218 INTO DATA(ls_t1218) WITH KEY element =  'ARTYPE'.
      IF sy-subrc EQ 0.
        ls_ptnr_chks-artype = ls_t1218-expr_low.
