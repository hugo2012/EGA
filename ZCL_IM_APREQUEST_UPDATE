            result_tab      = p_result_tab
            result_struc    = lt_struc
          EXCEPTIONS
            no_plvar_found  = 1
            no_entry_found  = 2
            OTHERS          = 3.
        IF sy-subrc EQ 0.
          APPEND VALUE #( otype = 'S' objid = i_ccownpos ) TO p_result_tab.
          READ TABLE p_result_tab TRANSPORTING NO FIELDS WITH KEY otype = 'S'
