* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_IM_APREQUEST_UPDATE=>VALIDATE_USER
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_PARTNER                      TYPE        RIHPATAB(optional)
* | [--->] I_MASTER_DATA                  TYPE        RIMAK(optional)
* | [--->] I_INVESTMENT_PROGRAM           TYPE        BADIAPPREQ_PROGALLOCTAB(optional)
* | [--->] I_IMAKPA                       TYPE        IMAKPA(optional)
* | [--->] I_INVESTMENT_REASON            TYPE        RIMAKPITAB(optional)
* | [--->] I_AKTYP                        TYPE        AKTYP(optional)
* | [<---] E_INVALID                      TYPE        CHAR1
* | [<---] E_RETURN                       TYPE        ZFI_AR_MESSAGES_STRUC
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD validate_user.

    DATA : lv_ivart       TYPE ima_ivart,
           lt_ptnr_checks TYPE zfi_ar_patnr_chks_tbl,
           lv_imparvw     TYPE parvw,
           lv_pernr       TYPE pernr_d,
           lv_imuser      TYPE usrid,
           lv_kostl       TYPE kostl,
           lr_grade       TYPE zhr_range_trfst,
           lv_hierarchy   TYPE char1,
           lv_level       TYPE numc2,
           lv_user        TYPE usrid,
           lt_return      TYPE STANDARD TABLE OF zfi_ar_messages_struc,
           lt_arpartner   TYPE STANDARD TABLE OF zps_arpartner,
           wa_jest        TYPE jest,
           lr_level       TYPE zhr_range_level,
           ls_text        TYPE text120.
    DATA: r_stat TYPE RANGE OF j_status.
*   "Check Status Create & Rejected only
    r_stat = VALUE #( ( sign = 'I' option = 'EQ' low = 'I0001' ) ( sign = 'I' option = 'EQ' low = 'I0359' ) ).
    CHECK sy-tcode EQ 'IMA11' OR sy-tcode EQ 'IMA2N'.
    IF i_aktyp NE 'I'.
*  First created and then change the status.
      SELECT SINGLE *
        INTO wa_jest
        FROM jest
       WHERE objnr EQ i_master_data-objnr
         AND stat  IN r_stat
         AND inact EQ ''.
      CHECK sy-subrc EQ 0.
    ENDIF.
    CALL FUNCTION 'HR_READ_INFOTYPE_AUTHC_DISABLE'.

    zcl_im_aprequest_update=>get_rule_dettails(
      EXPORTING
        i_rule_id     = '90000054'
      IMPORTING
        t_ptnr_checks = lt_ptnr_checks ).

*  "Check Whetehr AR Partner type EN, YU is mandtory not based on Investment Reason
*    IF i_master_data-ivart EQ 'EN'.
*   "Fetch Reason of Investment from TVARV Table
    DATA(lt_rinvestment) =  zcl_sd_utility=>get_tvarv( name = 'ZAR_IZWEK' type = 'S' ).
    IF lt_rinvestment[] IS NOT INITIAL.
*     "Check whether its related to YU paramerer not
      LOOP AT i_investment_reason INTO DATA(lwa_int_reason) WHERE izwek IN lt_rinvestment. ENDLOOP.
      IF sy-subrc EQ 0.
        READ TABLE i_partner INTO DATA(lwa_partner1) WITH KEY parvw  = 'YU'.
        IF sy-subrc NE 0.
          e_invalid = 'X'.
          e_return-ivart  = i_master_data-ivart.
          e_return-parvw = 'YU'.
          e_return-vtext = get_partnertext( e_return-parvw ).
          e_return-message = |Partner YU is missing.|.
          APPEND e_return TO lt_return.
        ENDIF.
      ENDIF.
    ENDIF.
*    ENDIF.
    READ TABLE lt_ptnr_checks TRANSPORTING NO FIELDS WITH KEY artype = i_master_data-ivart.
    IF sy-subrc NE 0.
      lv_ivart = 'OT'.
    ELSE.
      lv_ivart = i_master_data-ivart.
    ENDIF.

    LOOP AT  i_partner INTO DATA(ls_partner).
      CLEAR: e_invalid, e_return.
      READ TABLE lt_ptnr_checks TRANSPORTING NO FIELDS WITH KEY artype = lv_ivart "i_master_data-ivart
                                                                patype = ls_partner-parvw.
      IF sy-subrc EQ 0.
        CLEAR : lv_kostl, lv_level, lv_hierarchy, lv_imparvw, lv_imuser, lv_user, lr_level.
        REFRESH lr_grade.

        LOOP AT lt_ptnr_checks INTO DATA(ls_ptnr_checks) WHERE artype EQ lv_ivart "i_master_data-ivart
                                                           AND patype EQ ls_partner-parvw.
          CASE ls_ptnr_checks-fieldname.
            WHEN 'CCTYPE'.
              CASE ls_ptnr_checks-value.
                WHEN 'RQ'.
                  lv_kostl =  i_imakpa-akostl.
                WHEN 'RS'.
                  lv_kostl = i_master_data-vkostl.
                WHEN 'I1'.
                  lv_imparvw = ls_ptnr_checks-value.
              ENDCASE.
            WHEN 'GRADE'.
              APPEND VALUE #( sign = 'I' option = 'EQ' low = ls_ptnr_checks-value ) TO lr_grade.
            WHEN 'HIERARCHY'.
              lv_hierarchy = ls_ptnr_checks-value.
            WHEN 'LEVEL'.
              lv_level = ls_ptnr_checks-value.
              APPEND VALUE #( sign = 'I' option = 'EQ' low = ls_ptnr_checks-value ) TO lr_level.
          ENDCASE.
        ENDLOOP.
        IF sy-subrc EQ 0.
          IF lv_hierarchy EQ 'A'.
            READ TABLE lr_grade INTO DATA(ls_grade) INDEX 1.
            IF sy-subrc EQ 0.
              SEARCH sy-abcde FOR ls_grade-low.
              DATA(lv_number) = sy-fdpos.
              DO 10 TIMES.
                IF lv_number LT 0.
                  EXIT.
                ENDIF.
                APPEND VALUE #( sign = 'I' option = 'EQ' low = sy-abcde+lv_number(1) ) TO lr_grade.
                IF sy-abcde+lv_number(1) EQ 'C'.
                  APPEND VALUE #( sign = 'I' option = 'EQ' low = 'C1' ) TO lr_grade.
                ENDIF.
                lv_number = lv_number - 1.
              ENDDO.
            ENDIF.
          ENDIF.
          IF lv_hierarchy EQ 'S'.
            READ TABLE i_partner INTO DATA(ls_impartner) WITH KEY parvw = lv_imparvw.
            IF sy-subrc EQ 0.
              lv_imuser = ls_impartner-parnr.
            ENDIF.
          ENDIF.

          lv_user = ls_partner-parnr.
          zcl_im_aprequest_update=>user_grade_check_with_level(
            EXPORTING
              i_user    = lv_user
              i_kostl   = lv_kostl
              i_trfst   = lr_grade
              i_level   = lv_level
              i_heir    = lv_hierarchy
              i_imuser  = lv_imuser
              ir_level  = lr_level
            IMPORTING
              e_invalid = e_invalid
              e_return  = e_return ).
        ENDIF.

        IF e_invalid EQ 'X'.
          e_return-ivart   = i_master_data-ivart.
          e_return-parvw   = ls_partner-parvw.
          e_return-vtext   = get_partnertext( ls_partner-parvw ).
          e_return-parnr   = ls_partner-parnr.
          APPEND e_return TO lt_return.
        ENDIF.

      ELSE.

        READ TABLE i_investment_program INTO DATA(ls_investment_program) INDEX 1.
        IF sy-subrc EQ 0.
          SELECT SINGLE parnr FROM zim_pos_partner
            INTO @DATA(ls_defpartner)
           WHERE posid EQ @ls_investment_program-program_pos
             AND zim_rectype EQ 'D'
             AND patner EQ @ls_partner-parvw.
          IF sy-subrc EQ 0.
            IF ls_defpartner NE ls_partner-parnr AND sy-subrc EQ 0.
              e_invalid = 'X'.
              e_return-ivart   = i_master_data-ivart.
              e_return-parvw   = ls_partner-parvw.
              e_return-vtext   = get_partnertext( ls_partner-parvw ).
              e_return-parnr   = ls_partner-parnr.
              e_return-message = |Not maintained as per Table ZIM_POS_PARTNER. Partner Should be { ls_defpartner }|.
              APPEND e_return TO lt_return.
            ENDIF.
          ELSE.
            REFRESH: lt_arpartner.
            SELECT * FROM zps_arpartner
              INTO TABLE lt_arpartner
             WHERE parvw EQ ls_partner-parvw
               AND inact EQ ''.
            CHECK sy-subrc EQ 0.
            READ TABLE lt_arpartner INTO DATA(lwa_arpartner) WITH KEY parnr = ls_partner-parnr.
            IF sy-subrc NE 0.
             CLEAR: ls_text.
*            IF ls_defpartner NE ls_partner-parnr AND sy-subrc EQ 0.
              e_invalid = 'X'.
              e_return-ivart  = i_master_data-ivart.
              e_return-parvw = ls_partner-parvw.
              e_return-vtext   = get_partnertext( ls_partner-parvw ).
              e_return-parnr = ls_partner-parnr.
              LOOP AT lt_arpartner INTO lwa_arpartner.
               IF sy-tabix EQ '1'.
                ls_text = lwa_arpartner-parnr.
               ELSE.
                ls_text = ls_text && 'or' && lwa_arpartner-parnr.
               ENDIF.
              ENDLOOP.
              e_return-message = |Not maintained as per Table ZPS_ARPARTNER. Partner should be { ls_text }|.
              APPEND e_return TO lt_return.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDLOOP.
*   Display Error Messages
    IF lt_return[] IS NOT INITIAL.
      CALL FUNCTION 'REUSE_ALV_POPUP_TO_SELECT'
        EXPORTING
          i_title               = 'Partner Validations'
          i_selection           = ' '
          i_zebra               = 'X'
          i_screen_start_column = 0
          i_screen_start_line   = 0
          i_screen_end_column   = 0
          i_screen_end_line     = 0
          i_tabname             = 'LT_RETURN'
          i_structure_name      = 'ZFI_AR_MESSAGES_STRUC'
        TABLES
          t_outtab              = lt_return
        EXCEPTIONS
          program_error         = 1.
      e_invalid = 'X'.
    ENDIF.


  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_IM_APREQUEST_UPDATE->__CHANGE_PARTNER
* +-------------------------------------------------------------------------------------------------+
* | [--->] AKTYP                          TYPE        AKTYP
* | [--->] MASTER_DATA                    TYPE        RIMAK
* | [--->] INVESTMENT_PROGRAM             TYPE        BADIAPPREQ_PROGALLOCTAB
* | [--->] PARTNER                        TYPE        RIHPATAB
* | [--->] APPREQUEST_STATUS              TYPE        TBAPIAPPREQSTATUS
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD __change_partner.
* This Method is also responsible to change partner
* ALready logic is implemented in ZFI_PARTNER_CHECK but it will
* be called when user will be in TAB1 ( Partner Tab) otherwise it
* will be skipped
* To overcome above issue, below logic is implemented at time of Save
* CRQ No: 28668
* Transport No 943978
    DATA: lwa_status        TYPE bapiappreqstatus,
          lv_change_partner,
          lv_program        TYPE badiappreq_progalloc.
    DATA: lv_tabix TYPE sy-tabix.
    DATA: lv_parnr TYPE i_parnr.
    DATA: lv_fname TYPE string VALUE '(SAPLIPAR)XIHPA[]'.
    DATA: lwa_partner TYPE rihpa.
    DATA: lt_pos_partner  TYPE STANDARD TABLE OF zim_pos_partner,
          lwa_pos_partner TYPE zim_pos_partner.

    FIELD-SYMBOLS: <ft_xihpa> TYPE tt_ihpavb,
                   <fs_xihpa> TYPE ihpavb.
* Check SAP Transaction Category
* Change or Delete
    CHECK aktyp EQ 'I' OR aktyp EQ 'U'.
* "Check AR Status
* "AR Status should be created or rejected
    LOOP AT  apprequest_status INTO lwa_status.
      CASE lwa_status-status.
*     "Status is created
        WHEN 'I0001' OR 'I0359'.
          lv_change_partner = 'X'.
          EXIT.
*     "Status is For Approval then check the previous status
*     "it should be Rejected or Created in DB means user is
*     "submitting it
        WHEN 'I0354'.
*       "Check Previous status
*        lv_change_partner = me->__get_status( master_data ).
*        EXIT.
      ENDCASE.
    ENDLOOP.

    CHECK lv_change_partner IS NOT INITIAL.
* "Get Investment program name
    READ TABLE investment_program INTO lv_program INDEX 1.
    CHECK sy-subrc EQ 0 AND lv_program-program_pos IS NOT INITIAL.
* "Fetch Default partner for the Position ID
    SELECT * FROM zim_pos_partner
      INTO TABLE lt_pos_partner
     WHERE posid EQ lv_program-program_pos
       AND zim_rectype EQ 'D'.

    CHECK lt_pos_partner[] IS NOT INITIAL.
    CLEAR: lv_change_partner.
* "Check whether whether default partner is already there in Partner
* "table then no need to change and flag lv_change_partner will be
* "initial
    LOOP AT partner INTO lwa_partner.
*   "Read partner maintained in custom table
      READ TABLE lt_pos_partner INTO lwa_pos_partner
                            WITH KEY patner = lwa_partner-parvw.
      CHECK sy-subrc EQ 0.
*   "If its not matching with current partner
      CHECK lwa_partner-parnr NE lwa_pos_partner-parnr.
*   "Set the flag
      lv_change_partner = 'X'.
      EXIT.
    ENDLOOP.
* "Check flag is not initial means some parnter is not matching
* "with default partner maintained in DB table
    CHECK lv_change_partner EQ 'X'.
* "Get Partner name from run time and modify it
    ASSIGN (lv_fname) TO <ft_xihpa>.
* "Check whether is assigned or not
    CHECK <ft_xihpa> IS ASSIGNED.

    LOOP AT <ft_xihpa> ASSIGNING <fs_xihpa>.
*  "Read partner from DB table
      READ TABLE lt_pos_partner INTO lwa_pos_partner
                            WITH KEY patner = <fs_xihpa>-parvw.
      CHECK sy-subrc EQ 0.
*   Check default partner with DB partner
      CHECK <fs_xihpa>-parnr NE lwa_pos_partner-parnr.
*   "Change Partner
      <fs_xihpa>-parnr = lwa_pos_partner-parnr.
*   "Update Flag so partner would be changed
      IF <fs_xihpa>-updkz IS INITIAL.
        <fs_xihpa>-updkz = 'U'.
      ENDIF.
*    EXIT.
    ENDLOOP.

  ENDMETHOD.


