* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_IM_APREQUEST_UPDATE->__RAISE_COST_MESSAGE
* +-------------------------------------------------------------------------------------------------+
* | [--->] AKTYP                          TYPE        AKTYP
* | [--->] MASTER_DATA                    TYPE        RIMAK
* | [--->] APPREQUEST_STATUS              TYPE        TBAPIAPPREQSTATUS
* | [--->] VARIANTS                       TYPE        RIMAVTAB(optional)
* | [--->] I_TOTVALUE                     TYPE        INVKOS(optional)
* | [EXC!] ERROR_WITH_MESSAGE
* | [EXC!] WARNING_WITH_MESSAGE
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD __raise_cost_message.
* This method is responsible to raise message if total estimated
* cost is more than 25,000 $
* CRQ No: 109623
* Transport No DSDK949451
* CRQ 112907
* Transport No:DSDK960216, Remove Error message to Warning if AR
* value is less than 25K USD
    DATA: lwa_status TYPE bapiappreqstatus.
    DATA: lv_created,
          lv_estimated_cost TYPE bp_wgt,
          lt_bpge           TYPE tt_bpge,
          lwa_bpge          TYPE type_t_bpge,
          lwa_variants      LIKE LINE OF  variants,
          lv_totvalue       TYPE invkos,
          lv_txn_curr       TYPE waers,
          lv_fname          TYPE char30 VALUE '(SAPLAIA9)GD_TXN_CURR'.
    FIELD-SYMBOLS: <fs_curr> TYPE waers.
    DATA: lv_string TYPE string,
          lv_answer.
    CHECK master_data-ivart NE 'MM'.                        "CRQ112799
* Check SAP Transaction Category
* Change or Create
    CHECK aktyp EQ 'I' OR aktyp EQ 'U'.
* Check AR Status
* AR Status should be created or rejected
    LOOP AT  apprequest_status INTO lwa_status.
      CASE lwa_status-status.
*     "Status is created or Rejected (Fields opens in rejected status)
        WHEN 'I0001' OR 'I0359'.
*       "Set Indicator to display message
          lv_created = 'X'.
          EXIT.
*     "Status is For Approval then check the previous status
*     "it should be Rejected or Created in DB means user just
*     "submit it then message should display
        WHEN 'I0354'.
*   "   Check Previous status
          lv_created = me->__get_status( master_data ).
          EXIT.
      ENDCASE.
    ENDLOOP.

    lv_totvalue = i_totvalue.

* Fetch variant
    READ TABLE variants INTO  lwa_variants INDEX 1.

    IF lv_totvalue IS INITIAL.
* "Fetch from Database
      SELECT objnr
              wrttp
              twaer
              wtges
         INTO TABLE lt_bpge
         FROM bpge
         WHERE objnr EQ lwa_variants-objnr
           AND wrttp EQ '39'.

      READ TABLE lt_bpge INTO lwa_bpge INDEX 1.
      IF sy-subrc EQ 0.
        lv_totvalue = lwa_bpge-wtges.
        lwa_variants-t001waers = lwa_bpge-twaer.
      ENDIF.
    ELSE.
      ASSIGN (lv_fname) TO <fs_curr>.
      IF <fs_curr> IS ASSIGNED.
        lwa_variants-t001waers = <fs_curr>.
      ENDIF.
    ENDIF.
* "Check If total estimated cost is more than 130 percent of total
* "approved cost.
* "Fetch Estimated Cost and Covert it to USD
    zcl_im_aprequest_update=>convert_amt_usd(
                        EXPORTING
                         i_amount   = lv_totvalue "master_data-usr06
                         i_currency = lwa_variants-t001waers "master_data-use06
                         IMPORTING
                          e_amount  = lv_estimated_cost ).

* "Display message at the time of creation only
    IF lv_created IS NOT INITIAL.
      IF lv_estimated_cost LT '25000'.
        sy-msgid = 'ZFI'.
        sy-msgty = 'W'.                                     "DSDK960216
        sy-msgno = '000'.
        sy-msgv1 = 'Total Estmd/CEP should be >= 25,000 USD'(024).
        RAISE error_with_message.
      ELSEIF lv_estimated_cost GE '25000' AND lv_estimated_cost LT '100000'.
        CONCATENATE text-020 text-021 INTO lv_string SEPARATED BY space.
*    "Popup confirmation here
        CALL FUNCTION 'POPUP_TO_CONFIRM'
          EXPORTING
            titlebar              = text-005
            text_question         = lv_string
            text_button_1         = text-022
            text_button_2         = text-023
            display_cancel_button = ' '
          IMPORTING
            answer                = lv_answer
          EXCEPTIONS
            text_not_found        = 1
            OTHERS                = 2.
        IF lv_answer NE '1'.
          sy-msgid = 'ZFI'.
          sy-msgty = 'E'.
          sy-msgno = '000'.
          sy-msgv1 = text-020.
          sy-msgv2 = text-021.
          RAISE error_with_message.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_IM_APREQUEST_UPDATE->__RAISE_MESSAGE
* +-------------------------------------------------------------------------------------------------+
* | [--->] AKTYP                          TYPE        AKTYP
* | [--->] MASTER_DATA                    TYPE        RIMAK
* | [--->] APPREQUEST_STATUS              TYPE        TBAPIAPPREQSTATUS
* | [EXC!] ERROR_WITH_MESSAGE
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD __raise_message.
* This method is responsible to raise message if total estimated
* cost is more than 130% of total approved cost
* CRQ No: 28668
* Transport No 943978
    DATA: lwa_status TYPE bapiappreqstatus.
    DATA: lv_created,
          lv_forapproval,
          lv_difference     TYPE ima_usr06,
          lv_percent        TYPE int4,
          lv_quest          TYPE text255,
          lv_answer,
          lv_estimated_cost TYPE bp_wgt,
          lv_approved_cost  TYPE bp_wgt..
* Check SAP Transaction Category
* Change or Delete
    CHECK aktyp EQ 'I' OR aktyp EQ 'U'.
* Message should come only for budgted AR
    CHECK master_data-usr10 EQ 'X' .

* Check AR Status
* AR Status should be created or rejected
    LOOP AT  apprequest_status INTO lwa_status.
      CASE lwa_status-status.
*     "Status is created or Rejected (Fields opens in rejected status)
        WHEN 'I0001' OR 'I0359'.
*       "Set Indicator to display message
          lv_created = 'X'.
          EXIT.
*     "Status is For Approval then check the previous status
*     "it should be Rejected or Created in DB means user just
*     "submit it then message should display
        WHEN 'I0354'.
*   "   Check Previous status
          lv_created = me->__get_status( master_data ).
          EXIT.
      ENDCASE.
    ENDLOOP.
* "Check If total estimated cost is more than 130 percent of total
* "approved cost.
* "Fetch Estimated Cost and Covert it to USD
    zcl_im_aprequest_update=>convert_amt_usd(
                        EXPORTING
                         i_amount   = master_data-usr06
                         i_currency = master_data-use06
                         IMPORTING
                          e_amount  = lv_estimated_cost ).

* "Fetch Approved Cost and Covert it to USD
    zcl_im_aprequest_update=>convert_amt_usd(
                        EXPORTING
                         i_amount   = master_data-usr07
                         i_currency = master_data-use07
                         IMPORTING
                          e_amount  = lv_approved_cost ).

    IF lv_approved_cost IS NOT INITIAL.
      TRY.
          lv_percent = ( lv_estimated_cost / lv_approved_cost ) * 100.
        CATCH cx_root.
      ENDTRY.
    ENDIF.
* "Check whther total estimated cost is more than 130 % of approved
* "Cost
    CHECK lv_percent GE 130.
* "Display Pop up at the time of creation only
    IF lv_created IS NOT INITIAL.
*   "Pop up shouldnt come in BG mode
      IF sy-batch NE 'X'.
        CONCATENATE text-015 text-016   INTO lv_quest SEPARATED BY space.
*     "Raise Popup Message
        CALL FUNCTION 'POPUP_TO_CONFIRM'
          EXPORTING
            titlebar              = text-014
            text_question         = lv_quest
            text_button_1         = text-017
            icon_button_1         = 'ICON_OKAY'
            text_button_2         = text-018
            icon_button_2         = 'ICON_CANCEL'
            display_cancel_button = ' '
*           popup_type            = i_popup_type
          IMPORTING
            answer                = lv_answer.
        CASE lv_answer.
          WHEN '1'.
*         "Do Nothing and let AR save it
          WHEN '2'.
*         "Raise Error so user can change the vlue
            RAISE error_with_message.
        ENDCASE.
      ENDIF.
    ENDIF.
* "If status is for approval then message should come as warning
    IF lv_forapproval IS NOT INITIAL.
*   " No need to raise it in BG mode
      IF sy-batch NE 'X'.
        sy-msgid = '26'.
        sy-msgty = 'W'.
        sy-msgno = '000'.
        sy-msgv1 = 'Total Estimated cost is 130 percent of total approved buget'(019).
      ENDIF.
    ENDIF.

  ENDMETHOD.
ENDCLASS.
