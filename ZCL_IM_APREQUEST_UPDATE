* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_IM_APREQUEST_UPDATE=>FETCH_DIRECT_MANAGER
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_PERNR                        TYPE        PERSNO(optional)
* | [--->] I_PLANS                        TYPE        PLANS(optional)
* | [<---] E_MANAGER                      TYPE        PERNR_D
* | [<---] E_EMAIL                        TYPE        COMM_ID_LONG
* | [<---] E_NAME                         TYPE        EMNAM
* | [<---] E_ID                           TYPE        SYSID
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD fetch_direct_manager.
    DATA: lv_plans TYPE plans,
          lv_sobid TYPE sobid.
    lv_plans = i_plans.
    IF lv_plans IS INITIAL.
      SELECT SINGLE plans
             FROM pa0001
             INTO lv_plans
             WHERE pernr = i_pernr
             AND begda LE sy-datum
             AND endda GE sy-datum.
    ENDIF.

*    "Fill Reporting Position
      SELECT SINGLE sobid INTO lv_sobid
        FROM hrp1001
       WHERE otype = 'S'
         AND objid = lv_plans
         AND plvar = '01'
         AND rsign = 'A'
         AND relat = '002'
         AND istat = '1'
         AND begda LE sy-datum
         AND endda GE sy-datum
         AND sclas = 'S'.
      IF sy-subrc EQ 0.
*      "Call Manager
        SELECT SINGLE objid
         FROM hrp1001
         INTO e_manager
        WHERE otype EQ 'P'
          AND plvar EQ '01'
          AND rsign EQ 'B'
          AND relat EQ '008'
          AND begda LE sy-datum                    " DSDK950519
          AND endda GE sy-datum                  " DSDK950519
          AND sclas EQ 'S'
          AND sobid EQ lv_sobid.
        IF sy-subrc EQ 0.
          IF e_name IS REQUESTED.
            SELECT SINGLE ename
              FROM pa0001
              INTO e_name
             WHERE pernr EQ e_manager
               AND begda LE sy-datum
               AND endda GE sy-datum.
          ENDIF.
          IF e_email IS REQUESTED.
            e_email = zcl_dms_wfutil=>fetch_emp_mail( e_manager ).
          ENDIF.
          IF e_id IS REQUESTED.
            e_id =  get_eid( e_manager ).
          ENDIF.
          EXIT.
        ELSE.
          EXIT.
        ENDIF.
      ELSE.
        EXIT.
      ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_IM_APREQUEST_UPDATE=>GET_COSTCENTER_OWNER
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_KOSTL                        TYPE        KOSTL(optional)
* | [<---] E_CCOWNER                      TYPE        USRID
* | [<---] E_RETURN                       TYPE        ZFI_AR_MESSAGES_STRUC
* | [<---] E_INVALID                      TYPE        CHAR1
* | [<---] E_PERNR                        TYPE        PERNR_D
* | [<---] E_PLANS                        TYPE        PLANS
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_costcenter_owner.

    TYPES: BEGIN OF ty_approver,
             pernr    TYPE persno,
             plans    TYPE plans,
             trfgr    TYPE trfgr,
             usrid    TYPE sysid,
             trfst    TYPE trfst,
             replevel TYPE i,
           END OF ty_approver.

    DATA: lv_uname    TYPE bapiusr01-uname,
          lv_pernr    TYPE bapiusr01-employeeno,
          it_approver TYPE STANDARD TABLE OF ty_approver.

    SELECT SINGLE * FROM csks
       INTO @DATA(ls_csks)
      WHERE kostl EQ @i_kostl
        AND datbi GE @sy-datum
        AND datab LE @sy-datum.
    IF sy-subrc EQ 0.
      lv_uname = ls_csks-verak_user.
      CALL FUNCTION 'BAPI_USR01DOHR_GETEMPLOYEE'
        EXPORTING
          id             = lv_uname
        IMPORTING
          employeenumber = lv_pernr.
      IF lv_pernr IS NOT INITIAL.
        e_pernr = lv_pernr.
        SELECT SINGLE * FROM pa0000
          INTO @DATA(ls_pa0000)
         WHERE pernr EQ @lv_pernr
           AND begda LE @sy-datum
           AND endda GE @sy-datum
           AND stat2 EQ '3'.
        IF sy-subrc NE 0.
          CLEAR: lv_uname, e_pernr.
        ELSE.
          e_ccowner = ls_csks-verak_user.
          SELECT SINGLE plans FROM pa0001
            INTO e_plans
           WHERE pernr EQ lv_pernr
             AND begda LE sy-datum
             AND endda GE sy-datum.
        ENDIF.
      ENDIF.
    ENDIF.

    IF lv_uname IS INITIAL.
      e_invalid = 'X'.
      e_return-message = |Cost Center Owner Not Active/Doesn't Exists for CC { i_kostl }|.
    ENDIF.

  ENDMETHOD.


