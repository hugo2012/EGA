* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_COMMON=>SET_ATTACH_TO_WORKITEM
* +-------------------------------------------------------------------------------------------------+
* | [--->] WORKITEM_ID                    TYPE        SWW_WIID
* | [--->] DECISION_ID                    TYPE        RPM_TV_GUID
* | [--->] IT_ATT_GUID                    TYPE        ZPPM_TT_WF_ATTACHMENTS
* | [<---] ET_ATTACHMENTS                 TYPE        TSWOTOBJID
* | [<---] ET_ATT_GUID                    TYPE        ZPPM_TT_WF_ATTACHMENTS
* | [<---] ET_CONTENT_ATT                 TYPE        ZHR_LEAVE_DOC_CONTENT_TT
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD set_attach_to_workitem.
* method is used to attach documents to workitem that are there in decision point
* find workitem id and get the _ATTACH_OBJECTS container element
* read /rpm/document table based on GUID and fetch EDMS guid
* FETCH cff_phio data from EDMS guid
* SCMS_DOC_READ to read files and convert read data to XSTRING
* Converted XTRING data is passed to FM SO_DOCUMENT_INSERT_API1
* to get doc which is used to pass to BO object reference that workflow
* interprets and output is passed to exporting parameter ET_ATTACHMENTS

    TYPES:BEGIN OF lty_doc.
            INCLUDE TYPE /rpm/document.
    TYPES    loio_id TYPE cff_phio-loio_id.
    TYPES:END OF lty_doc.

    DATA lt_doc TYPE TABLE OF lty_doc.

    DATA:    lt_access_info  TYPE TABLE OF scms_acinf,
             lt_content_bin  TYPE TABLE OF  sdokcntbin,
             lv_base_64_file TYPE string,
             ls_msg          TYPE bapiret2,
             lv_xstring      TYPE xstring,
             lv_file_size    TYPE i.

    DATA:lv_doctype TYPE soodk-objtp.
    DATA:l_act_filetype        TYPE char3.

    DATA lo_previous_exception TYPE REF TO cx_root.

    DATA: folder_id    TYPE soodk.
    DATA   ld_folder_id_api       TYPE soobjinfi1-object_id.
    DATA: ls_document_data       TYPE sodocchgi1,
          lt_object_content      TYPE TABLE OF solisti1,
          ls_object_content_line LIKE LINE OF lt_object_content,
          ls_note                TYPE sofmk,
          ls_bo_return           TYPE swotreturn,
          ls_bo_reference        TYPE swotobjid,
          ls_bo_handle           TYPE obj_record,
          ld_bo_objkey           TYPE swo_typeid.

    DATA:l_line_content       TYPE solisti1,
         l_line_content_hex   TYPE solix,
         l_document_data      TYPE sodocchgi1,
         l_document_type      TYPE so_obj_tp,
         l_document_info      TYPE sofolenti1,
         l_object_content     TYPE TABLE OF solisti1,
         l_object_content_hex TYPE TABLE OF solix.

    DATA:l_trunc_length TYPE i,
         l_extension    TYPE hap_attachment_type.

    DATA:lv_filename TYPE string,
         l_only_name TYPE string,
         l_data_read TYPE i.

    DATA: wa_bin            TYPE x LENGTH 2550,
          lt_bin            LIKE TABLE OF wa_bin,
          lt_bin_data       TYPE STANDARD TABLE OF raw255,
          ls_att_dtls       TYPE zhr_leave_doc_content_st,
          ls_binary_content TYPE solix,
          file_data         TYPE xstring.

    DATA:conv_class TYPE REF TO cl_abap_conv_in_ce,
         off_class  TYPE REF TO cl_abap_view_offlen.

    DATA lr_exc_run_wim       TYPE REF TO cx_swf_run_wim.
    DATA lr_context           TYPE REF TO cl_swf_run_workitem_context.
    DATA: ls_context TYPE sww_wimctx.
    DATA: lh_txmgr TYPE REF TO cl_swf_run_transaction_manager.
    DATA: lv_wi_handle TYPE REF TO if_swf_run_wim_internal.
    DATA: lh_workitem_context TYPE REF TO cl_swf_run_workitem_context.
    DATA lt_attach TYPE sibflporbt.
    DATA: lt_object_header TYPE STANDARD TABLE OF solisti1,
          ls_object_header TYPE solisti1.
    DATA:lo_exception  TYPE REF TO cx_root.


    FIELD-SYMBOLS: <ls_doc_file>    TYPE bapi_doc_files2,
                   <ls_access_info> TYPE scms_acinf.

    CLEAR : et_attachments[].
    TRY.

        CALL METHOD cl_swf_run_wim_factory=>find_by_wiid
          EXPORTING
            im_wiid             = workitem_id
            im_context          = ls_context
            im_read_for_update  = 'X'
            im_tx               = lh_txmgr
            im_wait_for_enqueue = ' '
          RECEIVING
            re_instance         = lv_wi_handle.


        DATA(lv_workitem_context) = lv_wi_handle->get_workitem_context( ).

        DATA(lv_container) = lv_workitem_context->get_wi_container( ).

        lv_container->get( EXPORTING name = '_ATTACH_OBJECTS' IMPORTING value = lt_attach ).


      CATCH cx_swf_cnt_container.
      CATCH cx_swf_run_wim_enq_failed .
      CATCH cx_swf_run_wim_read_failed .
      CATCH cx_swf_run_wim.

    ENDTRY.

*    CHECK lv_attach IS INITIAL.

    SELECT *  FROM /rpm/document INTO CORRESPONDING FIELDS OF TABLE lt_doc
                        WHERE entity_guid = decision_id.

    CHECK lt_doc IS NOT INITIAL.
    et_att_guid = it_att_guid.
    CLEAR  et_att_guid.
    LOOP AT lt_doc ASSIGNING FIELD-SYMBOL(<ls>).
      DATA(l_index) = sy-tabix.
      READ TABLE et_att_guid INTO DATA(ls_att_guid)
                           WITH KEY zzdoc_guid = <ls>-guid
                                    zzdecs_guid = decision_id
                                    wi_id = workitem_id.
      IF sy-subrc IS NOT INITIAL.
        <ls>-loio_id = <ls>-edms_guid.
        ls_att_guid-zzdoc_guid = <ls>-guid.
        ls_att_guid-zzdecs_guid = decision_id.
        ls_att_guid-wi_id = workitem_id.
        APPEND ls_att_guid TO et_att_guid.
      ELSE.
*        DELETE lt_doc INDEX l_index.
      ENDIF.

    ENDLOOP.

    CHECK lt_doc IS NOT INITIAL.

    SELECT * FROM cff_phio INTO TABLE @DATA(lt_phio)    "#EC CI_GENBUFF
                    FOR ALL ENTRIES IN @lt_doc
                      WHERE loio_id = @lt_doc-loio_id.

    CHECK lt_phio IS NOT INITIAL.
    CALL FUNCTION 'SO_FOLDER_ROOT_ID_GET'
      EXPORTING
        region                = 'B'
      IMPORTING
        folder_id             = folder_id
      EXCEPTIONS
        communication_failure = 1
        owner_not_exist       = 2
        system_failure        = 3
        x_error               = 4
        OTHERS                = 5.

    LOOP AT lt_phio INTO DATA(ls_phio).

      CLEAR:lt_content_bin[],lt_access_info[],l_object_content_hex[],
             l_object_content_hex,ls_document_data,
             lt_object_header[],lt_bin[],file_data.


      CALL FUNCTION 'SCMS_DOC_READ'
        EXPORTING
          stor_cat              = ls_phio-stor_cat
          doc_id                = ls_phio-phio_id
        TABLES
          content_bin           = lt_content_bin
          access_info           = lt_access_info
        EXCEPTIONS
          bad_storage_type      = 1
          bad_request           = 2
          unauthorized          = 3
          comp_not_found        = 4
          not_found             = 5
          forbidden             = 6
          conflict              = 7
          internal_server_error = 8
          error_http            = 9
          error_signature       = 10
          error_config          = 11
          error_format          = 12
          error_parameter       = 13
          error                 = 14
          OTHERS                = 15.
      IF sy-subrc <> 0.
      ELSE.

        READ TABLE lt_access_info ASSIGNING <ls_access_info> INDEX 1.

        IF <ls_access_info> IS NOT ASSIGNED.
          CONTINUE.
        ENDIF.

        lv_file_size = <ls_access_info>-comp_size.

        CALL FUNCTION 'SCMS_BINARY_TO_XSTRING'
          EXPORTING
            input_length = lv_file_size
          IMPORTING
            buffer       = lv_xstring
          TABLES
            binary_tab   = lt_content_bin.

        CALL FUNCTION 'SCMS_BINARY_TO_XSTRING'
          EXPORTING
            input_length = lv_file_size
          IMPORTING
            buffer       = file_data
          TABLES
            binary_tab   = lt_bin
          EXCEPTIONS
            failed       = 1
            OTHERS       = 2.
        IF sy-subrc <> 0.
*     Implement suitable error handling here
        ELSE.
          CALL FUNCTION 'SCMS_XSTRING_TO_BINARY'
            EXPORTING
              buffer     = file_data
            TABLES
              binary_tab = lt_bin_data.
        ENDIF.

        lv_filename = <ls_access_info>-comp_id.

        CALL FUNCTION 'HRHAP_DOC_ATTACHMENT_FILESPLIT'
          EXPORTING
            filename  = lv_filename
          IMPORTING
            name      = l_only_name
            extension = l_extension.

        TRANSLATE l_extension TO UPPER CASE.



        CONCATENATE '&SO_FILENAME = ' l_only_name '.' l_extension INTO ls_object_header-line SEPARATED BY space.
        APPEND ls_object_header TO lt_object_header.


*        PERFORM check_object_type IN PROGRAM saplso30
*                          TABLES l_object_content
*                          USING l_extension
*                                l_act_filetype
*                                l_trunc_length.
        CLEAR: ls_att_dtls-content[],ls_att_dtls.
        ls_att_dtls-doc_name   = lv_filename.
        ls_att_dtls-doc_type   = l_extension.
        LOOP AT lt_bin_data INTO DATA(ls_bin_data).
          ls_binary_content-line = ls_bin_data.
          APPEND ls_binary_content TO ls_att_dtls-content.
        ENDLOOP.
        APPEND ls_att_dtls TO et_content_att.


        l_act_filetype = 'BIN'.

        l_document_data-obj_descr = lv_filename.
        l_document_data-obj_name  = 'Decision Point Attachments'.
        l_document_data-obj_langu = sy-langu.
        l_document_data-sensitivty = 'P'.

        lv_doctype = l_extension.

        l_object_content_hex = cl_document_bcs=>xstring_to_solix( lv_xstring ).

        l_document_data-doc_size = xstrlen( lv_xstring ).

        ld_folder_id_api = folder_id.
* create BIN data
        CALL FUNCTION 'SO_DOCUMENT_INSERT_API1'
          EXPORTING
            folder_id                  = ld_folder_id_api
            document_data              = l_document_data
            document_type              = lv_doctype
          IMPORTING
            document_info              = l_document_info
          TABLES
            contents_hex               = l_object_content_hex
            object_header              = lt_object_header
          EXCEPTIONS
            folder_not_exist           = 01
            document_type_not_exist    = 02
            operation_no_authorization = 03
            parameter_error            = 04
            x_error                    = 05
            enqueue_error              = 06
            OTHERS                     = 99.
        IF sy-subrc IS NOT INITIAL.
        ELSE.

          ls_note = l_document_info-doc_id.
          ld_bo_objkey = ls_note.
          CALL FUNCTION 'SWO_CREATE'
            EXPORTING
              objtype = 'SOFM'
              objkey  = ld_bo_objkey
            IMPORTING
              object  = ls_bo_handle-handle
              return  = ls_bo_return.
          CHECK ls_bo_return-code EQ 0.

*get object reference from BOR obejct
          CALL FUNCTION 'SWO_OBJECT_ID_GET'
            EXPORTING
              object = ls_bo_handle-handle
            IMPORTING
              objid  = ls_bo_reference
              return = ls_bo_return.
          CHECK ls_bo_return-code EQ 0.

*Fill return objecr with object reference
          DATA(ls_attach) = ls_bo_reference.

          INSERT ls_attach INTO TABLE et_attachments.

*destroy BOR object
          CALL FUNCTION 'SWO_FREE'
            EXPORTING
              object = ls_bo_handle-handle
            IMPORTING
              return = ls_bo_return.

        ENDIF.

      ENDIF.

    ENDLOOP.


    IF et_attachments IS NOT INITIAL.
* SOC by C90005555 on 13.07.2025 for CRQXXXXXX by #DSDK9A04ZO
* implement to get comment for the attachment mail
     IF lt_attach IS NOT INITIAL.
       LOOP AT lt_attach ASSIGNING FIELD-SYMBOL(<lfs_attach>).
         IF <lfs_attach>-instid CA 'RAW'.
           APPEND VALUE #(  logsys  = sy-mandt
                            objtype = <lfs_attach>-typeid
                            objkey  = <lfs_attach>-instid
                            describe = '*<OBJECT>*'
                            ) TO et_attachments.
         ENDIF.
       ENDLOOP.
     ENDIF.
* EOC by C90005555 on 13.07.2025 for CRQXXXXXX by #DSDK9A04ZO

      TRY.
          lv_container->set(
                            name  = '_Attach_Objects'       "#EC NOTEXT
                            value = et_attachments ).
        CATCH cx_swf_cnt_container INTO lo_previous_exception.
      ENDTRY.
      TRY.
          lv_container->set(
                            name  = 'ET_ATTACHMENTS'       "#EC NOTEXT
                            value = et_attachments ).
        CATCH cx_swf_cnt_container INTO lo_previous_exception.
      ENDTRY.
      CALL FUNCTION 'SWW_WI_LOG_FLUSH'.
      lv_workitem_context->do_commit_work( ).
