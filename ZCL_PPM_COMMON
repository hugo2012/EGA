        <ls_app>-app_by = lv_user_info-name.
        <ls_app>-ap_datetim = sy-datum.
      ENDIF.

      IF iv_decision EQ gc_r.
        <ls_app>-status = gc_rejected.
      ELSEIF iv_decision EQ gc_a.
        <ls_app>-status = gc_approved.
      ELSE.

      ENDIF.

    ENDLOOP.

* BEGIN OF Log issue 218.
  IF et_app_stat is NOT INITIAL.
    CLEAR et_app_stat_html[].
