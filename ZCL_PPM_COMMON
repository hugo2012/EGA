* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_COMMON=>SEND_ERROR_EMAIL
* +-------------------------------------------------------------------------------------------------+
* | [--->] ITEM_ID                        TYPE        /RPM/TV_EXTID
* | [--->] ITEM_NAME                      TYPE        RPM_TV_SHARED_DESCRIPTION
* | [--->] IT_MSG                         TYPE        /RPM/TT_MESSAGES
* | [--->] ZZAKSTL                        TYPE        PS_AKSTL
* | [--->] WFTEXT                         TYPE        ZPPM_WF_TEXT_S
* | [--->] PROJ_DESCRIPTION               TYPE        RPM_TV_PROJ_DESCRIPTION
* | [--->] EMAIL_RECP                     TYPE        BAPI_ECMVAL_WF_ADDRESS_TAB
* | [--->] IV_INITIATOR                   TYPE        WFSYST-INITIATOR
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD send_error_email.

    DATA lt_contents TYPE TABLE OF soli.
    DATA ls_contents TYPE soli.
    DATA ls_subject TYPE string.
    DATA ls_user TYPE swhactor.
    DATA  lt_return   TYPE bapirettab.
    DATA: ls_user_data  TYPE bapiaddr3.
    DATA lv_sub TYPE so_obj_des.

    TRY.
        DATA(send_request) = cl_bcs=>create_persistent( ).

        CONCATENATE 'Error for ' item_id ' : '  wftext-gate_text  'of'  item_name
            'Approval'
          INTO ls_subject SEPARATED BY space.
        lv_sub = ls_subject.
        CONCATENATE 'Workflow for' wftext-gate_text 'of' proj_description 'for CC' zzakstl '-'
                        INTO ls_contents-line SEPARATED BY space.
        APPEND ls_contents TO lt_contents.
        CLEAR ls_contents.

        CONCATENATE wftext-ktext 'is in error'  INTO ls_contents-line SEPARATED BY space.
        APPEND ls_contents TO lt_contents.
        CLEAR ls_contents.

        ls_contents = '<br><br>'.
        APPEND ls_contents TO lt_contents.
        CLEAR ls_contents.

        CONCATENATE 'Error details' ':'  INTO ls_contents-line SEPARATED BY space.
        APPEND ls_contents TO lt_contents.
        CLEAR ls_contents.

        ls_contents = '<br><br>'.
        APPEND ls_contents TO lt_contents.
        CLEAR ls_contents.

        LOOP AT it_msg INTO DATA(ls_msg).
          CONCATENATE '<b>' ls_msg-msgtype ls_msg-msg_txt '</b>' INTO ls_contents-line SEPARATED BY space.
          APPEND ls_contents TO lt_contents.
          CLEAR ls_contents.
        ENDLOOP.

        ls_contents = '<br><br>'.
        APPEND ls_contents TO lt_contents.
        CLEAR ls_contents.

        CONCATENATE 'Please contact respective user' 'group to rectify' INTO ls_contents-line SEPARATED BY space.
        APPEND ls_contents TO lt_contents.
        CLEAR ls_contents.
        CONCATENATE 'the error and restart' 'the approval workflow' INTO ls_contents-line SEPARATED BY space.
        APPEND ls_contents TO lt_contents.
        CLEAR ls_contents.

        ls_contents = '<br><br>'.
        APPEND ls_contents TO lt_contents.
        CLEAR ls_contents.

        CONCATENATE '<i>Do not reply to this system' 'generated email</i>' INTO ls_contents-line SEPARATED BY space.
        APPEND ls_contents TO lt_contents.
        CLEAR ls_contents.


        DATA(document) = cl_document_bcs=>create_document(
                        i_type    = 'HTM'
                        i_text    = lt_contents
                        i_subject = lv_sub ).

        CALL METHOD send_request->set_message_subject
          EXPORTING
            ip_subject = ls_subject.

        CALL METHOD send_request->set_document( document ).

        LOOP AT email_recp INTO DATA(ls_recp).
          DATA(recipient) = cl_cam_address_bcs=>create_internet_address(
           i_address_string = ls_recp-e_mail ).

          send_request->add_recipient( i_recipient = recipient ).
        ENDLOOP.

        IF iv_initiator IS NOT INITIAL.
          ls_user-objid = iv_initiator+2(12).
          CALL FUNCTION 'BAPI_USER_GET_DETAIL'
            EXPORTING
              username = ls_user-objid
            IMPORTING
              address  = ls_user_data
            TABLES
              return   = lt_return.
          IF NOT ls_user_data-e_mail IS INITIAL.
           recipient = cl_cam_address_bcs=>create_internet_address(
           i_address_string = ls_user_data-e_mail ).

            send_request->add_recipient( i_recipient = recipient ).
          ENDIF.
        ENDIF.
        DATA(sent_to_all) = send_request->send( ).
*        COMMIT WORK.
      CATCH cx_bcs INTO DATA(lo_bcs).
    ENDTRY.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_COMMON=>SET_APPROVALWITH
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_GUID                        TYPE        RPM_TV_GUID
* | [--->] IV_APPROVALWITH                TYPE        ZAAROVALWITH(optional)
* | [--->] IV_PLYR                        TYPE        XFELD(optional)
* | [--->] IV_PLANST                      TYPE        /RPM/ITEM_D-ZZPLANST(optional)
* | [--->] IV_APPRYR                      TYPE        /RPM/ITEM_D-ZZAPPYR(optional)
* | [<---] EV_RC                          TYPE        I
* | [<---] GT_MSG                         TYPE        /RPM/TT_MESSAGES
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD set_approvalwith.
* local variables
    DATA:tmp_context        TYPE /rpm/ts_object_hier,
         ls_item_attributes TYPE /rpm/ts_item_d_api,
         ls_context         TYPE /rpm/ts_object_hier,
         item_context       TYPE /rpm/ts_item_context,
         lv_lang            TYPE laiso,
         lv_rejected        TYPE boole_d,
         lt_msg             TYPE /rpm/tt_messages,
         ls_msg             TYPE /rpm/ts_messages.

    DATA:lv_rc                 TYPE i.
    DATA: lt_item_attributes    TYPE /rpm/tt_item_d_api.

    DATA lv_creation_type     TYPE string.

    ev_rc = 0.
* set language
    CALL METHOD cl_rpm_language_buffer=>convert_langu_to_laiso
      EXPORTING
        iv_langu    = sy-langu
      RECEIVING
        rv_language = lv_lang.


* get decision details
    IF iv_plyr EQ abap_false.
      SELECT SINGLE * FROM /rpm/decision INTO @DATA(ls_decs)
                             WHERE guid = @iv_guid.

      CHECK sy-subrc IS INITIAL.

* get item data
      SELECT SINGLE * FROM /rpm/item_d INTO @DATA(ls_item)
                          WHERE guid = @ls_decs-item_guid.

    ELSE.
      SELECT SINGLE * FROM /rpm/item_d INTO ls_item
                          WHERE guid = iv_guid.
    ENDIF.
    tmp_context-object_id = ls_item-external_id.
* set context data
    CALL FUNCTION '/RPM/ITEM_DISPLAY'
      EXPORTING
        is_context    = tmp_context
        iv_edit_mode  = '2'
      IMPORTING
        es_attributes = ls_item_attributes
        ev_rc         = lv_rc
      TABLES
        et_msg        = lt_msg.

    IF lv_rc NE 0.
      ev_rc = 4.
    ENDIF.
* set message
    LOOP AT lt_msg INTO ls_msg.

      IF ls_msg-msgtype EQ 'E'.
        APPEND ls_msg TO gt_msg.
        ev_rc = 4.
      ENDIF.
    ENDLOOP.

    IF ev_rc NE 0.
      RETURN.
    ENDIF.
* get projection type based on item type
    CALL METHOD /rpm/cl_configuration=>get_proj_creation_type
      EXPORTING
        iv_item_type     = ls_item-item_type
      IMPORTING
        ev_creation_type = lv_creation_type.

    IF iv_plyr EQ abap_true.
      ls_item_attributes-zzplanst = iv_planst.
      ls_item_attributes-zzappyr = iv_appryr.
      APPEND ls_item_attributes TO lt_item_attributes.
    ELSE.
*      ls_item_attributes-zzaarovalwith = iv_approvalwith.
      ls_item_attributes-zzaarovalwith = to_upper( iv_approvalwith ).
      APPEND ls_item_attributes TO lt_item_attributes.
    ENDIF.
* call MODIFY
    CALL FUNCTION '/RPM/ITEM_MODIFY'
      EXPORTING
        iv_language       = lv_lang
        iv_change_mode    = /rpm/cl_co=>sc_change_mode_update
        is_modify_context = item_context
      IMPORTING
        ev_rc             = lv_rc
      TABLES
        it_attributes     = lt_item_attributes
        et_msg            = lt_msg.

    IF lv_rc NE 0.
      ev_rc = 4.
    ENDIF.

    LOOP AT lt_msg INTO ls_msg.
      IF ls_msg-msgtype EQ 'E'.
        APPEND ls_msg TO gt_msg.
        ev_rc = 4.
      ENDIF.
    ENDLOOP.


* save data
    IF ev_rc IS INITIAL.
      CALL METHOD cl_inm_ppm_services=>save
        IMPORTING
          et_messages = lt_msg
          ev_rejected = lv_rejected.

      LOOP AT lt_msg INTO ls_msg.

        IF ls_msg-msgtype EQ 'E'.
          APPEND ls_msg TO gt_msg.
          ev_rc = 4.
        ENDIF.
      ENDLOOP.

      IF lv_rejected IS NOT INITIAL.
        ev_rc = 4.
      ENDIF.

    ENDIF.

    CLEAR:lv_rejected,lt_msg.
* clear all the data of the PPM services
    CALL METHOD cl_inm_ppm_services=>do_cleanup
      IMPORTING
        et_messages = lt_msg
        ev_rejected = lv_rejected.

    IF lv_rejected IS NOT INITIAL.
      ev_rc = 4.
    ENDIF.


    LOOP AT lt_msg INTO ls_msg.

      IF ls_msg-msgtype EQ 'E'.
        APPEND ls_msg TO gt_msg.
        ev_rc = 4.
      ENDIF.
    ENDLOOP.

    ROLLBACK WORK.


  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_COMMON=>SET_APP_REJ_STATUS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_LEVEL                       TYPE        INT4
