* | [<---] EV_RC                          TYPE        SYSUBRC
* | [<---] E_WFTEXT                       TYPE        ZPPM_WF_TEXT_S
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_item.

    DATA:
      lr_dependency_api TYPE REF TO /rpm/cl_dependency_api,
      lr_error          TYPE REF TO cx_root,
      lr_msg_handler    TYPE REF TO /rpm/cl_message_handle,
      lr_obj_manager    TYPE REF TO cl_rpm_obj_manager.

    DATA ls_context TYPE /rpm/ts_object_hier.
    DATA ls_attributes TYPE /rpm/ts_item_d_api.
    DATA lv_rc TYPE sysubrc.
    DATA lv_amt TYPE /rpm/v_fin_plan-amount.
    DATA l_text(30) TYPE c.
    DATA l_text1(30) TYPE c.

* get decision details
    SELECT SINGLE * FROM /rpm/decision INTO @DATA(ls_decs)
                        WHERE guid = @iv_guid.

    IF sy-subrc IS NOT INITIAL.
      ev_rc = 4.
      EXIT.
    ENDIF.
    TRY.
*/Set language
        DATA(lv_langu) = sy-langu.

        DATA(lv_laiso) = cl_rpm_language_buffer=>convert_langu_to_laiso( lv_langu ).

        IF lv_laiso IS INITIAL .
          lv_laiso = 'EN' .
        ENDIF .

        CREATE OBJECT lr_msg_handler.
        lr_dependency_api ?= /rpm/cl_dependency_api=>get_instance( lv_langu ).

*--Instantiate the object manager
        lr_obj_manager = cl_rpm_obj_manager=>get_instance( ).
        ls_context-object_guid = ls_decs-item_guid.
        CALL METHOD cl_rpm_obj_manager=>read_item_detail
          EXPORTING
            iv_header_guid = ls_context-object_guid
            iv_language    = lv_laiso
          IMPORTING
            es_attributes  = ls_attributes.
      CATCH cx_root INTO lr_error.
        lv_rc = 4.
        CALL METHOD cl_rpm_message_services=>log_message_text
          EXPORTING
            iv_msgty     = cl_rpm_co=>sc_error
            ir_exception = lr_error.
    ENDTRY.


    ev_rc = lv_rc.
    es_attributes = ls_attributes.
    e_wftext-item_id = ls_attributes-external_id.
    SELECT SINGLE phase_text FROM zppm24 INTO e_wftext-gate_text
                               WHERE phase_id = ls_decs-decision_id.

    SELECT * FROM /rpm/decision INTO TABLE @DATA(lt_decs)
                                 WHERE item_guid = @ls_decs-item_guid.
    LOOP AT lt_decs INTO DATA(ls_decision).
      DATA(l_index) = sy-tabix.
      IF ls_decision-guid = iv_guid.
        DELETE lt_decs WHERE guid EQ iv_guid.
        IF sy-subrc IS INITIAL.
          DATA(l_flag) = abap_true.
        ENDIF.
      ELSE.
        IF l_flag EQ abap_true.
          e_wftext-fstart = ls_decision-plan_start.
          e_wftext-ffinish = ls_decision-plan_finish.
          SELECT SINGLE phase_text INTO l_text
          FROM /rpm/phase_t
          WHERE item_type = ls_attributes-item_type
          AND  phase_id = ls_decision-decision_id
          AND langu = sy-langu.
          SPLIT l_text AT '(' INTO e_wftext-phase_text l_text1.

          EXIT.
        ELSE.
          DELETE lt_decs INDEX l_index.
        ENDIF.
      ENDIF.
    ENDLOOP.

    SELECT SINGLE text FROM rpm_proj_prgrp_t INTO e_wftext-prio
                      WHERE langu = sy-langu
                       AND  priority_group = ls_attributes-priority_group.
    SELECT SINGLE item_type_t FROM /rpm/item_type_t INTO e_wftext-item_type_t
                                    WHERE langu = sy-langu
                                     AND item_type = ls_attributes-item_type.
    CASE ls_attributes-zzplanst.
      WHEN '01'.
        e_wftext-planst_t = 'Planned'.
      WHEN '02'.
        e_wftext-planst_t = 'Unplanned'.
      WHEN '03'.
        e_wftext-planst_t = 'N/A'.
      WHEN OTHERS.
        e_wftext-planst_t = ''.
    ENDCASE.

    SELECT SINGLE ktext FROM cskt INTO e_wftext-ktext   "#EC CI_GENBUFF
                        WHERE spras = sy-langu
                        AND   kostl = ls_attributes-zzakstl
                        AND  datbi GE sy-datum.


* get FIN view data to fetch PHASE AMOUNT
    SELECT  * FROM zppm023  INTO TABLE @DATA(lt_view)
            WHERE zzitmty = @ls_attributes-item_type
              AND zzdecpt = @ls_decs-decision_id.

    DELETE lt_view WHERE zzfingrp IS INITIAL.

    READ TABLE lt_view INTO DATA(ls_view) INDEX 1.
    IF sy-subrc IS INITIAL.

      SELECT SINGLE description FROM /rpm/fin_view_t INTO @DATA(lv_viewtext)
                             WHERE langu = @sy-langu
                               AND fin_view = @ls_view-zzview.
      LOOP AT lt_view INTO  ls_view.
        SELECT period, amount, currency FROM /rpm/v_fin_plan APPENDING TABLE @DATA(lt_fin_plan)
                      WHERE item_d_guid = @ls_decision-item_guid
                           AND group_id = @ls_view-zzfingrp
                           AND category_id = @ls_view-zzcatg
                           AND plan_type   = @ls_view-zzview.
      ENDLOOP.
      LOOP AT lt_fin_plan INTO DATA(ls_fin_plan).
        lv_amt = ls_fin_plan-amount + lv_amt. " Total Amount
      ENDLOOP.

* rate conversion to USD
      DATA(lv_rate) = get_currency_rate( iv_from_currency = ls_fin_plan-currency  iv_to_currency = 'USD' ).

      IF lv_amt IS NOT INITIAL AND lv_rate IS NOT INITIAL.
        lv_amt = lv_amt * lv_rate.
      ENDIF.
*<<<< C90005555 - fix issue missing data at gate 0 case auto approval
*      e_wftext-phamt = lv_amt. "
* Convert currency
      WRITE lv_amt TO e_wftext-phamt CURRENCY ls_attributes-currency.
      CONDENSE e_wftext-phamt NO-GAPS.
*>>>> C90005555 - fix issue missing data at gate 0 case auto approval
    ENDIF.


  ENDMETHOD.


