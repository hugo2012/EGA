* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_COMMON=>SPLIT_MESSAGE_INTO_VARS
* +-------------------------------------------------------------------------------------------------+
* | [--->] MESSAGE_TEXT                   TYPE        BAPI_MSG
* | [<---] MSGV1                          TYPE        SYMSGV
* | [<---] MSGV2                          TYPE        SYMSGV
* | [<---] MSGV3                          TYPE        SYMSGV
* | [<---] MSGV4                          TYPE        SYMSGV
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD split_message_into_vars.
* Split message text to MSGV* variables
    DATA: i_char1     TYPE TABLE OF c,
          i_char2     TYPE TABLE OF c,
          i_char3     TYPE TABLE OF c,
          i_char4     TYPE TABLE OF c,
          i_char      TYPE TABLE OF c,
          character   TYPE c,
          counter     TYPE i,
          len         TYPE i,
          endof_msgv1 TYPE c,
          endof_msgv2 TYPE c,
          endof_msgv3 TYPE c,
          dummy       TYPE string.

    len = strlen( message_text ).

    counter = 0.
    WHILE ( counter < len ).
      "Read each character (including spaces and move to respective internal tables for each message variable)
      character = message_text+counter(1).

      IF counter < 50.
        APPEND character TO i_char1. "msgv1
      ELSEIF counter >= 50 AND counter < 100.
        APPEND character TO i_char2. " msgv2
      ELSEIF counter >= 100 AND counter < 150.
        APPEND character TO i_char3. "msgv3
      ELSEIF counter >= 150 AND counter < 200.
        APPEND character TO i_char4. "msgv4
      ELSE.
        "Ignore... anything beyond 200 characters.
      ENDIF.

      APPEND character TO i_char.

      counter = counter + 1.
    ENDWHILE.

    IF i_char1 IS NOT INITIAL.
      CONCATENATE LINES OF i_char1 INTO msgv1 RESPECTING BLANKS.
    ENDIF.
    IF i_char2 IS NOT INITIAL.
      CONCATENATE LINES OF i_char2 INTO msgv2 RESPECTING BLANKS.
    ENDIF.
    IF i_char3 IS NOT INITIAL.
      CONCATENATE LINES OF i_char3 INTO msgv3 RESPECTING BLANKS.
    ENDIF.
    IF i_char4 IS NOT INITIAL.
      CONCATENATE LINES OF i_char4 INTO msgv4 RESPECTING BLANKS.
    ENDIF.

    "Find end character of each of the message variables.
    " The last char could be SPACE or any other valid character.
    READ TABLE i_char1 INTO endof_msgv1 INDEX 50.
    READ TABLE i_char2 INTO endof_msgv2 INDEX 50.
    READ TABLE i_char3 INTO endof_msgv3 INDEX 50.

    IF endof_msgv1 EQ space.
      "Message varaible 1 has SPACE at the end.
      CONCATENATE ' ' msgv2 INTO msgv2 SEPARATED BY space.
      "Read again the adjusted msgv2 - as the last charcter of the adjusted string could again be space.
      IF  msgv2+49(1) CA ' ' OR  msgv2+49(1) IS INITIAL.
        IF endof_msgv2 IS NOT INITIAL.
          "Adusted msgv2 has SAPCE at the end and there was alread a valid charcter at the msgv2.
          " Hence append SPACE and the valid character.
          CONCATENATE ' ' endof_msgv2 INTO dummy RESPECTING BLANKS.
          CONCATENATE dummy msgv3 INTO msgv3 RESPECTING BLANKS.
        ELSE.
          "Just append space as there is no valid end character for msgv2.
          CONCATENATE ' ' msgv3 INTO msgv3 RESPECTING BLANKS.
        ENDIF.

        IF ( msgv3+49(1) CA ' ' OR    msgv3+49(1) IS INITIAL ).
          IF endof_msgv3 IS NOT INITIAL.
            CONCATENATE ' ' endof_msgv3 INTO dummy RESPECTING BLANKS.
            CONCATENATE dummy msgv4 INTO msgv4 RESPECTING BLANKS.
          ELSE.
            CONCATENATE ' ' msgv4 INTO msgv4 RESPECTING BLANKS.
          ENDIF.
        ENDIF.
      ENDIF.
      RETURN.
    ENDIF.

    IF endof_msgv2 EQ space.

      CONCATENATE ' ' msgv3 INTO msgv3 SEPARATED BY space.
      "Read again the adjusted string.
      IF  msgv3+49(1) CA ' ' OR  msgv3+49(1) IS INITIAL.
        IF endof_msgv3 IS NOT INITIAL.
          CONCATENATE ' ' endof_msgv3 INTO dummy RESPECTING BLANKS.
          CONCATENATE dummy msgv4 INTO msgv4 RESPECTING BLANKS.
        ELSE.
          CONCATENATE ' ' msgv4 INTO msgv4 RESPECTING BLANKS.
        ENDIF.
      ENDIF.
      RETURN.
    ENDIF.

    IF endof_msgv3 EQ space.
      CONCATENATE ' ' msgv4 INTO msgv4 SEPARATED BY space.
    ENDIF.


  ENDMETHOD.


