* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Private Method ZCL_PPM_COMMON=>CONV_RAW_DATA_TO_DDIC
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_RAW_DATA                    TYPE        ZRPM_TT_DX_RAW_DATA
* | [--->] IS_STRUCT                      TYPE        ANY
* | [--->] IT_HEADER_FIELD                TYPE        ZRPM_TT_DX_RAW_DATA_FIELD
* | [<---] IS_DDIC_STRUC                  TYPE        ANY
* | [<---] ET_DDIC_DATA                   TYPE        STANDARD TABLE
* | [EXC!] GENERIC_ERROR
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD conv_raw_data_to_ddic.

    CLEAR et_ddic_data[].
    DATA: ls_raw_data        TYPE zrpm_ts_dx_raw_data,
          ls_raw_data_header TYPE zrpm_ts_dx_raw_data,
          ls_null_data       TYPE zrpm_ts_dx_raw_data,
          ls_raw_field       TYPE zrpm_ts_dx_raw_data_field,
          lt_raw_field       TYPE zrpm_tt_dx_raw_data_field,
          lr_error           TYPE REF TO cx_root.

    DATA: it_tmp_dntab TYPE STANDARD TABLE OF dntab.
    DATA: wa_dntab TYPE dntab.
    DATA: lv_decimals TYPE i.
    DATA: lv_period_seprator TYPE c.
    DATA: lv_decimal_seprator TYPE c.
    DATA: lv_length TYPE i.
    FIELD-SYMBOLS:
      <ls_ddic> TYPE any,
      <lt_ddic> TYPE any.

*/Initialize export parameters
    CLEAR et_ddic_data[].


    CALL FUNCTION 'NAMETAB_GET'                             "#EC FB_OLDED
      EXPORTING
        tabname             = is_struct
      TABLES
        nametab             = it_tmp_dntab
      EXCEPTIONS
        internal_error      = 1
        table_has_no_fields = 2
        table_not_activ     = 3
        no_texts_found      = 4
        OTHERS              = 5.

*/Fill the export table with data from the
*/TAB-delimited import table
    TRY.
        ASSIGN is_ddic_struc TO <lt_ddic>.
        LOOP AT is_raw_data INTO ls_raw_data.
          CLEAR:<lt_ddic>.
*/Exit on the first blank record
          ls_null_data = ls_raw_data.
          REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>horizontal_tab
                  IN ls_null_data WITH space.
          CONDENSE ls_null_data NO-GAPS.
          IF ls_null_data(1) EQ space.
            CONTINUE.
          ENDIF.
*/First, fill a local table with all the fields in a single
*/TAB-delimited import record
          CLEAR lt_raw_field[].
          SPLIT ls_raw_data
                AT cl_abap_char_utilities=>horizontal_tab
                INTO TABLE lt_raw_field.
*/Second, map and assign each record of the local table to the
*/corresponding component of the DDIC structure of the export
*/table. For this to work, the fields of the TAB-delimited import
*/record must match one-to-one with the DDIC structure.
          LOOP AT it_tmp_dntab INTO wa_dntab.
            CLEAR:ls_raw_data_header.
            READ TABLE lt_raw_field INTO ls_raw_field INDEX sy-tabix.
*            READ TABLE it_tmp_dntab INTO wa_dntab WITH KEY fieldname = ls_raw_data_header-data.
            IF sy-subrc NE 0.
              CONTINUE.
            ENDIF.
            ASSIGN COMPONENT wa_dntab-fieldname
                OF STRUCTURE <lt_ddic> TO <ls_ddic>.
            IF sy-subrc EQ 0.
              IF NOT ls_raw_field-data IS INITIAL.
                CASE wa_dntab-inttype.
*               Date Field
                  WHEN 'D'.
                    <ls_ddic> = ls_raw_field-data.
*               Number Field
                  WHEN  'I' OR 'b' OR 's' OR 'P' OR 'F' OR 'N'.
                    IF wa_dntab-decimals > 0.
                      lv_length  = numofchar( ls_raw_field-data ).
                      lv_length = lv_length - wa_dntab-decimals.
                      lv_length = lv_length - 1.
                      lv_decimal_seprator = ls_raw_field-data+lv_length(1).
                      lv_period_seprator = '.'.
                      IF lv_decimal_seprator =  '.'.
                        lv_period_seprator = ','.
                      ENDIF.
                      REPLACE ALL OCCURRENCES OF lv_period_seprator
                              IN ls_raw_field-data WITH space.
                      CONDENSE ls_raw_field-data NO-GAPS.
                      lv_length  = numofchar( ls_raw_field-data ).
                      lv_length = lv_length - wa_dntab-decimals.
                      lv_length = lv_length - 1.
                      ls_raw_field-data+lv_length(1) = '.'.
                    ELSE.
                      REPLACE ALL OCCURRENCES OF '.'
                              IN ls_raw_field-data WITH space.
                      CONDENSE ls_raw_field-data NO-GAPS.
                      REPLACE ALL OCCURRENCES OF ','
                              IN ls_raw_field-data WITH space.
                      CONDENSE ls_raw_field-data NO-GAPS.
                    ENDIF.
                    <ls_ddic> = ls_raw_field-data.
*               Time field
                  WHEN 'T'.
                    <ls_ddic> = ls_raw_field-data.
*               Charcter
                  WHEN 'C'.
                    <ls_ddic> = ls_raw_field-data.
*               string
                  WHEN 'g' OR 'y' OR 'v'.
                    <ls_ddic> = ls_raw_field-data.
                  WHEN OTHERS.
                    <ls_ddic> = ls_raw_field-data.
                ENDCASE.

              ENDIF.
            ELSE.
              EXIT.
            ENDIF.
            UNASSIGN <ls_ddic>.
          ENDLOOP.
          APPEND <lt_ddic> TO et_ddic_data.
        ENDLOOP.

*/Catch any errors and raise exception
      CATCH cx_root INTO lr_error.
        RAISE generic_error.
    ENDTRY.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_COMMON=>COPY_CJR2_VALUES_PPM
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_ATTRIBUTES                  TYPE        /RPM/TS_DECISION_API
* | [--->] IV_ITEM_TYPE                   TYPE        /RPM/TV_ITEM_ID
* | [--->] IV_POSID                       TYPE        /RPM/TV_EXTID
* | [--->] IV_STATUS                      TYPE        /RPM/TV_STATUS_COMMON
* | [<---] ET_MESSAGES                    TYPE        /RPM/TT_MESSAGES
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD copy_cjr2_values_ppm.

************************************************
* Log issue 174 - coopy CJR2 values PPM to CF.
* Created by : C90005555 on 01.07.2024

************************************************
***********************************************************************
*  M O D I F I C A T I O N    L O G                                   *
***********************************************************************
*    Date   | TR Number  | Developement/  |       Description         *
*           |            | Modification   |                           *
***********************************************************************
*29.01.2026  DSDK9A07KC   CRQ#CHG0029188   Log Issue E457
*                                          just comment "#EC CI_VALPAR to fix
*                                           ATC check priority 2
*
*---------------------------------------------------------------------
   TYPES: BEGIN OF lty_year,
           year TYPE char4,
          END OF lty_year.
   DATA : lt_year TYPE STANDARD TABLE OF lty_year,
          lt_year_curr TYPE STANDARD TABLE OF lty_year,
          lt_messages TYPE /rpm/tt_messages,
          lt_fin_plan TYPE /rpm/tt_fin_plan,
          lt_fin_plan_curr TYPE /rpm/tt_fin_plan.
   DATA : lv_01 TYPE rpm_tv_capacity,
          lv_02 TYPE rpm_tv_capacity,
          lv_03 TYPE rpm_tv_capacity,
          lv_04 TYPE rpm_tv_capacity,
          lv_05 TYPE rpm_tv_capacity,
          lv_06 TYPE rpm_tv_capacity,
          lv_07 TYPE rpm_tv_capacity,
          lv_08 TYPE rpm_tv_capacity,
          lv_09 TYPE rpm_tv_capacity,
          lv_10 TYPE rpm_tv_capacity,
          lv_11 TYPE rpm_tv_capacity,
          lv_12 TYPE rpm_tv_capacity.

    CHECK is_attributes IS NOT INITIAL.

*  Define Macro for calculate monthly value for period
    DEFINE calculateperdvalue.
      IF &1 IS NOT INITIAL.
        IF &2 > 0.
          IF &3 <= 0.
            &3 =  &4 + &2.
          ELSE.
            &3 = &3 + &4.
          ENDIF.

        ELSE.
          &3 = &3 + &4.
        ENDIF.
      ELSE.
         &3 = &3 + &4.
      ENDIF.
    END-OF-DEFINITION.

    DATA(lv_status)  =  iv_status.

    CALL METHOD get_fin_plan_cjr2
      EXPORTING
        is_attributes       =   is_attributes  " Decision Point API attributes
        iv_item_type        =   iv_item_type  " Operational item persisted data
        iv_status           =   iv_status  " Status
      IMPORTING
        et_fin_plan_current =   lt_fin_plan_curr   " RPM Financial Plan
        et_fin_plan         =   lt_fin_plan   " RPM Financial Plan
        et_messages         =   lt_messages  " Table Type for Messages
      .

    CHECK  lt_fin_plan IS NOT INITIAL.

    IF lt_fin_plan IS NOT INITIAL.
        lt_year = VALUE #( BASE lt_year FOR ls_fin_plan IN lt_fin_plan
                               ( year = ls_fin_plan-period+0(4) )   ).
        SORT lt_year BY year.
        DELETE ADJACENT DUPLICATES FROM lt_year.
    ENDIF.

    IF lt_fin_plan_curr IS NOT INITIAL.
        lt_year_curr = VALUE #( BASE lt_year FOR ls_fin_plan IN lt_fin_plan_curr
                               ( year = ls_fin_plan-period+0(4) )   ).
        SORT lt_year_curr BY year.
        DELETE ADJACENT DUPLICATES FROM lt_year_curr.
    ENDIF.

    SELECT SINGLE * FROM prps INTO @DATA(ls_prps)
                     WHERE poski = @iv_posid
                     AND stufe = 1.

    CHECK sy-subrc IS INITIAL.

    SELECT  * FROM cosp INTO TABLE @DATA(lt_rpsco)
     WHERE lednr = '00'
      AND objnr  =  @ls_prps-objnr
      AND wrttp = '01'
      AND versn = 'CF'
      AND kstar = '0000480810'
      AND vrgng = 'RKP1'.
     IF sy-subrc is INITIAL.
       LOOP AT lt_year_curr ASSIGNING FIELD-SYMBOL(<fs_year>).

          LOOP AT lt_fin_plan_curr INTO DATA(ls_finplan) WHERE period+0(4) = <fs_year>-year .

            DATA(ls_rpsco) = VALUE #( lt_rpsco[ gjahr = <fs_year>-year  ] OPTIONAL ).

            CASE ls_finplan-period+4(2).
              WHEN '01'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg001 lv_01 ls_finplan-amount.
              WHEN '02'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg002 lv_02 ls_finplan-amount.
              WHEN '03'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg003 lv_03 ls_finplan-amount.
              WHEN '04'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg004 lv_04 ls_finplan-amount.
              WHEN '05'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg005 lv_05 ls_finplan-amount.
              WHEN '06'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg006 lv_06 ls_finplan-amount.
              WHEN '07'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg007 lv_07 ls_finplan-amount.
              WHEN '08'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg008 lv_08 ls_finplan-amount.
              WHEN '09'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg009 lv_09 ls_finplan-amount.
              WHEN '10'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg010 lv_10 ls_finplan-amount.
              WHEN '11'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg011 lv_11 ls_finplan-amount.
              WHEN '12'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg012 lv_12 ls_finplan-amount.
            ENDCASE.

          ENDLOOP.

          " Call BDC tcode CJR2
          CLEAR  lt_messages.
          CALL METHOD zcl_ppm_common=>bdc_cjr2_values_ppm
            EXPORTING
              lv_id       =  iv_posid
              iv_01       =  lv_01
              iv_02       =  lv_02
              iv_03       =  lv_03
              iv_04       =  lv_04
              iv_05       =  lv_05
              iv_06       =  lv_06
              iv_07       =  lv_07
              iv_08       =  lv_08
              iv_09       =  lv_09
              iv_10       =  lv_10
              iv_11       =  lv_11
              iv_12       =  lv_12
              iv_year     =  <fs_year>-year
            CHANGING
              et_messages =  lt_messages
            .
          CLEAR:    lv_01, lv_02, lv_03, lv_04, lv_05, lv_06,
                    lv_07, lv_08, lv_09, lv_10, lv_11, lv_12.
         ENDLOOP.

     ELSE.
         CLEAR ls_rpsco.
         LOOP AT lt_year ASSIGNING <fs_year>.

          LOOP AT lt_fin_plan INTO ls_finplan WHERE period+0(4) = <fs_year>-year .

            "ls_rpsco = VALUE #( lt_rpsco[ gjahr = '9999' ] OPTIONAL ).

            CASE ls_finplan-period+4(2).
              WHEN '01'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg001 lv_01 ls_finplan-amount.
              WHEN '02'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg002 lv_02 ls_finplan-amount.
              WHEN '03'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg003 lv_03 ls_finplan-amount.
              WHEN '04'.
                calculateperdvalue ls_rpsco ls_rpsco-wkg004 lv_04 ls_finplan-amount.
              WHEN '05'.
