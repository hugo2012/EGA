      lr_obj_manager    TYPE REF TO cl_rpm_obj_manager.

    DATA ls_context TYPE /rpm/ts_object_hier.
    DATA lv_ramt(15) TYPE c.
    DATA ls_attributes TYPE /rpm/ts_item_d_api.
    DATA lv_rc TYPE sysubrc.

* get decision details
    SELECT SINGLE * FROM /rpm/decision INTO @DATA(ls_decs)
                        WHERE guid = @iv_guid.
    IF sy-subrc IS NOT INITIAL.
      ev_rc = 4.
      EXIT.
    ENDIF.
    TRY.
*/Set language
        DATA(lv_langu) = sy-langu.

        DATA(lv_laiso) = cl_rpm_language_buffer=>convert_langu_to_laiso( lv_langu ).

        IF lv_laiso IS INITIAL .
          lv_laiso = 'EN' .
        ENDIF .

        CREATE OBJECT lr_msg_handler.
        lr_dependency_api ?= /rpm/cl_dependency_api=>get_instance( lv_langu ).

*--Instantiate the object manager
        lr_obj_manager = cl_rpm_obj_manager=>get_instance( ).
        ls_context-object_guid = ls_decs-item_guid.
        CALL METHOD cl_rpm_obj_manager=>read_item_detail
          EXPORTING
            iv_header_guid = ls_context-object_guid
            iv_language    = lv_laiso
          IMPORTING
            es_attributes  = ls_attributes.
      CATCH cx_root INTO lr_error.
        lv_rc = 4.
        CALL METHOD cl_rpm_message_services=>log_message_text
          EXPORTING
            iv_msgty     = cl_rpm_co=>sc_error
            ir_exception = lr_error.
    ENDTRY.


    IF lv_rc IS NOT INITIAL.
      ev_rc = 4.
      EXIT.
    ENDIF.

    IF ls_attributes-zzprolead IS INITIAL OR ls_attributes-zzspons IS INITIAL
      OR ls_attributes-zzrequestor IS INITIAL.
      ev_rc = 4.
      EXIT.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_COMMON=>WF_VALIDATE_USER
* +-------------------------------------------------------------------------------------------------+
* | [--->] IT_WF_LIST                     TYPE        ZPPM_DECISION_APP_TT
* | [--->] IV_GUID                        TYPE        RPM_TV_GUID
* | [--->] IV_ZCATEGORY                   TYPE        ZDE_CATEGORY(optional)
* | [<---] ET_MSG                         TYPE        ZPPM_MESSAGES_STRUC_TT
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD wf_validate_user.

* Method used to validate users that has been derived
* on WDA screen or keyed in by user . Checks happen
* based on partner type maintained in WF control table ZPPM028_V

***********************************************************************
*  M O D I F I C A T I O N    L O G                                   *
***********************************************************************
*    Date   | TR Number  | Developement/  |       Description         *
*           |            | Modification   |                           *
***********************************************************************
*29.01.2026  DSDK9A07KC   #CHG0029188   Log Issue E457
*                                           Update new Logic
*                                          Call FM ZPPM_FM_GET_WFTYPE_CATGORY
*                                          to get workflow type
*
*---------------------------------------------------------------------
* local variables
    DATA : lv_ivart       TYPE ima_ivart,
           lt_ptnr_checks TYPE zfi_ar_patnr_chks_tbl,
           lv_imparvw     TYPE parvw,
           lv_pernr       TYPE pernr_d,
           lv_imuser      TYPE usrid,
           lv_kostl       TYPE kostl,
           lr_grade       TYPE zhr_range_trfst,
           lv_hierarchy   TYPE char1,
           lv_level       TYPE numc2,
           lv_user        TYPE usrid,
           lt_return      TYPE STANDARD TABLE OF zppm_messages_struc,
           lt_arpartner   TYPE STANDARD TABLE OF zps_arpartner,
           wa_jest        TYPE jest,
           lr_level       TYPE zhr_range_level,
           ls_text        TYPE text120.

    DATA l_return TYPE zfi_ar_messages_struc.
    DATA l_invalid TYPE c.
    DATA lv_parnr TYPE i_parnr.

    DATA:
      lr_dependency_api TYPE REF TO /rpm/cl_dependency_api,
      lr_error          TYPE REF TO cx_root,
      lr_msg_handler    TYPE REF TO /rpm/cl_message_handle,
      lr_obj_manager    TYPE REF TO cl_rpm_obj_manager.

    DATA ls_context TYPE /rpm/ts_object_hier.
    DATA ls_attributes TYPE /rpm/ts_item_d_api.
    DATA lv_rc TYPE sysubrc.

*<<<< Start of the change by C90005555 #DSDK9A07KC  #CHG0029188 - Log Issue 457---------------------------------
    DATA: lv_wftype TYPE zzde_wftype,
          lt_wftype_msg    TYPE /rpm/tt_messages.
*>>>> End of change by C90005555 #DSDK9A07KC  #CHG0029188- Log Issue 457----------------------------------------
* get decision details
    SELECT SINGLE * FROM /rpm/decision INTO @DATA(ls_decs)
                        WHERE guid = @iv_guid.

    CHECK sy-subrc IS INITIAL
         AND it_wf_list IS NOT INITIAL.


    TRY.
*/Set language
        DATA(lv_langu) = sy-langu.

        DATA(lv_laiso) = cl_rpm_language_buffer=>convert_langu_to_laiso( lv_langu ).

        IF lv_laiso IS INITIAL .
          lv_laiso = 'EN' .
        ENDIF .

        CREATE OBJECT lr_msg_handler.
        lr_dependency_api ?= /rpm/cl_dependency_api=>get_instance( lv_langu ).

*--Instantiate the object manager
        lr_obj_manager = cl_rpm_obj_manager=>get_instance( ).
        ls_context-object_guid = ls_decs-item_guid.
        CALL METHOD cl_rpm_obj_manager=>read_item_detail
          EXPORTING
            iv_header_guid = ls_context-object_guid
            iv_language    = lv_laiso
          IMPORTING
            es_attributes  = ls_attributes.
      CATCH cx_root INTO lr_error.
        lv_rc = 4.
        CALL METHOD cl_rpm_message_services=>log_message_text
          EXPORTING
            iv_msgty     = cl_rpm_co=>sc_error
            ir_exception = lr_error.
    ENDTRY.

    CHECK lv_rc IS INITIAL.

    CALL FUNCTION 'HR_READ_INFOTYPE_AUTHC_DISABLE'.
    zcl_im_aprequest_update=>get_rule_dettails(
       EXPORTING
         i_rule_id     = '90000054'
       IMPORTING
         t_ptnr_checks = lt_ptnr_checks ).



*<<<< Start of the change by C90005555 #DSDK9A07KC  #CHG0029188 - Log Issue 457---------------------------------
*    SELECT SINGLE * FROM zppm035 INTO @DATA(ls_035)
*                             WHERE zzmteam = @ls_attributes-zzmteam
*                              AND  area = @ls_attributes-geography
*                              AND  zzplanst  = @ls_attributes-zzplanst.
***** Will call in FM but it still keep the existing logic
      CALL FUNCTION 'ZPPM_FM_GET_WFTYPE_CATGORY'
        EXPORTING
          iv_zcategory        = iv_zcategory
          is_attributes       = ls_attributes
       IMPORTING
         ev_zzwftype          = lv_wftype
       TABLES
         et_msg               = lt_wftype_msg
                .

*>>>> End of change by C90005555 #DSDK9A07KC  #CHG0029188- Log Issue 457----------------------------------------

    IF lv_wftype IS INITIAL.
      lv_ivart = 'EN'.
    ELSE.
      IF lv_wftype EQ 'MT1'
        OR lv_wftype EQ 'MT2'.
        lv_ivart = 'EN'.
      ELSE.
        lv_ivart = 'OT'.
      ENDIF.
    ENDIF.

*    DATA(lt_rinvestment) =  zcl_sd_utility=>get_tvarv( name = 'ZAR_IZWEK' type = 'S' ).
*    IF lt_rinvestment[] IS NOT INITIAL.
      IF ls_attributes-zzsource = 'EHS'.
        READ TABLE it_wf_list INTO DATA(ls_wf_list)
                                      WITH KEY parvw = 'YU'.
        IF sy-subrc IS INITIAL.
          IF ls_wf_list-bname IS NOT INITIAL.
          ELSE.
            l_return-ivart  = lv_ivart.
            l_return-parvw = 'YU'.
            l_return-vtext = get_partnertext( l_return-parvw ).
            l_return-message = |Partner YU is missing.| && | approver line no  { ls_wf_list-seqno }|.
            APPEND l_return TO et_msg.
          ENDIF.
        ELSE.
*          l_return-ivart  = lv_ivart.
*          l_return-parvw = 'YU'.
*          l_return-vtext = get_partnertext( l_return-parvw ).
*          l_return-message = |Partner YU is missing.|.
*          APPEND l_return TO et_msg.
        ENDIF.

      ENDIF.
*    ENDIF.

    LOOP AT  it_wf_list  INTO DATA(ls_partner).
      CLEAR: l_invalid, l_return.
      lv_parnr = ls_partner-bname.

      READ TABLE lt_ptnr_checks TRANSPORTING NO FIELDS WITH KEY artype = lv_ivart "i_master_data-ivart
                                                                patype = ls_partner-parvw.
      IF sy-subrc EQ 0.
        CLEAR : lv_kostl, lv_level, lv_hierarchy, lv_imparvw, lv_imuser, lv_user, lr_level.
        REFRESH lr_grade.

        LOOP AT lt_ptnr_checks INTO DATA(ls_ptnr_checks) WHERE artype EQ lv_ivart "i_master_data-ivart
                                                           AND patype EQ ls_partner-parvw.
          CASE ls_ptnr_checks-fieldname.
            WHEN 'CCTYPE'.
              CASE ls_ptnr_checks-value.
                WHEN 'RQ'.
                  lv_kostl =  ls_attributes-zzakstl.
                WHEN 'RS'.
                  lv_kostl = ls_attributes-zzfkstl.
                WHEN 'I1'.
                  lv_imparvw = ls_ptnr_checks-value.
              ENDCASE.
            WHEN 'GRADE'.
              APPEND VALUE #( sign = 'I' option = 'EQ' low = ls_ptnr_checks-value ) TO lr_grade.
            WHEN 'HIERARCHY'.
              lv_hierarchy = ls_ptnr_checks-value.
            WHEN 'LEVEL'.
              lv_level = ls_ptnr_checks-value.
              APPEND VALUE #( sign = 'I' option = 'EQ' low = ls_ptnr_checks-value ) TO lr_level.
          ENDCASE.
        ENDLOOP.
        IF sy-subrc EQ 0.
          IF lv_hierarchy EQ 'A'.
            READ TABLE lr_grade INTO DATA(ls_grade) INDEX 1.
            IF sy-subrc EQ 0.
              SEARCH sy-abcde FOR ls_grade-low.
              DATA(lv_number) = sy-fdpos.
              DO 10 TIMES.
                IF lv_number LT 0.
                  EXIT.
                ENDIF.
                APPEND VALUE #( sign = 'I' option = 'EQ' low = sy-abcde+lv_number(1) ) TO lr_grade.
                IF sy-abcde+lv_number(1) EQ 'C'.
                  APPEND VALUE #( sign = 'I' option = 'EQ' low = 'C1' ) TO lr_grade.
                ENDIF.
                lv_number = lv_number - 1.
              ENDDO.
            ENDIF.
          ENDIF.
          IF lv_hierarchy EQ 'S'.
            READ TABLE it_wf_list INTO DATA(ls_impartner) WITH KEY parvw = lv_imparvw.
            IF sy-subrc EQ 0.
              lv_imuser = ls_impartner-bname.
            ENDIF.
          ENDIF.

          lv_user = ls_partner-bname.
          zcl_im_aprequest_update=>user_grade_check_with_level(
            EXPORTING
              i_user    = lv_user
              i_kostl   = lv_kostl
              i_trfst   = lr_grade
              i_level   = lv_level
              i_heir    = lv_hierarchy
              i_imuser  = lv_imuser
              ir_level  = lr_level
            IMPORTING
              e_invalid = l_invalid
              e_return  = l_return ).
        ENDIF.

        IF l_invalid EQ 'X'.
          l_return-ivart   = lv_ivart.
          l_return-parvw   = ls_partner-parvw.
          l_return-vtext   = get_partnertext( ls_partner-parvw ).
          l_return-parnr   = ls_partner-bname.
          CONCATENATE l_return-message 'approver line no'  ls_partner-seqno  INTO l_return-message SEPARATED BY space.
          APPEND l_return TO et_msg.
        ENDIF.

      ELSE.
        SELECT SINGLE buc~external_id, itm~portfolio_guid, itm~external_id FROM /rpm/bucket_d AS buc INNER JOIN /rpm/item_d AS itm
          ON buc~guid = itm~parent_guid INTO
       ( @DATA(lv_position), @DATA(lv_port_guid), @DATA(lv_itm_extid) )
          WHERE itm~guid = @ls_attributes-guid.

        IF sy-subrc EQ 0.
          SELECT SINGLE parnr FROM zppm_pos_partner
            INTO @DATA(ls_defpartner)
           WHERE posid EQ @lv_position
             AND zim_rectype EQ 'D'
             AND patner EQ @ls_partner-parvw.
          IF sy-subrc EQ 0.
            IF ls_defpartner NE lv_parnr AND sy-subrc EQ 0.
              l_return-ivart   = lv_ivart.
              l_return-parvw   = ls_partner-parvw.
              l_return-vtext   = get_partnertext( ls_partner-parvw ).
              l_return-parnr   = ls_partner-bname.
              l_return-message = |Not maintained as per Table ZPPM_POS_PARTNER. Partner Should be { ls_defpartner }| &&
                                    | approver line no { ls_partner-seqno }|.
              APPEND l_return TO et_msg.
            ENDIF.
          ELSE.
            REFRESH: lt_arpartner.
            SELECT * FROM zps_arpartner
              INTO TABLE lt_arpartner
             WHERE parvw EQ ls_partner-parvw
               AND inact EQ ''.
            CHECK sy-subrc EQ 0.
            READ TABLE lt_arpartner INTO DATA(lwa_arpartner) WITH KEY parnr = lv_parnr.
            IF sy-subrc NE 0.
              CLEAR: ls_text.
*            IF ls_defpartner NE ls_partner-parnr AND sy-subrc EQ 0.
              l_return-ivart  = lv_ivart.
              l_return-parvw = ls_partner-parvw.
              l_return-vtext   = get_partnertext( ls_partner-parvw ).
              l_return-parnr = ls_partner-bname.
              LOOP AT lt_arpartner INTO lwa_arpartner.
                IF sy-tabix EQ '1'.
                  ls_text = lwa_arpartner-parnr.
                ELSE.
                  CONCATENATE ls_text  'or'  lwa_arpartner-parnr INTO ls_text SEPARATED BY space.
                ENDIF.
              ENDLOOP.
              l_return-message = |Not maintained as per Table ZPS_ARPARTNER. Partner should be { ls_text }|
                                && | approver line no { ls_partner-seqno }|.
              APPEND l_return TO et_msg.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDLOOP.


  ENDMETHOD.
ENDCLASS.
