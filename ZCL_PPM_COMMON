* set data back to ET_AGENTS and ET_APP_STAT
    SORT lt_zppm030 BY guid seqno.
    LOOP AT lt_zppm030 INTO DATA(ls_zppm030).
      AT NEW seqno.
        DATA(flag) = abap_true.
      ENDAT.
      IF flag EQ abap_true.
        MOVE-CORRESPONDING ls_attributes TO ls_agents.
        IF ls_agents-zzplanst EQ '01'.
          ls_agents-zzbstatus = 'Planned'.
        ELSEIF ls_agents-zzplanst EQ '02'.
          ls_agents-zzbstatus = 'Unplanned'.
        ELSE.
          ls_agents-zzbstatus = 'N/A'.
        ENDIF.
        ls_agents-seqno = ls_zppm030-seqno.
        ls_agents-viewtxt = lv_viewtext.
        ls_agents-amount = ls_zppm030-appamt.
        ls_agents-optional = ls_zppm030-optional.
