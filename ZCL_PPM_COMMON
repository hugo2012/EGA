* Created by : C90005555 on 02.07.2024

************************************************
***********************************************************************
*  M O D I F I C A T I O N    L O G                                   *
***********************************************************************
*    Date   | TR Number  | Developement/  |       Description         *
*           |            | Modification   |                           *
***********************************************************************
*29.01.2026  DSDK9A07KC   CRQ#CHG0029188   Log Issue E457
*                                          just comment "#EC CI_VALPAR to fix
*                                           ATC check priority 2
*
*---------------------------------------------------------------------
  DATA :  lv_01 TYPE wkgxxx,
          lv_02 TYPE wkgxxx,
          lv_03 TYPE wkgxxx,
          lv_04 TYPE wkgxxx,
          lv_05 TYPE wkgxxx,
          lv_06 TYPE wkgxxx,
          lv_07 TYPE wkgxxx,
          lv_08 TYPE wkgxxx,
          lv_09 TYPE wkgxxx,
          lv_10 TYPE wkgxxx,
          lv_11 TYPE wkgxxx,
          lv_12 TYPE wkgxxx.

    DATA :  lv_01_bdc TYPE char20,
            lv_02_bdc TYPE char20,
            lv_03_bdc TYPE char20,
            lv_04_bdc TYPE char20,
            lv_05_bdc TYPE char20,
            lv_06_bdc TYPE char20,
            lv_07_bdc TYPE char20,
            lv_08_bdc TYPE char20,
            lv_09_bdc TYPE char20,
            lv_10_bdc TYPE char20,
            lv_11_bdc TYPE char20,
            lv_12_bdc TYPE char20.

     DATA: lt_bdcdata TYPE STANDARD TABLE OF bdcdata,
           ls_bdcdata TYPE bdcdata.

     DATA:  lv_mode TYPE ctu_params-dismode,
            lv_upd  TYPE ctu_params-updmode,
            lt_msg  TYPE STANDARD TABLE OF bdcmsgcoll.

     SELECT SINGLE * FROM prps INTO @DATA(ls_prps)
                      WHERE poski = @lv_id
                      AND stufe = 1.

      CHECK sy-subrc IS INITIAL.

      GET PARAMETER ID 'CAC' FIELD DATA(lv_area).
      IF lv_area IS INITIAL AND ls_prps-pkokr  IS NOT INITIAL.
        SET PARAMETER ID 'CAC' FIELD ls_prps-pkokr .
      ENDIF.


      MOVE: iv_01 to lv_01,iv_02 to lv_02,iv_03 to lv_03,iv_04 to lv_04,
            iv_05 to lv_05,iv_06 to lv_06,iv_07 to lv_07,iv_08 to lv_08,
            iv_09 to lv_09,iv_10 to lv_10,iv_11 to lv_11,iv_12 to lv_12.

      IF lv_01 IS NOT INITIAL.
        MOVE :  lv_01 TO lv_01_bdc.
        CONDENSE lv_01_bdc NO-GAPS.
      ENDIF.
      IF lv_02 IS NOT INITIAL.
        MOVE :  lv_02 TO lv_02_bdc.
        CONDENSE lv_02_bdc NO-GAPS.
      ENDIF.
      IF lv_03 IS NOT INITIAL.
        MOVE :  lv_03 TO lv_03_bdc.
        CONDENSE lv_03_bdc NO-GAPS.
      ENDIF.
      IF lv_04 IS NOT INITIAL.
        MOVE :  lv_04 TO lv_04_bdc.
        CONDENSE lv_04_bdc NO-GAPS.
      ENDIF.
      IF lv_05 IS NOT INITIAL.
        MOVE :  lv_05 TO lv_05_bdc.
        CONDENSE lv_05_bdc NO-GAPS.
      ENDIF.
      IF lv_06 IS NOT INITIAL.
        MOVE :  lv_06 TO lv_06_bdc.
        CONDENSE lv_06_bdc NO-GAPS.
      ENDIF.
      IF lv_07 IS NOT INITIAL.
        MOVE :  lv_07 TO lv_07_bdc.
        CONDENSE lv_07_bdc NO-GAPS.
      ENDIF.
      IF lv_08 IS NOT INITIAL.
        MOVE :  lv_08 TO lv_08_bdc.
        CONDENSE lv_08_bdc NO-GAPS.
      ENDIF.
      IF lv_09 IS NOT INITIAL.
        MOVE :  lv_09 TO lv_09_bdc.
        CONDENSE lv_09_bdc NO-GAPS.
      ENDIF.
      IF lv_10 IS NOT INITIAL.
        MOVE :  lv_10 TO lv_10_bdc.
        CONDENSE lv_10_bdc NO-GAPS.
      ENDIF.
      IF lv_11 IS NOT INITIAL.
        MOVE :  lv_11 TO lv_11_bdc.
        CONDENSE lv_11_bdc NO-GAPS.
      ENDIF.
      IF lv_12 IS NOT INITIAL.
        MOVE :  lv_12 TO lv_12_bdc.
        CONDENSE lv_12_bdc NO-GAPS.
      ENDIF.

*    Define Macro for BDC Dynpro
      DEFINE bdc_dynpro.
        CLEAR ls_bdcdata.
        ls_bdcdata-program  = &1.
        ls_bdcdata-dynpro   = &2.
        ls_bdcdata-dynbegin = 'X'.
