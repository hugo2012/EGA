* pass the rate back
    IF ls_exch_rate_list IS NOT INITIAL.
      ev_rate = ls_exch_rate_list-exch_rate.
    ELSE.
      LOOP AT lt_exch_rate INTO ls_r3_rate.
        ev_rate = ls_r3_rate-exch_rate.
        EXIT.
      ENDLOOP.

    ENDIF.


  ENDMETHOD.


