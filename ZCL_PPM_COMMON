* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_COMMON=>GET_RESP_RULE_APP1
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_RULE                        TYPE        OBJID
* | [--->] IT_ACTOR_CONTAINER             TYPE        SWCONTTAB
* | [<---] ET_AGENTS                      TYPE        TSWHACTOR
* | [<---] EV_RC                          TYPE        SY-SUBRC
* | [!CX!] ZCX_SWF_NO_AGENT_FOUND
* | [!CX!] CX_HRPAD_ERD_NO_ACTIVE_PLVAR
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_resp_rule_app1.
* Get Agents based on responsibility rule  passed as import parameter
    DATA:
      lt_actor_container TYPE STANDARD TABLE OF swcont,
      lt_actor_tab       TYPE STANDARD TABLE OF swhactor,
      lt_messages        TYPE bapirettab,
      ls_message         TYPE bapiret2.

    DATA lv_plvar TYPE plvar.
    DATA lv_rule TYPE rhobjects-object.
    DATA: lv_eval_path      TYPE t77aw-wegid VALUE 'SAP_US_S',  "Note 1755407
          lv_ev_is_internal TYPE flag.                          "Note 1779360
    DATA: result_tab TYPE TABLE OF swhactor.

    lv_eval_path = 'SAP_TAGT'. " set evauation

    CALL FUNCTION 'RH_GET_ACTIVE_WF_PLVAR' " get planned version
      IMPORTING
        act_plvar       = lv_plvar
      EXCEPTIONS
        no_active_plvar = 1.
    IF sy-subrc <> 0.
      RAISE EXCEPTION TYPE cx_hrpad_erd_no_active_plvar.
    ENDIF.

    lv_rule = |AC|  && |{ iv_rule }|.
    CALL FUNCTION 'RH_GET_ACTORS' " FM to get responsibility rule data
      EXPORTING
        act_object                = lv_rule
        search_date               = sy-datum
        act_plvar                 = '01'
      TABLES
        actor_container           = it_actor_container
        actor_tab                 = lt_actor_tab
      EXCEPTIONS
        no_active_plvar           = 1
        no_actor_found            = 2
        exception_of_role_raised  = 3
        no_valid_agent_determined = 4
        no_container              = 5
        OTHERS                    = 6.

*set finance manager to conatiner element
    IF sy-subrc EQ 0.

      LOOP AT lt_actor_tab INTO DATA(ls_actor)
                            WHERE otype = 'S'.
        CLEAR result_tab[].
* Resolve the result actor_tab to users.
        CALL FUNCTION 'RH_STRUC_GET'
