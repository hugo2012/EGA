      CASE ls_wf_rule-ruletyp.

        WHEN 'L'." line manager

          TRY.
              ASSIGN COMPONENT 'ZZREQUESTOR' OF STRUCTURE ls_attributes TO FIELD-SYMBOL(<fs1>). "get requestor value
              IF <fs1> IS ASSIGNED.
                lv_objid = <fs1>.
                SELECT SINGLE usrid FROM pa0105 INTO lv_objid " get user id from comm tab
                                             WHERE pernr = <fs1>
                                             AND   subty = '0001'
                                             AND   endda GE sy-datum.
                " set container values
                swc_clear_container lt_actor_container.

                swc_set_element lt_actor_container 'OTYPE' 'US'.
                swc_set_element lt_actor_container 'OBJID' lv_objid.

                lv_rule = ls_wf_rule-ruleno.

                CALL METHOD zcl_ppm_common=>get_resp_rule_app1 " fetch agents rule no
                  EXPORTING
                    iv_rule            = lv_rule
                    it_actor_container = lt_actor_container
                  IMPORTING
                    et_agents          = lt_agents
                    ev_rc              = lv_rc.
                IF lv_rc IS INITIAL.
                  DELETE lt_agents WHERE otype <> 'US'.
                  IF lt_agents IS NOT INITIAL.
                    APPEND LINES OF lt_agents TO ch_actors. " set actors
                  ENDIF.
                ELSE.

                ENDIF.

              ENDIF.
            CATCH zcx_swf_no_agent_found.
            CATCH cx_hrpad_erd_no_active_plvar.

          ENDTRY.
        WHEN 'R'." Responsibility rule

          lv_rule = ls_wf_rule-ruleno.
          l_zzbunit = ls_attributes-zzbunit.
          l_dec_id = ls_decs-decision_id.
          l_item_type = ls_attributes-item_type.

          TRY.
              CALL METHOD zcl_ppm_common=>get_resp_rule_app2 " fetch agents rule no
                EXPORTING
                  iv_rule     = lv_rule
                  iv_phase    = l_dec_id
                  iv_itm_type = l_item_type
                  iv_bunit    = l_zzbunit
                  iv_amount   = lv_amt
                IMPORTING
                  et_agents   = lt_agents
                  ev_rc       = lv_rc.
              IF lv_rc IS INITIAL.
                DELETE lt_agents WHERE otype <> 'US'.
                IF lt_agents IS NOT INITIAL.
                  APPEND LINES OF lt_agents TO ch_actors. " set actors
                ENDIF.
              ENDIF.


            CATCH zcx_swf_no_agent_found.
            CATCH cx_hrpad_erd_no_active_plvar.
          ENDTRY.
        WHEN 'P'." fetch data based on employee no
* check the field assigned

          ASSIGN COMPONENT ls_wf_rule-ruleno OF STRUCTURE ls_attributes TO FIELD-SYMBOL(<fs>).
          IF <fs> IS ASSIGNED.
            lv_pernr = <fs>.
            CALL FUNCTION 'BAPI_EMPLOYEE_GETDATA'
              EXPORTING
                employee_id     = lv_pernr
                authority_check = ''
              TABLES
                org_assignment  = lt_orgdata
                communication   = lt_comm.
* check if COMM data exist
            READ TABLE lt_comm INTO DATA(ls_comm)
                               WITH KEY subtype = '0001'.
            IF sy-subrc IS INITIAL.
              ls_act-objid = ls_comm-userid.
              ls_act-otype = 'US'.
              APPEND ls_act TO ch_actors.
              CLEAR ls_act.
            ENDIF.
          ENDIF.

        WHEN 'C'." Custom table logic can be extended here!
* rule used to get partner function..if more tables are going to be involved
* just extend the logic

          CLEAR selection_tab[].
          l_tablename = ls_wf_rule-ruleno.
          CHECK ls_wf_rule-parvw IS NOT INITIAL.
*          ASSIGN COMPONENT 'ZZPARVW' OF STRUCTURE ls_attributes TO FIELD-SYMBOL(<fs2>).
*          CHECK <fs2> IS ASSIGNED.

          CREATE DATA lo_table_ref TYPE STANDARD TABLE OF (l_tablename).

          CHECK lo_table_ref IS NOT INITIAL.

          ASSIGN lo_table_ref->* TO <dynamic_table>.
          CHECK <dynamic_table> IS ASSIGNED.
          CLEAR l_sel_val.
          l_sel_val = ls_wf_rule-parvw.
          CONCATENATE '''' l_sel_val '''' INTO l_sel_val.
          CONCATENATE 'PARVW' '=' l_sel_val INTO ls_selection_tab SEPARATED BY space.

          APPEND ls_selection_tab TO selection_tab.
          CLEAR ls_selection_tab.

          CONCATENATE 'AND' 'INACT' '=' 'SPACE' INTO ls_selection_tab SEPARATED BY space.

          APPEND ls_selection_tab TO selection_tab.

          SELECT * FROM (l_tablename) INTO TABLE <dynamic_table>
                                 WHERE (selection_tab).

          LOOP AT <dynamic_table> ASSIGNING FIELD-SYMBOL(<fs_dynamic_data>).
            ASSIGN COMPONENT 'PARNR' OF STRUCTURE <fs_dynamic_data> TO FIELD-SYMBOL(<fs3>).
            CHECK <fs3> IS ASSIGNED.
            ls_act-objid = <fs3>.
            ls_act-otype = 'US'.
            APPEND ls_act TO ch_actors.
            CLEAR ls_act.
          ENDLOOP.

        WHEN 'K'."cost center manager rule

          ASSIGN COMPONENT 'ZZAKSTL' OF STRUCTURE ls_attributes TO <fs1>.
          IF <fs1> IS ASSIGNED.

            SELECT SINGLE verak_user FROM csks          "#EC CI_GENBUFF
                                       INTO lv_user
                               WHERE kostl = <fs1>
                                AND  datbi GE sy-datum.

            IF lv_user IS NOT INITIAL.
              ls_act-objid = lv_user.
              ls_act-otype = 'US'.
              APPEND ls_act TO ch_actors.
              CLEAR ls_act.
            ENDIF.
          ENDIF.
        WHEN 'A'. " adhoc just append the data



      ENDCASE.

    ELSE.
      " contd
    ENDIF.



    READ TABLE ch_appstatus INTO ls_app_stat
                               WITH KEY seqno = lv_seqno.
    IF sy-subrc IS INITIAL.
      lv_role = ls_app_stat-role.
      DELETE ch_appstatus WHERE seqno = lv_seqno.
    ENDIF.

    DELETE ADJACENT DUPLICATES FROM ch_actors COMPARING objid.
    LOOP AT ch_actors INTO DATA(ls_actors).

      ls_appr-user =  e_approvalwith = lv_user = ls_actors-objid.
      lv_user_info =   get_user_info( ov_user = lv_user ).
      ls_app_stat-app_name = lv_user_info-name.
      ls_app_stat-status = gc_pending.
      ls_appr-seqno =  ls_app_stat-seqno = lv_seqno.
      ls_app_stat-role = lv_role.
      APPEND ls_app_stat TO ch_appstatus.

      APPEND ls_appr TO lt_appr.
      CLEAR ls_appr.

    ENDLOOP.
* fetch existing actors
    SELECT * FROM zppm030 INTO TABLE @DATA(lt_ppm030)
                          WHERE guid = @iv_guid.

    SORT ch_appstatus BY seqno.
    DELETE lt_ppm030 WHERE seqno = lv_seqno.

    LOOP AT lt_ppm030 INTO DATA(ls_030).

      ls_ppm030-seqno = ls_030-seqno.
      ls_ppm030-bname = ls_030-appr.
      ls_ppm030-apprname = ls_030-apprname.
      ls_ppm030-amt  = lv_amt.
      IF ls_030-status EQ 'P'.
        ls_ppm030-appstatus = gc_pending.
        ls_ppm030-status  = 'P'.
      ELSE.
        ls_ppm030-status = 'A'.
        ls_ppm030-appstatus = gc_approved.
      ENDIF.
      ls_ppm030-optional = ls_030-optional.
      ls_ppm030-optemail_user = ls_030-optemail_user.
      ls_ppm030-role = ls_030-approle.
      APPEND ls_ppm030 TO lt_applist.
      CLEAR ls_ppm030.


    ENDLOOP.
* set the values
    LOOP AT lt_appr INTO ls_appr.
      ls_ppm030-seqno = ls_appr-seqno.
      lv_user = ls_ppm030-bname = ls_appr-user.

      lv_user_info = get_user_info( ov_user = lv_user ).
      ls_ppm030-apprname =  lv_user_info-name.
      ls_ppm030-amt  = lv_amt.
      ls_ppm030-appstatus = gc_pending.
      ls_ppm030-status  = 'P'.
      ls_ppm030-role  = lv_role.
      APPEND ls_ppm030 TO lt_applist.
      CLEAR ls_ppm030.
    ENDLOOP.
* update the data back toe ZPPM030
    SORT lt_applist BY seqno.
    CALL FUNCTION 'ZPPM_FM_WF_APP_LIST_UPDATE'
      EXPORTING
        iv_guid    = iv_guid
        iv_mode    = 'U'
      TABLES
        t_app_list = lt_applist.


  ENDMETHOD.


