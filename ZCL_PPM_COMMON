* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_currency_rate.

    DATA: ls_from_curr      TYPE bapi1093_3,
          lt_from_curr      TYPE TABLE OF bapi1093_3,
          lt_to_curr        TYPE TABLE OF bapi1093_4,
          ls_to_curr        TYPE bapi1093_4,
          lt_exch_rate      TYPE TABLE OF bapi1093_0,
          lt_return         TYPE TABLE OF bapiret1,
          ls_r3_rate        TYPE bapi1093_0,
          lv_rate           TYPE rpm_ts_exch_rate-exch_rate,
