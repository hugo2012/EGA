* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_COMMON=>GET_DP_LIST
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_GUID                        TYPE        RPM_TV_GUID(optional)
* | [<---] ET_EMAIL                       TYPE        BAPI_ECMVAL_WF_ADDRESS_TAB
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_dp_list.

    CONSTANTS:lc_dp_list TYPE tvarvc-name VALUE 'ZPPM_WF_DIST_LIST_ID'.
    DATA l_dist_lst_name TYPE so_obj_nam.
    DATA: lt_dli_app    TYPE STANDARD TABLE OF sodlienti1.
    DATA: lt_users TYPE STANDARD TABLE OF swhactor.
    DATA: ls_user_data  TYPE bapiaddr3.
    DATA  lt_return   TYPE bapirettab.
    DATA  lw_address  TYPE bapi_ecmval_wf_address.

    SELECT SINGLE * FROM tvarvc INTO @DATA(l_tvar)
                 WHERE name = @lc_dp_list.

    l_dist_lst_name = l_tvar-low.
    CALL FUNCTION 'SO_DLI_READ_API1'
      EXPORTING
        dli_name                   = l_dist_lst_name
        shared_dli                 = abap_true
      TABLES
        dli_entries                = lt_dli_app
      EXCEPTIONS
        dli_not_exist              = 1
        operation_no_authorization = 2
        parameter_error            = 3
        x_error                    = 4
        OTHERS                     = 5.
    IF sy-subrc = 0 AND lt_dli_app IS NOT INITIAL.

      lt_users = VALUE #( BASE lt_users FOR ls_ap IN lt_dli_app
                                        ( objid = ls_ap-member_nam
                                          otype = 'US' ) ).

      LOOP AT lt_users INTO DATA(ls_user).
        CLEAR: lt_return[],ls_user_data.

        CALL FUNCTION 'BAPI_USER_GET_DETAIL'
          EXPORTING
            username = ls_user-objid
          IMPORTING
            address  = ls_user_data
          TABLES
            return   = lt_return.
        IF NOT ls_user_data-e_mail IS INITIAL.
          CLEAR lw_address.
          lw_address-e_mail = ls_user_data-e_mail.
          APPEND lw_address TO et_email.
        ENDIF.

      ENDLOOP.

    ENDIF.

    IF iv_guid IS NOT INITIAL.

      DATA ls_actor    TYPE swhactor.

      DATA:
        lr_dependency_api TYPE REF TO /rpm/cl_dependency_api,
        lr_error          TYPE REF TO cx_root,
        lr_msg_handler    TYPE REF TO /rpm/cl_message_handle,
        lr_obj_manager    TYPE REF TO cl_rpm_obj_manager.

      DATA ls_context TYPE /rpm/ts_object_hier.
      DATA ls_attributes TYPE /rpm/ts_item_d_api.
      DATA lv_rc TYPE sysubrc.

      SELECT SINGLE * FROM /rpm/decision INTO @DATA(ls_decs)
                          WHERE guid = @iv_guid.

      CHECK sy-subrc IS INITIAL.


      TRY.
*/Set language
          DATA(lv_langu) = sy-langu.

          DATA(lv_laiso) = cl_rpm_language_buffer=>convert_langu_to_laiso( lv_langu ).

          IF lv_laiso IS INITIAL .
            lv_laiso = 'EN' .
          ENDIF .

          CREATE OBJECT lr_msg_handler.
          lr_dependency_api ?= /rpm/cl_dependency_api=>get_instance( lv_langu ).

*--Instantiate the object manager
          lr_obj_manager = cl_rpm_obj_manager=>get_instance( ).
          ls_context-object_guid = ls_decs-item_guid.
          CALL METHOD cl_rpm_obj_manager=>read_item_detail
            EXPORTING
              iv_header_guid = ls_context-object_guid
              iv_language    = lv_laiso
            IMPORTING
              es_attributes  = ls_attributes.
        CATCH cx_root INTO lr_error.
          lv_rc = 4.
          CALL METHOD cl_rpm_message_services=>log_message_text
            EXPORTING
              iv_msgty     = cl_rpm_co=>sc_error
              ir_exception = lr_error.
      ENDTRY.

      CHECK lv_rc IS INITIAL.

      IF ls_attributes-zzspons IS NOT INITIAL.

        SELECT SINGLE *
          FROM pa0105
          INTO @DATA(ls_105)
         WHERE pernr EQ @ls_attributes-zzspons
           AND subty EQ '0001'
           AND begda LE @sy-datum
           AND endda GE @sy-datum.
        IF sy-subrc EQ 0.

          ls_user-objid = ls_105-usrid.

          CLEAR: lt_return[],ls_user_data.

          CALL FUNCTION 'BAPI_USER_GET_DETAIL'
            EXPORTING
              username = ls_user-objid
            IMPORTING
              address  = ls_user_data
            TABLES
              return   = lt_return.
          IF NOT ls_user_data-e_mail IS INITIAL.
            CLEAR lw_address.
            lw_address-e_mail = ls_user_data-e_mail.
            APPEND lw_address TO et_email.
          ENDIF.

        ENDIF.
      ENDIF.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_COMMON=>GET_EMAIL_ID
* +-------------------------------------------------------------------------------------------------+
* | [--->] IM_ACTOR                       TYPE        TSWHACTOR(optional)
* | [--->] IM_INITIATOR                   TYPE        WFSYST-INITIATOR(optional)
* | [<---] ET_EMAIL                       TYPE        BAPI_ECMVAL_WF_ADDRESS_TAB
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_email_id.
    DATA: ls_swhactor TYPE swhactor.
    DATA: lt_user_list TYPE STANDARD TABLE OF swhactor.
    DATA: lt_users TYPE STANDARD TABLE OF swhactor.
    DATA: ls_user_data  TYPE bapiaddr3.
    DATA  lt_return   TYPE bapirettab.
    DATA  lw_address  TYPE bapi_ecmval_wf_address.


    LOOP AT im_actor INTO DATA(ls_actor).
      CALL FUNCTION 'SWI_GET_USERS_OF_ORG_UNIT'
        EXPORTING
          otype           = ls_actor-otype
          objid           = ls_actor-objid
        TABLES
          user_list       = lt_user_list
        EXCEPTIONS
          not_found       = 1
          no_active_plvar = 2
          OTHERS          = 3.
      IF sy-subrc EQ 0.
        SORT lt_user_list BY otype objid.
        DELETE lt_user_list WHERE otype NE 'US'.
        DELETE ADJACENT DUPLICATES FROM lt_user_list
            COMPARING otype objid.

        APPEND LINES OF lt_user_list TO lt_users.
        CLEAR lt_user_list[].
      ENDIF.

    ENDLOOP.

    LOOP AT lt_users INTO DATA(ls_user).
      CLEAR: lt_return[],ls_user_data.

      CALL FUNCTION 'BAPI_USER_GET_DETAIL'
        EXPORTING
          username = ls_user-objid
        IMPORTING
          address  = ls_user_data
        TABLES
          return   = lt_return.
      IF NOT ls_user_data-e_mail IS INITIAL.
        CLEAR lw_address.
        lw_address-e_mail = ls_user_data-e_mail.
        APPEND lw_address TO et_email.
      ENDIF.

    ENDLOOP.

    IF im_initiator NE space.
      CLEAR: lt_return[],ls_user_data.
      ls_user-objid = im_initiator+2.

      CALL FUNCTION 'BAPI_USER_GET_DETAIL'
        EXPORTING
          username = ls_user-objid
        IMPORTING
          address  = ls_user_data
        TABLES
          return   = lt_return.
      IF NOT ls_user_data-e_mail IS INITIAL.
        CLEAR lw_address.
        lw_address-e_mail = ls_user_data-e_mail.
        APPEND lw_address TO et_email.
      ENDIF.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_COMMON=>GET_FIN_PLAN_CJR2
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_ATTRIBUTES                  TYPE        /RPM/TS_DECISION_API
* | [--->] IV_ITEM_TYPE                   TYPE        /RPM/TV_ITEM_ID
* | [--->] IV_STATUS                      TYPE        /RPM/TV_STATUS_COMMON
* | [<---] ET_FIN_PLAN_CURRENT            TYPE        /RPM/TT_FIN_PLAN
* | [<---] ET_FIN_PLAN                    TYPE        /RPM/TT_FIN_PLAN
* | [<---] ET_MESSAGES                    TYPE        /RPM/TT_MESSAGES
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_fin_plan_cjr2.

************************************************
* Log issue 174 - coopy CJR2 values PPM to CF.
* Created by : C90005555 on 01.07.2024

************************************************

***********************************************************************
*  M O D I F I C A T I O N    L O G                                   *
***********************************************************************
*    Date   | TR Number  | Developement/  |       Description         *
*           |            | Modification   |                           *
***********************************************************************
*29.01.2026  DSDK9A07KC   CRQ#CHG0029188   Log Issue E457
*                                          just comment "#EC CI_VALPAR to fix
*                                           ATC check priority 2
*
*---------------------------------------------------------------------
   DATA : lt_messages TYPE /rpm/tt_messages.
   DATA : lt_finplan_curr TYPE STANDARD TABLE OF /rpm/v_fin_plan,
          lt_fin_plan   TYPE /rpm/tt_fin_plan,
          lv_gate_curr_no   TYPE zzgateno,
          lv_gate_no_tmp    TYPE zzgateno,
          lv_loop_cnt   TYPE zzgateno,
          lt_view_curr  TYPE STANDARD TABLE OF  zppm042,
          lt_view TYPE STANDARD TABLE OF  zppm042.

    CHECK is_attributes IS NOT INITIAL.

    DATA(lv_status)  =  iv_status.

    SELECT * FROM /rpm/decision INTO TABLE @DATA(lt_dec)
          WHERE item_guid = @is_attributes-item_guid AND
                status = @lv_status
              AND decision_id IN ( 'ZDP00', 'ZDP01', 'ZDP02', 'ZDP03', 'ZDP04', 'ZDP05'  )
          ORDER BY decision_id.

    CHECK sy-subrc IS INITIAL.

    MOVE is_attributes-decision_id+4(1) TO lv_gate_curr_no.

* get FIN view data to fetch PHASE AMOUNT
    SELECT  zzitmty zzdecpt zzview zzcatg zzfingrp
       FROM zppm042  INTO CORRESPONDING FIELDS OF TABLE lt_view
      FOR ALL ENTRIES IN lt_dec
      WHERE zzitmty = iv_item_type
      AND zzdecpt =  lt_dec-decision_id.

    CHECK sy-subrc IS INITIAL.

    SORT lt_view BY zzitmty zzdecpt zzview.

    LOOP AT lt_view ASSIGNING FIELD-SYMBOL(<lfs_view>).
      MOVE <lfs_view>-zzdecpt+4(1) TO lv_gate_no_tmp .
      IF lv_gate_no_tmp > lv_gate_curr_no.
        DELETE lt_view WHERE zzdecpt = <lfs_view>-zzdecpt.
      ENDIF.
    ENDLOOP.
    CHECK lt_view IS NOT INITIAL.

    lt_view_curr = VALUE #( FOR ls_view_curr IN lt_view WHERE ( zzdecpt = is_attributes-decision_id  ) ( ls_view_curr ) ).

*  Get all fin plant amount
    SELECT * INTO TABLE @DATA(lt_fin_plan_1)
             FROM /rpm/v_fin_plan
             FOR ALL ENTRIES IN @lt_view
           WHERE item_d_guid     = @is_attributes-item_guid
                 AND category_id = @lt_view-zzcatg
                 AND plan_type   = @lt_view-zzview
                 AND group_id    = @lt_view-zzfingrp.
    IF sy-subrc IS INITIAL.
     et_fin_plan = CORRESPONDING #( lt_fin_plan_1 ).
    ENDIF.
*  Get current fin plant amount
     IF lt_view_curr IS NOT INITIAL.

         SELECT * INTO TABLE @DATA(lt_fin_plan_2)
                 FROM /rpm/v_fin_plan
                 FOR ALL ENTRIES IN @lt_view_curr
               WHERE item_d_guid     = @is_attributes-item_guid
                     AND category_id = @lt_view_curr-zzcatg
                     AND plan_type   = @lt_view_curr-zzview
                     AND group_id    = @lt_view_curr-zzfingrp.
        IF sy-subrc IS INITIAL.
           et_fin_plan_current = CORRESPONDING #( lt_fin_plan_2 ).
        ENDIF.
     ENDIF.
  ENDMETHOD."#EC CI_VALPAR


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_COMMON=>GET_FIN_VIEWS
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_OBJECT_ID                    TYPE        RPM_TV_GUID
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_fin_views.
* Based on object id get financial views ,financial groups and
* financial categorys

    DATA: lt_fin_display TYPE /rpm/tt_fin_display,
          ls_fin_display TYPE /rpm/ts_fin_display,
          ls_fin_views   TYPE /rpm/ts_fin_view,
          lt_fin_views   TYPE /rpm/tt_fin_views.

    DATA: lv_port_guid   TYPE rpm_tv_guid,
          lv_object_type TYPE /rpm/object_type,
          lv_laiso       TYPE  laiso.

    DATA: lv_port_type        TYPE /rpm/tv_portfolio,
          lt_category         TYPE /rpm/tt_fin_cat_api,
          lt_category_display TYPE /rpm/tt_fin_cat_api,
          ls_category         TYPE /rpm/ts_fin_cat_api.

    DATA:lt_fin_cat      TYPE STANDARD TABLE OF /rpm/fin_cat,
         ls_fin_cat      TYPE /rpm/fin_cat,
         lt_fin_group_db TYPE STANDARD TABLE OF /rpm/fin_group,
         ls_fin_group_db TYPE /rpm/fin_group.

    DATA:ls_group               TYPE /rpm/ts_fin_group_api.
    DATA:ls_portfolio             TYPE /rpm/portfolio_d.
    DATA:lt_cgpl_text     TYPE cgpl_tt_texts,
         lt_cgpl_text_tmp TYPE cgpl_tt_texts.

* get portfolio id from item table
    SELECT SINGLE portfolio_guid INTO lv_port_guid FROM /rpm/item_d WHERE guid = i_object_id.
* fetch portfolio master data
    SELECT SINGLE * FROM /rpm/portfolio_d INTO ls_portfolio
            WHERE guid = lv_port_guid.

    lv_port_type = ls_portfolio-portfolio_type.

    lv_laiso = cl_rpm_language_buffer=>convert_langu_to_laiso( sy-langu ).

* based on object id get financial categories
    SELECT * FROM /rpm/fin_cat INTO CORRESPONDING FIELDS OF TABLE lt_fin_cat
        WHERE parent_guid = i_object_id.
* fetch financial categaories texts
    IF lt_fin_cat IS NOT INITIAL.
      SELECT guid text1 langu FROM cgpl_text INTO CORRESPONDING FIELDS OF TABLE lt_cgpl_text
        FOR ALL ENTRIES IN lt_fin_cat
     WHERE guid = lt_fin_cat-guid AND langu = sy-langu.
    ENDIF.

    LOOP AT lt_fin_cat INTO ls_fin_cat.
      MOVE-CORRESPONDING ls_fin_cat TO ls_category.
      ls_category-external_id = ls_fin_cat-category.
      APPEND ls_category TO lt_category.
    ENDLOOP.
* get financial capacity information
    CALL METHOD /rpm/cl_configuration=>get_fin_cap_display
      EXPORTING
        iv_fincap_type = /rpm/cl_co=>sc_financial
      IMPORTING
        et_fin_display = lt_fin_display.

    lv_object_type = /rpm/cl_co=>sc_item.
* get fianacial views
    CALL METHOD /rpm/cl_configuration=>get_financial_view_types
      EXPORTING
        iv_portfolio_guid = lv_port_guid
        iv_object_type    = lv_object_type
        iv_language       = lv_laiso
        iv_portfolio_type = lv_port_type
      IMPORTING
        et_fin_views      = gt_fin_views.

    LOOP AT gt_fin_views INTO ls_fin_views.
      LOOP AT lt_category INTO ls_category.
        LOOP AT lt_fin_display INTO ls_fin_display WHERE fin_view = ls_fin_views-fin_view AND
          ( category = ls_category-external_id OR category IS INITIAL ).
          READ TABLE gt_fin_cats WITH KEY external_id = ls_category-external_id TRANSPORTING NO FIELDS.
          IF sy-subrc NE 0.
            APPEND ls_category TO gt_fin_cats.
          ENDIF.
        ENDLOOP.
      ENDLOOP.
    ENDLOOP.
* based on financial category's fetch financial groups
    IF gt_fin_cats IS NOT INITIAL.
      SELECT * FROM /rpm/fin_group
        INTO CORRESPONDING FIELDS OF TABLE lt_fin_group_db
        FOR ALL ENTRIES IN gt_fin_cats
        WHERE parent_guid = gt_fin_cats-guid.
    ENDIF.

    LOOP AT lt_fin_group_db INTO ls_fin_group_db.
      MOVE-CORRESPONDING ls_fin_group_db TO ls_group.
      ls_group-external_id = ls_fin_group_db-group_id.
      APPEND ls_group TO gt_fin_groups.
      CLEAR: ls_group,ls_fin_group_db.
    ENDLOOP.



  ENDMETHOD.


