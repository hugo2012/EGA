        CALL METHOD cl_rpm_message_services=>log_message_text
          EXPORTING
            iv_msgty     = cl_rpm_co=>sc_error
            ir_exception = lr_error.
    ENDTRY.



    itemid = ls_attributes-external_id.
    SELECT SINGLE item_type_t FROM /rpm/item_type_t INTO @DATA(item_type_t)
                                   WHERE langu = @sy-langu
                                    AND item_type = @ls_attributes-item_type.
    itemtype = item_type_t.
    SELECT SINGLE phase_text FROM zppm24 INTO @DATA(lv_gate_text)
                                  WHERE phase_id = @ls_decs-decision_id.
    descp = lv_gate_text.
    proj_desc = ls_attributes-proj_description.
    SELECT SINGLE text INTO lv_stat_text_new FROM /rpm/status_t WHERE langu     = sy-langu
                                                                AND   status    = ls_decs-status.
    SELECT SINGLE text INTO lv_stat_text_old FROM /rpm/status_t WHERE langu     = sy-langu
                                                            AND   status    = status.
    CALL METHOD cl_rpm_entity_services=>get_long_text_rpm
      EXPORTING
        iv_guid          = iv_guid
        iv_language      = lv_langu
*       iv_format        = '  '
      IMPORTING
        et_lines         = lt_lines
        ev_string        = lv_comment_old
      EXCEPTIONS
        invalid_language = 1
        invalid_text_id  = 2
        not_found        = 3
        OTHERS           = 4.
    IF sy-subrc IS INITIAL.
      CONCATENATE   cl_abap_char_utilities=>newline
                           cl_abap_char_utilities=>newline
                           lc_horizontal_line
                           cl_abap_char_utilities=>newline
                           INTO ls_separator.
      SPLIT lv_comment_old AT ls_separator INTO TABLE lt_note.
      LOOP AT lt_note INTO DATA(lv_note).

        CLEAR: lv_user_attributes,
               lv_comment_header.

        DATA(lv_pattern) = /rpm/cl_co=>sc_note_timestamp.
