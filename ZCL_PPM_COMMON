* | [--->] I_OBJECT_ID                    TYPE        RPM_TV_GUID
* | [<---] ET_PHASE                       TYPE        INM_TT_DP_PHASE_API
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_wbs.
* Get WBS linked to decision points item phases and decision tabs
* pass the object id which is item guid
* system will return all the associated phases with WBS links
    TYPES: BEGIN OF t_sv,
             sign(1)   TYPE c,
             option(2) TYPE c,
             low       TYPE dpr_tv_obl_type,
             high      TYPE dpr_tv_obl_type,
           END OF t_sv.
    DATA: lt_obl_type_sel_params TYPE TABLE OF t_sv,
          ls_obl_type_sel_param  LIKE LINE OF lt_obl_type_sel_params.
    DATA:lr_project      TYPE REF TO cl_rpm_project,
         lv_project_guid TYPE rpm_tv_guid.

    DATA lv_object_key              TYPE string.
    DATA lv_object_id               TYPE rpm_tv_obl_str_extid.
    DATA lv_proxy_class             TYPE dpr_tv_obl_proxy_class.


    DATA ls_decision                TYPE inm_ts_dp_text.
    DATA lt_decisions               TYPE TABLE OF inm_ts_dp_text.
    DATA lt_dp_strt_sts             TYPE TABLE OF /rpm/dp_status.
    DATA ls_dp_strt_sts             TYPE /rpm/dp_status.
    DATA lt_dpphase_t               TYPE TABLE OF /rpm/phase_t.
    DATA ls_dpphase_t               TYPE /rpm/phase_t.
    DATA lt_dp_phase_obj_links      TYPE TABLE OF rpm_obj_link.
    DATA ls_dp_wbs_obj_link         TYPE rpm_obj_link.
    DATA ls_dp_wbs                  TYPE inm_ts_dp_phase_api.
    DATA lt_dp_phases               TYPE TABLE OF inm_ts_dp_phase_api.
    DATA lv_description             TYPE string.
    DATA lt_dp_wbs_obj_links        TYPE TABLE OF rpm_obj_link.

* get item data
    SELECT SINGLE item_type INTO @DATA(lv_item_type) FROM /rpm/item_d WHERE guid = @i_object_id.
* get decision date
    SELECT * INTO TABLE @DATA(lt_decision_points)
    FROM /rpm/decision WHERE item_guid = @i_object_id.
* object grouping
    DATA(lv_obj_link_group) = cl_inm_of_co=>sc_group_ps_wbs_element.
    SELECT * INTO TABLE @DATA(lt_obl_types) FROM dpr_obl_obtyp
        WHERE grouping = @lv_obj_link_group
        AND category = @cl_inm_dfm_constants=>mc_dfm_category.
* loop at details
    LOOP AT lt_obl_types INTO DATA(ls_obl_type).
      ls_obl_type_sel_param-sign = 'I'.
      ls_obl_type_sel_param-option = 'EQ'.
      ls_obl_type_sel_param-low = ls_obl_type-object_type.
      APPEND ls_obl_type_sel_param TO lt_obl_type_sel_params.
    ENDLOOP.
* get phases texts
    SELECT * INTO CORRESPONDING FIELDS OF TABLE lt_dpphase_t
                FROM /rpm/phase_t WHERE item_type = lv_item_type AND langu = sy-langu.

*-Get the DP status
    SELECT * INTO TABLE lt_dp_strt_sts FROM /rpm/dp_status
      WHERE item_type = lv_item_type AND start_status = 'X'.

    LOOP AT lt_decision_points INTO DATA(ls_decision_point).
      CLEAR:ls_decision.
      READ TABLE lt_dpphase_t INTO ls_dpphase_t WITH KEY phase_id = ls_decision_point-decision_id.
      IF sy-subrc = 0.
        MOVE-CORRESPONDING ls_dpphase_t TO ls_decision.
      ELSE.
*     Description of decision point not configured in logon language
        ls_decision-phase_text = ls_decision_point-decision_id.
      ENDIF.
      MOVE-CORRESPONDING ls_decision_point TO ls_decision.
      IF ls_decision-status IS INITIAL.
        READ TABLE lt_dp_strt_sts INTO ls_dp_strt_sts WITH KEY phase_id = ls_decision_point-decision_id.
        IF sy-subrc EQ 0.
          ls_decision-status = ls_dp_strt_sts-status.
        ENDIF.
      ENDIF.
      APPEND ls_decision TO lt_decisions.
    ENDLOOP.
* get decision links
    IF lt_decisions IS NOT INITIAL.
      SELECT * FROM rpm_obj_link INTO CORRESPONDING FIELDS OF TABLE lt_dp_phase_obj_links
         FOR ALL ENTRIES IN lt_decisions WHERE project_guid = lt_decisions-guid
                                     AND object_type IN lt_obl_type_sel_params.
    ENDIF.

* loop against decisions and append respective WBS
    LOOP AT lt_decisions INTO ls_decision.

      CLEAR : ls_dp_wbs, ls_decision-changed_on, ls_dp_wbs_obj_link, lv_object_key, lv_object_id, lv_description.
      REFRESH: lt_dp_wbs_obj_links.

      LOOP AT lt_dp_phase_obj_links INTO ls_dp_wbs_obj_link WHERE project_guid = ls_decision-guid.
        APPEND ls_dp_wbs_obj_link TO lt_dp_wbs_obj_links.
      ENDLOOP.

      MOVE-CORRESPONDING  ls_decision TO ls_dp_wbs.
*-  Fill other dp attributes
      ls_dp_wbs-name = ls_decision-phase_text.
      ls_dp_wbs-dp_guid = ls_decision-guid.
      ls_dp_wbs-forecast_dec_date = ls_decision-decision_date.


      IF lt_dp_wbs_obj_links IS NOT INITIAL.
        LOOP AT lt_dp_wbs_obj_links INTO ls_dp_wbs_obj_link.
*   Get the external ID and description for the WBS element from the target system.
          CALL METHOD cl_dpr_obl_repository=>get_object_proxy_class
            EXPORTING
              iv_object_type = ls_dp_wbs_obj_link-object_type
            IMPORTING
              ev_proxy_class = lv_proxy_class
            EXCEPTIONS
              not_found      = 1
              OTHERS         = 2.

          lv_object_key = ls_dp_wbs_obj_link-object_key.
          lv_object_id = ls_dp_wbs_obj_link-external_id.

          TRY.
              CALL METHOD (lv_proxy_class)=>if_dpr_obl_proxy~check_existence
                EXPORTING
                  iv_object_type = ls_dp_wbs_obj_link-object_type
                IMPORTING
                  ev_description = lv_description
                CHANGING
                  cv_external_id = lv_object_id "lv_external_id
                  cv_object_key  = lv_object_key
                EXCEPTIONS
                  not_found      = 1
                  not_accessible = 2
                  OTHERS         = 4.
            CATCH cx_sy_dyn_call_illegal_class.
            CATCH cx_sy_dyn_call_illegal_method.
          ENDTRY.

          IF lv_object_id IS NOT INITIAL.
            ls_dp_wbs-posid = lv_object_id.
          ELSE.
            ls_dp_wbs-posid = ls_dp_wbs_obj_link-external_id.
          ENDIF.
          REPLACE ls_dp_wbs_obj_link-object_key IN ls_dp_wbs-posid WITH ''.
          IF lv_description IS NOT INITIAL.
            ls_dp_wbs-post1 = lv_description.
          ELSE.
            ls_dp_wbs-post1 = ls_dp_wbs_obj_link-description.
          ENDIF.
          APPEND ls_dp_wbs TO lt_dp_phases.
        ENDLOOP.
      ELSE.
        APPEND ls_dp_wbs TO lt_dp_phases.
      ENDIF.
    ENDLOOP.

    DELETE lt_dp_phases WHERE posid IS INITIAL.

    et_phase = lt_dp_phases. " pass the phases back

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_COMMON=>GET_WBS_COST
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_OBJECT_ID                    TYPE        RPM_TV_GUID
* | [--->] IT_PHASE                       TYPE        INM_TT_DP_PHASE_API
* | [<-->] CT_WBS_COST                    TYPE        ZPPM_TT_WBSCOST
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_wbs_cost.
* Get Cost based on WBS object number from COEP
* only actual cost is retrieved

    TYPES:BEGIN OF lty_objnr,
            post1   TYPE prps-post1,
            objnr   TYPE prps-objnr,
            poski   TYPE prps-poski,
            pbukr   TYPE prps-pbukr,
            pkokr   TYPE prps-pkokr,
            objlink TYPE rpm_fidata-objlink,
          END OF lty_objnr.
    TYPES: BEGIN OF lty_perioamt,
             objamt  TYPE rpm_fidata-objamt,
             period  TYPE /rpm/tv_period_id,
             objlink TYPE rpm_fidata-objlink,
             objcurr  TYPE rpm_fidata-objcurr,
           END OF lty_perioamt.
*    TYPES:BEGIN OF lty_coep,
*            objnr  TYPE coep-objnr,
*            wtgbtr TYPE coep-wtgbtr,
*            wogbtr TYPE coep-wogbtr,
*            wkgbtr TYPE coep-wkgbtr,
*            twaer  TYPE coep-twaer,
*            owaer  TYPE coep-owaer,
*          END OF lty_coep.

    TYPES:BEGIN OF lty_fidata,
            objlink  TYPE rpm_fidata-objlink,
            fiscyear TYPE rpm_fidata-fiscyear,
            perid    TYPE rpm_fidata-perid,
            acttype  TYPE rpm_fidata-acttype,
            amount   TYPE rpm_fidata-amount,
            currency TYPE rpm_fidata-currency,
            objamt   TYPE rpm_fidata-objamt,
            objcurr  TYPE rpm_fidata-objcurr,
          END OF lty_fidata.

    DATA lt_objnr TYPE TABLE OF lty_objnr.
    DATA lt_prps TYPE TABLE OF lty_objnr.
*    DATA lt_coep TYPE TABLE OF lty_coep.
    DATA lt_fidata TYPE TABLE OF lty_fidata.
    DATA lt_perioamt TYPE TABLE OF lty_perioamt.
    DATA ls_perioamt TYPE lty_perioamt.
    DATA lv_amt TYPE coep-wtgbtr.
    DATA lv_amount_external                  TYPE bapicurr-bapicurr.
    DATA ls_wbs TYPE zppm_s_wbscost.

    CHECK it_phase IS NOT INITIAL.
* get external id from /RPM/ITEM/_D
    SELECT SINGLE external_id INTO @DATA(lv_external_id) FROM /rpm/item_d WHERE guid = @i_object_id.
* get WBS no from PRPS
    SELECT SINGLE psphi FROM prps INTO @DATA(lv_psphi)
                                  WHERE poski = @lv_external_id.

* fetch all the object no for the WBS
    SELECT post1 objnr poski pbukr pkokr FROM prps INTO TABLE lt_objnr
                       WHERE psphi = lv_psphi.

    CHECK lt_objnr IS NOT INITIAL.

    LOOP AT lt_objnr ASSIGNING FIELD-SYMBOL(<fs>).
      <fs>-objlink = <fs>-poski.
    ENDLOOP.
* GET FI data against object number
    SELECT objlink fiscyear perid acttype amount currency objamt objcurr FROM rpm_fidata INTO TABLE lt_fidata
                             FOR ALL ENTRIES IN lt_objnr
                          WHERE objlink = lt_objnr-objlink
                           AND  version = '000'
                           AND  valtype = '04'.
    DELETE lt_fidata WHERE acttype IS INITIAL. " delete where acttype is not available
*    SELECT objnr wtgbtr wogbtr wkgbtr twaer owaer FROM coep INTO TABLE lt_coep
*                     FOR ALL ENTRIES IN lt_objnr
*                      WHERE kokrs = lt_objnr-pkokr
*                       AND  objnr = lt_objnr-objnr
*                       AND  wrttp = '04'
*                       AND  versn = '000'.


    CHECK lt_fidata IS NOT INITIAL.

    SORT lt_objnr BY poski.
* loop over the phases derived from WBS_COST method and return WBS cost values
    LOOP AT it_phase INTO DATA(ls_phase).

      LOOP AT lt_objnr INTO DATA(ls_objnr)
                       WHERE poski CS ls_phase-posid.
        CLEAR lv_amt.
        CLEAR lt_perioamt[].

        CLEAR lv_amount_external.
        SELECT SINGLE * FROM tka01 INTO @DATA(ls_tka01)
                    WHERE kokrs = @ls_objnr-pkokr.

        LOOP AT lt_fidata INTO DATA(ls_fidata)
                     WHERE objlink = ls_objnr-poski.

          lv_amt = lv_amt + ls_fidata-objamt.
          ls_perioamt-objamt = lv_amt.
          ls_perioamt-period = |{ ls_fidata-fiscyear }| && |{ ls_fidata-perid+1(2) }|.
          ls_perioamt-objlink = ls_fidata-objlink.
          ls_perioamt-objcurr = ls_fidata-objcurr.
          COLLECT ls_perioamt INTO lt_perioamt.
          CLEAR ls_perioamt.
          CLEAR lv_amt. "Inserted by Sang.Tran 16/07/2024 S-EGA-PPM-A-CHG11040 LI439 - Forecast values change to 0
        ENDLOOP.

        LOOP AT lt_perioamt INTO ls_perioamt.
          IF ls_perioamt-objamt IS NOT INITIAL.
            lv_amt = ls_perioamt-objamt.
            CALL FUNCTION 'BAPI_CURRENCY_CONV_TO_EXTERNAL'
              EXPORTING
                currency        = ls_tka01-waers
                amount_internal = lv_amt
              IMPORTING
                amount_external = lv_amount_external.
          ENDIF.

          MOVE-CORRESPONDING ls_phase TO ls_wbs.
          ls_wbs-wogbtr = lv_amount_external.
          ls_wbs-owaer = ls_tka01-waers.
          ls_wbs-twaer = ls_perioamt-objcurr.
          ls_wbs-posid = ls_objnr-poski.
          ls_wbs-post1 = ls_objnr-post1.
          ls_wbs-perid = ls_perioamt-period.

          APPEND ls_wbs TO ct_wbs_cost.
          CLEAR ls_wbs.
        ENDLOOP.

      ENDLOOP.

    ENDLOOP.





  ENDMETHOD.


