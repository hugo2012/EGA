* | Static Private Method ZCL_PPM_COMMON=>READ_SHEET
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_FILENAME                    TYPE        ANY
* | [--->] IS_STRUCT                      TYPE        ANY
* | [<---] IT_LOAD_DATA                   TYPE        STANDARD TABLE
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD read_sheet.

    DATA: lv_max_sheet_count             TYPE i,
          lv_sheet_count                 TYPE i,
          lv_max_rows                    TYPE i,
          lv_max_cols                    TYPE i,
          lv_rc                          TYPE i,
          lt_raw_data_itm                TYPE STANDARD TABLE OF zrpm_ts_dx_raw_data, "#EC NEEDED
          lt_raw_data_itm_auth           TYPE STANDARD TABLE OF zrpm_ts_dx_raw_data, "#EC NEEDED
          lt_raw_data_itm_des_point      TYPE STANDARD TABLE OF zrpm_ts_dx_raw_data, "#EC NEEDED
          lt_raw_data_itm_des_point_auth TYPE STANDARD TABLE OF zrpm_ts_dx_raw_data,
          lt_raw_data                    TYPE STANDARD TABLE OF zrpm_ts_dx_raw_data.

    DATA: ls_raw_data  TYPE zrpm_ts_dx_raw_data,
          ls_null_data TYPE zrpm_ts_dx_raw_data,
          ls_raw_field TYPE zrpm_ts_dx_raw_data_field,
          lt_raw_field TYPE zrpm_tt_dx_raw_data_field.
*    DATA ls_dec_load LIKE LINE OF it_load_data.
    DATA:lr_stru TYPE REF TO data.

    CREATE DATA lr_stru TYPE (is_struct).
    ASSIGN lr_stru->* TO FIELD-SYMBOL(<ls_load_data>).

    FIELD-SYMBOLS:<filename> TYPE any.
    ASSIGN iv_filename TO <filename>.
    lv_sheet_count = 1.
    CALL METHOD OF
      lo_workbook
      'OPEN'
      EXPORTING
        #1 = <filename>.
    error_handler( ).

    lv_max_sheet_count = 1.
    WHILE lv_sheet_count <= lv_max_sheet_count.
      CALL METHOD OF
          lo_application
          'Worksheets'   = lo_worksheet
        EXPORTING
          #1             = lv_sheet_count.
      error_handler( ).
      CALL METHOD OF
        lo_worksheet
        'Activate'.
      error_handler( ).
      GET PROPERTY OF lo_application 'ACTIVESHEET' = lo_worksheet.
      error_handler( ).
**/Get Excel maximum rows and columns
      GET PROPERTY OF lo_worksheet 'ROWS' = lo_rows.
      error_handler( ).
      GET PROPERTY OF lo_rows 'COUNT' = lv_max_rows.
      error_handler( ).
      GET PROPERTY OF lo_worksheet 'COLUMNS' = lo_cols.
      error_handler( ).
      GET PROPERTY OF lo_cols 'COUNT' = lv_max_cols.
      error_handler( ).
**/Select the whole worksheet for reading
      CALL METHOD OF
          lo_worksheet
          'CELLS'      = lo_first_cell
        EXPORTING
          #1           = 1
          #2           = 1.
      error_handler( ).
      CALL METHOD OF
          lo_worksheet
          'CELLS'      = lo_last_cell
        EXPORTING
          #1           = lv_max_rows
          #2           = lv_max_cols.
      error_handler( ).
      CALL METHOD OF
          lo_worksheet
          'RANGE'      = lo_range
        EXPORTING
          #1           = lo_first_cell
          #2           = lo_last_cell.
      error_handler( ).
      CALL METHOD OF
        lo_range
        'SELECT'.
      error_handler( ).
**/Read the whole worksheet into clipboard
      CALL METHOD OF
        lo_range
        'COPY'.
      error_handler( ).
**/Read data from clipboard into SAP
      CALL METHOD cl_gui_frontend_services=>clipboard_import
        IMPORTING
          data                 = lt_raw_data
        EXCEPTIONS
          cntl_error           = 1
          error_no_gui         = 2
          not_supported_by_gui = 3
          OTHERS               = 4.
      error_handler( ).

      READ TABLE lt_raw_data INTO  ls_raw_data  INDEX 1.
*      DELETE lt_raw_data INDEX 1.

*/Exit on the first blank record
      ls_null_data = ls_raw_data.
      REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>horizontal_tab
              IN ls_null_data WITH space.
      CONDENSE ls_null_data NO-GAPS.
      IF ls_null_data(1) EQ space.
        EXIT.
      ENDIF.
*/First, fill a local table with all the fields in a single
*/TAB-delimited import record
      CLEAR lt_raw_field[].
      SPLIT ls_raw_data
            AT cl_abap_char_utilities=>horizontal_tab
            INTO TABLE lt_raw_field.

      conv_raw_data_to_ddic( EXPORTING is_raw_data = lt_raw_data is_struct = is_struct
                    it_header_field = lt_raw_field IMPORTING  is_ddic_struc = <ls_load_data> et_ddic_data = it_load_data ).


*/Clear the clipboard
      REFRESH lt_raw_data.
      CALL METHOD cl_gui_frontend_services=>clipboard_export
        IMPORTING
          data                 = lt_raw_data
        CHANGING
          rc                   = lv_rc
        EXCEPTIONS
          cntl_error           = 1
          error_no_gui         = 2
          not_supported_by_gui = 3
          OTHERS               = 4.
      error_handler( ).
      CLEAR lt_raw_data[].
      lv_sheet_count = lv_sheet_count + 1.
    ENDWHILE.


  ENDMETHOD.


