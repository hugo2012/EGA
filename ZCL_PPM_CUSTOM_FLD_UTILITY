CLASS ZCL_PPM_CUSTOM_FLD_UTILITY IMPLEMENTATION.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_PPM_CUSTOM_FLD_UTILITY->ADD_DESCRIPTIONS
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_VIEW                         TYPE REF TO IF_WD_VIEW
* | [--->] I_FIRST_TIME                   TYPE        WDY_BOOLEAN
* | [--->] I_ITEM_ATT                     TYPE        /RPM/TS_ITEM_D_UI
* | [--->] I_SPRAS                        TYPE        LAISO
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD add_descriptions.

*to determine which fields need the description added we check in the configuration that is there in SPRO.
* from the table /RPM/OBJ_CUS_FLD  only for those fields for which the service ID has been maintained as
*000000000000009 the description as a text view will be populated.

*then we check if the transparent container exist in the view for the z fields,
*we do this by checking if ZZXXXX_Container is available in the ROOTUIELEMENTCONTAINER or not.
*if the container is found then we add the the tex view to that container.
*and populate the text views dynamically

    DATA: lr_element TYPE REF TO if_wd_view_element.
    DATA: lr_transp_cont TYPE REF TO cl_wd_transparent_container,
          lr_textview    TYPE REF TO cl_wd_text_view,
          lt_stat_flds   TYPE STANDARD TABLE OF /rpm/obj_cus_fld.

    DATA: lv_ktext TYPE string,
          lv_id    TYPE string.
* fetch the configuration for the views

    SELECT * FROM /rpm/obj_cus_fld INTO TABLE @DATA(lt_obj_cus_fld)
      WHERE service_id = '000000000000009'.
    IF sy-subrc NE 0.
      CLEAR lt_obj_cus_fld.
    ENDIF.

*now loop at the config
*and check if the explicit search help fields are present in the present View'

    lt_stat_flds = VALUE #(   ( field_name = 'ZZSTATUS')
                              ( field_name = 'ZZSCHSTA')
                              ( field_name = 'ZZCSTAT') ).
    IF  i_first_time EQ 'X'.
      LOOP AT lt_obj_cus_fld INTO DATA(ls_obj_cus_fld).
        CONCATENATE ls_obj_cus_fld-field_name '_CONTAINER' INTO DATA(lv_cont_name).
        CONCATENATE ls_obj_cus_fld-field_name '_TEXT' INTO lv_id.

        CALL METHOD zcl_ppm_custom_fld_utility=>fetch_descriptions
          EXPORTING
            i_item_att   = i_item_att
            i_field_name = ls_obj_cus_fld-field_name
            i_spras      = i_spras
            i_first_time = i_first_time
          IMPORTING
            e_desc       = lv_ktext
            e_id         = lv_id.

        CALL METHOD zcl_ppm_custom_fld_utility=>add_textview
          EXPORTING
            i_id        = lv_id
            i_text      = lv_ktext
            i_cont_name = lv_cont_name
            i_view      = i_view.


      ENDLOOP.



      LOOP AT lt_stat_flds INTO DATA(ls_stat_fld).
*   get the contaier details
        CLEAR lr_element.

        CONCATENATE ls_stat_fld-field_name '_CONTAINER' INTO lv_cont_name.
        CONCATENATE ls_stat_fld-field_name '_ICON' INTO lv_id.

        CALL METHOD i_view->get_element
          EXPORTING
            id      = lv_cont_name
          RECEIVING
            element = lr_element.
* cast to transparent Container
        CLEAR lr_transp_cont.

        lr_transp_cont ?= lr_element. "cast to transparent container class

* fetch the image Source
        CALL METHOD zcl_ppm_custom_fld_utility=>fetch_image_src
          EXPORTING
            i_item_att   = i_item_att
            i_field_name = ls_stat_fld-field_name
          RECEIVING
            r_source     = DATA(lv_source).

        DATA(lr_img) = cl_wd_image=>new_image( id = lv_id source = lv_source  ).

        cl_wd_flow_data=>new_flow_data( element = lr_img ). " Fill layout data
        CALL METHOD lr_img->set_v_align
          EXPORTING
            value = '02'.

        IF lr_transp_cont IS BOUND.
* add to transparent Container for the Field.
          lr_transp_cont->add_child( lr_img ) .
          IF ls_stat_fld-field_name EQ 'ZZSCHSTA'.
* Fetch the long description of the schedule status field and add after the traffic light

            DATA(lv_patt) = i_item_att-zzschsta(1)  && '%'.

            SELECT SINGLE zzstatxt FROM zppm017 INTO @DATA(lv_statxt)
              WHERE zzschsta LIKE @lv_patt.
            IF sy-subrc IS INITIAL.

              CONCATENATE ls_stat_fld-field_name '_TEXT' INTO lv_id.

              IF i_item_att-zzschsta IS INITIAL.
                CLEAR lv_ktext.
              ELSE.
                lv_ktext = |->| && lv_statxt.
              ENDIF.
              CALL METHOD zcl_ppm_custom_fld_utility=>add_textview
                EXPORTING
                  i_id        = lv_id
                  i_text      = lv_ktext
                  i_cont_name = lv_cont_name
                  i_view      = i_view.
            ENDIF.
          ENDIF.
        ENDIF.
        CLEAR: lr_transp_cont, lr_img, lr_element.

      ENDLOOP.

    ELSE.
*        just update the Texts based on the Context values.

      LOOP AT lt_obj_cus_fld INTO ls_obj_cus_fld.

        CONCATENATE ls_obj_cus_fld-field_name '_TEXT' INTO lv_id.

        CALL METHOD zcl_ppm_custom_fld_utility=>fetch_descriptions
          EXPORTING
            i_item_att   = i_item_att
            i_field_name = ls_obj_cus_fld-field_name
            i_spras      = i_spras
            i_first_time = i_first_time
          IMPORTING
            e_desc       = lv_ktext
            e_id         = lv_id.

        CALL METHOD i_view->get_element
          EXPORTING
            id      = lv_id
          RECEIVING
            element = lr_element.

        IF lr_element IS NOT INITIAL.

          lr_textview ?= lr_element.

          CALL METHOD lr_textview->set_text
            EXPORTING
              value = lv_ktext.
          .
        ENDIF.
        CLEAR: lr_element, lr_textview, lv_id, lv_ktext.

      ENDLOOP.

* update the icons for the status fields.
      LOOP AT lt_stat_flds INTO ls_stat_fld.

*   get the image details
        CLEAR lv_id.
        CONCATENATE ls_stat_fld-field_name '_ICON' INTO lv_id.

        CLEAR lr_element.

        CALL METHOD i_view->get_element
          EXPORTING
            id      = lv_id
          RECEIVING
            element = lr_element.

*cast to Image element
        CLEAR lr_img.

        lr_img ?= lr_element.

        CLEAR lv_source.

        CALL METHOD zcl_ppm_custom_fld_utility=>fetch_image_src
          EXPORTING
            i_item_att   = i_item_att
            i_field_name = ls_stat_fld-field_name
          RECEIVING
            r_source     = lv_source.

        IF lv_source IS NOT INITIAL.
**begin of: Log issue 445 - commented to prevent dump error when lr_img is initial
*          CALL METHOD lr_img->set_source
*            EXPORTING
*              value = lv_source.
***** added check lr_img before call lr_img->set_source
          IF lr_img IS NOT INITIAL.
           CALL METHOD lr_img->set_source
            EXPORTING
              value = lv_source.
          ENDIF.
**End of: Log issue 445 - commented to prevent dump error when lr_img is initial
        ENDIF.
        IF ls_stat_fld-field_name EQ 'ZZSCHSTA'.
* Fetch the long description of the schedule status field and add after the traffic light

          lv_patt = i_item_att-zzschsta(1)  && '%'.

          SELECT SINGLE zzstatxt FROM zppm017 INTO @lv_statxt
            WHERE zzschsta LIKE @lv_patt.
          IF sy-subrc IS INITIAL.

            CONCATENATE ls_stat_fld-field_name '_TEXT' INTO lv_id.

            IF i_item_att-zzschsta IS INITIAL.
              CLEAR lv_ktext.
            ELSE.
              lv_ktext = |->| && lv_statxt.
            ENDIF.
            CALL METHOD i_view->get_element
              EXPORTING
                id      = lv_id
              RECEIVING
                element = lr_element.

            IF lr_element IS NOT INITIAL.

              lr_textview ?= lr_element.

              CALL METHOD lr_textview->set_text
                EXPORTING
                  value = lv_ktext.
              .
            ENDIF.
            CLEAR: lr_element, lr_textview, lv_id, lv_ktext.
          ENDIF.
        ENDIF.

      ENDLOOP.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Private Method ZCL_PPM_CUSTOM_FLD_UTILITY=>ADD_TEXTVIEW
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_ID                           TYPE        STRING
* | [--->] I_TEXT                         TYPE        STRING
* | [--->] I_CONT_NAME                    TYPE        STRING
* | [--->] I_VIEW                         TYPE REF TO IF_WD_VIEW
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD add_textview.
    DATA: lr_transp_cont TYPE REF TO cl_wd_transparent_container.

    CALL METHOD i_view->get_element
      EXPORTING
        id      = i_cont_name
      RECEIVING
        element = DATA(lr_element).

    IF lr_element IS NOT INITIAL.

      DATA(lr_textview) = cl_wd_text_view=>new_text_view( view = i_view id = i_id text = i_text ).

      lr_transp_cont ?= lr_element. "cast to transparent container class

      cl_wd_flow_data=>new_flow_data( element = lr_textview ). " Fill layout data

      lr_transp_cont->add_child( lr_textview ). "add to the container

    ENDIF.
  ENDMETHOD.


