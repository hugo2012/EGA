* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_CUSTOM_FLD_UTILITY=>FETCH_DESCRIPTIONS
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_ITEM_ATT                     TYPE        /RPM/TS_ITEM_D_UI
* | [--->] I_FIELD_NAME                   TYPE        FIELDNAME
* | [--->] I_SPRAS                        TYPE        LAISO
* | [--->] I_FIRST_TIME                   TYPE        WDY_BOOLEAN
* | [<---] E_DESC                         TYPE        STRING
* | [<---] E_ID                           TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD fetch_descriptions.
    DATA: lv_ktext TYPE string,
          lv_id    TYPE string,
          lv_user  TYPE xubname,
          lv_ndjar TYPE ndjar.

    CASE i_field_name.
      WHEN 'ZZAKSTL' .

        IF i_item_att-zzakstl IS NOT INITIAL  OR i_first_time EQ abap_true.
          CALL METHOD zcl_ppm_custom_fld_utility=>fetch_costcentre_desc
            EXPORTING
              i_laiso = i_spras
              i_kostl = i_item_att-zzakstl
            IMPORTING
              e_ltext = DATA(lv_kostt).
          CONCATENATE i_field_name '_TEXT' INTO lv_id.
          lv_ktext = lv_kostt.
        ENDIF.

      WHEN 'ZZFKSTL' .
        IF i_item_att-zzfkstl IS NOT INITIAL OR i_first_time EQ abap_true.
          CLEAR lv_kostt.
          CALL METHOD zcl_ppm_custom_fld_utility=>fetch_costcentre_desc
            EXPORTING
              i_laiso = i_spras
              i_kostl = i_item_att-zzfkstl
            IMPORTING
              e_ltext = lv_kostt.

          CONCATENATE i_field_name '_TEXT' INTO lv_id.
          lv_ktext = lv_kostt.
        ENDIF.
      WHEN 'ZZPROLEAD'.
        IF i_item_att-zzprolead IS NOT INITIAL OR i_first_time EQ abap_true.
          CALL METHOD zcl_ppm_custom_fld_utility=>fetch_name
            EXPORTING
              i_vernr = i_item_att-zzprolead
            IMPORTING
              e_verna = DATA(lv_name).

          CONCATENATE i_field_name '_TEXT' INTO lv_id.
          lv_ktext = lv_name.
        ENDIF.
      WHEN 'ZZCLASS'.
        IF i_item_att-zzclass IS NOT INITIAL OR i_first_time EQ abap_true.
          CALL METHOD zcl_ppm_custom_fld_utility=>fetch_assetclass_des
            EXPORTING
              i_laiso = i_spras
              i_anlkl = i_item_att-zzclass
            IMPORTING
              e_desc  = DATA(lv_classdesc).

          CONCATENATE i_field_name '_TEXT' INTO lv_id.
          lv_ktext = lv_classdesc.
        ENDIF.

      WHEN 'ZZTPLNR'.
        IF i_item_att-zztplnr IS NOT INITIAL OR i_first_time EQ abap_true.
          CALL METHOD zcl_ppm_custom_fld_utility=>fetch_funcloccation_des
            EXPORTING
              i_laiso = i_spras
              i_tplnr = i_item_att-zztplnr
            IMPORTING
              e_desc  = DATA(lv_floc_desc).

          CONCATENATE i_field_name '_TEXT' INTO lv_id.
          lv_ktext = lv_floc_desc.
        ENDIF.
      WHEN 'ZZASTNR'.
        IF i_item_att-zzastnr IS NOT INITIAL OR i_first_time EQ abap_true.
          CALL METHOD zcl_ppm_custom_fld_utility=>fetch_applicant_des
            EXPORTING
              i_laiso = i_spras
              i_astnr = i_item_att-zzastnr
            IMPORTING
              e_desc  = DATA(lv_applic_desc).
          CONCATENATE i_field_name '_TEXT' INTO lv_id.
          lv_ktext = lv_applic_desc.
        ENDIF.
      WHEN 'ZZSPONS' .
        IF i_item_att-zzspons IS NOT INITIAL OR i_first_time EQ abap_true.


          CALL METHOD zcl_ppm_custom_fld_utility=>fetch_spons_des
            EXPORTING
              i_laiso = i_spras
              i_pernr = i_item_att-zzspons
            IMPORTING
              e_desc  = DATA(lv_spons_desc).

          CONCATENATE i_field_name '_TEXT' INTO lv_id.
          lv_ktext = lv_spons_desc.

        ENDIF.
      WHEN 'ZZREQUESTOR'.
        IF i_item_att-zzrequestor IS NOT INITIAL OR i_first_time EQ abap_true.
          CALL METHOD zcl_ppm_custom_fld_utility=>fetch_spons_des
            EXPORTING
              i_laiso = i_spras
              i_pernr = i_item_att-zzrequestor
            IMPORTING
              e_desc  = lv_spons_desc.

          CONCATENATE i_field_name '_TEXT' INTO lv_id.
          lv_ktext = lv_spons_desc.
        ENDIF.

      WHEN 'ZZINITIATOR'.
        IF i_item_att-zzinitiator IS NOT INITIAL OR i_first_time EQ abap_true.
          CALL METHOD zcl_ppm_custom_fld_utility=>fetch_spons_des
            EXPORTING
              i_laiso = i_spras
              i_pernr = i_item_att-zzinitiator
            IMPORTING
              e_desc  = lv_spons_desc.

          CONCATENATE i_field_name '_TEXT' INTO lv_id.
          lv_ktext = lv_spons_desc.
        ENDIF.
      WHEN 'ZZAAROVALWITH'.
        IF i_item_att-zzaarovalwith IS NOT INITIAL OR i_first_time EQ abap_true.
          lv_user = i_item_att-zzaarovalwith.
          IF lv_user IS NOT INITIAL.

            DATA(lv_userinfo) = zcl_ppm_ui_services=>get_user_info( lv_user ).
            CONCATENATE i_field_name '_TEXT' INTO lv_id.
            lv_ktext = lv_userinfo-name.
          ENDIF.
        ENDIF.
      WHEN 'ZZVBUKR'.
        IF i_item_att-zzvbukr IS NOT INITIAL OR i_first_time EQ abap_true.
          DATA(lv_bukrs) = i_item_att-zzvbukr.
          IF lv_bukrs IS NOT INITIAL.
            SELECT SINGLE butxt FROM t001 INTO lv_ktext
                                WHERE bukrs = lv_bukrs.
            CONCATENATE i_field_name '_TEXT' INTO lv_id.
          ENDIF.
        ENDIF.
      WHEN OTHERS.
    ENDCASE.
    e_id = lv_id.
    e_desc = lv_ktext.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_CUSTOM_FLD_UTILITY=>FETCH_FUNCLOCCATION_DES
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_TPLNR                        TYPE        TPLNR
* | [--->] I_LAISO                        TYPE        LAISO
* | [<---] E_DESC                         TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD fetch_funcloccation_des.
    DATA: lv_lang  TYPE laiso,
          lv_ktext TYPE string,
          lv_spras TYPE spras.


    CALL FUNCTION 'LANGUAGE_CODE_ISO_TO_SAP'
      EXPORTING
        iso_code  = i_laiso
      IMPORTING
        sap_code  = lv_spras
      EXCEPTIONS
        not_found = 1
        OTHERS    = 2.
    IF sy-subrc <> 0.
* Implement suitable error handling here
    ENDIF.

*fetch the cost Center Description.
    IF lv_spras IS INITIAL." If master language is initial fill the system language.
      lv_spras = sy-langu.
    ENDIF.

    SELECT SINGLE pltxt FROM iflotx INTO @DATA(lv_pltxt)
      WHERE tplnr = @i_tplnr
      AND   spras = @lv_spras.
    IF sy-subrc IS INITIAL.
      e_desc = lv_pltxt.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_CUSTOM_FLD_UTILITY=>FETCH_ICON
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_VALUE                        TYPE        ZOVERALL_STATUS
* | [<-()] R_ICON                         TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  method FETCH_ICON.
    CASE i_VALUE.
            WHEN '@08@'.
              R_ICON = 'ICON_GREEN_LIGHT'.
            WHEN '@09@'.
              R_ICON = 'ICON_YELLOW_LIGHT'.
            WHEN '@0A@'.
              R_ICON = 'ICON_RED_LIGHT'.
            WHEN OTHERS.
          ENDCASE.
  endmethod.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_CUSTOM_FLD_UTILITY=>FETCH_IMAGE_SRC
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_ITEM_ATT                     TYPE        /RPM/TS_ITEM_D_UI
* | [--->] I_FIELD_NAME                   TYPE        FIELDNAME
* | [<-()] R_SOURCE                       TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD fetch_image_src.

*  case ls_stat_fld-field_name
    CASE i_field_name .
      WHEN 'ZZSTATUS'.
        IF i_item_att-zzstatus IS NOT INITIAL.
          DATA(lv_stat) = i_item_att-zzstatus.
          CALL METHOD zcl_ppm_custom_fld_utility=>fetch_icon
            EXPORTING
              i_value = lv_stat
            RECEIVING
              r_icon  = r_source.
        ENDIF.
      WHEN 'ZZSCHSTA'.
        CLEAR r_source.
        IF i_item_att-zzschsta IS NOT INITIAL.
          CLEAR lv_stat.
          lv_stat = i_item_att-zzschsta.
          CASE i_item_att-zzschsta(1).
            WHEN '3'.
              r_source = 'ICON_GREEN_LIGHT'.
            WHEN '2'.
              r_source = 'ICON_YELLOW_LIGHT'.
            WHEN '1'.
              r_source = 'ICON_RED_LIGHT'.
            WHEN OTHERS.
          ENDCASE.
        ENDIF.
      WHEN 'ZZCSTAT'.
        CLEAR r_source.
        IF i_item_att-zzcstat IS NOT INITIAL.
          CLEAR lv_stat.
          lv_stat = i_item_att-zzcstat.
          CALL METHOD zcl_ppm_custom_fld_utility=>fetch_icon
            EXPORTING
              i_value = lv_stat
            RECEIVING
              r_icon  = r_source.
        ENDIF.
      WHEN OTHERS.
    ENDCASE.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_CUSTOM_FLD_UTILITY=>FETCH_NAME
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_VERNR                        TYPE        PS_VERNR
* | [<---] E_VERNA                        TYPE        PS_VERNA
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD fetch_name.
    DATA: lv_verna TYPE ps_verna.

    SELECT SINGLE verna FROM tcj04
      INTO lv_verna
      WHERE
       vernr = i_vernr.
    IF sy-subrc IS INITIAL.
      e_verna = lv_verna.
    ENDIF.

  ENDMETHOD.


