* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_CUSTOM_FLD_UTILITY=>FETCH_USEFULL_LIFE
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_ANLKL                        TYPE        ANLKL
* | [<---] E_NDJAR                        TYPE        NDJAR
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD fetch_usefull_life.
    DATA: lv_spras TYPE spras,
          lv_ndjar TYPE ankb-ndjar.

    IF lv_spras IS INITIAL.
      lv_spras = sy-langu.
    ENDIF.
    SELECT SINGLE ndjar FROM ankb
      INTO lv_ndjar
      WHERE
          bdatu >= sy-datum
      AND anlkl = i_anlkl.
    IF sy-subrc IS INITIAL.
      e_ndjar = lv_ndjar.
    ENDIF.




  ENDMETHOD.
