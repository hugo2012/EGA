            lv_rpm_msg_txt         TYPE rpm_msg_txt,
            lr_message_handler_ppm TYPE REF TO /rpm/cl_message_handle,
            lt_message             TYPE /rpm/tt_messages,
            ls_message             TYPE /rpm/ts_messages,
            lv_message             TYPE string,

            lv_tplnr               TYPE ztplnr.             "C90007518
* Copy to new Item - Initiate Status
    SELECT COUNT(*) FROM /rpm/decision
    WHERE guid = @cs_attribute_new-guid.
    IF sy-subrc <> 0."Create new - copy to new Item
      IF cs_attribute_new-active = 'X'.
        cs_attribute_new-status = 'ZDS01'."Not initiated
      ENDIF.
    ENDIF.
    CHECK is_attribute_old-status <> is_attribute_new-status.
    lr_message_handler_ppm ?= /rpm/cl_message_handle=>get_instance( ).
    CALL METHOD lr_message_handler_ppm->get_all_messages
      EXPORTING
        iv_sort     = abap_true
      RECEIVING
        et_messages = lt_message.

    SELECT SINGLE * FROM /rpm/item_d INTO @DATA(ls_item)
          WHERE guid = @is_attribute_new-item_guid.

    SELECT SINGLE * FROM /rpm/decision INTO @DATA(ls_decision)
    WHERE guid = @is_attribute_new-guid AND item_guid = @ls_item-guid AND decision_id = @is_attribute_new-decision_id.

    IF is_attribute_new-status = 'ZDS03'."Summited for Approval

      IF ls_item-zzplanst = '04'."Pending
        TRY.
            MESSAGE e053(zppm) INTO lv_message.
            lv_rpm_msg_txt = lv_message.
            MOVE-CORRESPONDING sy TO ls_msg.

            CALL METHOD lr_message_handler_ppm->/rpm/if_message_buffer~add_process_message
              EXPORTING
                in_message_type = 'E'
                in_message_text = lv_rpm_msg_txt.
          CATCH /rpm/cx_api_message_buffer.

        ENDTRY.
      ENDIF.
      IF ls_item-zzplanst = '03' "N/A
        AND ( ls_decision-decision_id = 'ZDP02'
         OR  ls_decision-decision_id = 'ZDP03'
        OR  ls_decision-decision_id = 'ZDP04'
          OR  ls_decision-decision_id = 'ZDP05'
        OR  ls_decision-decision_id = 'ZDP06' ).
        TRY.
            MESSAGE e052(zppm) INTO lv_message.
            MOVE-CORRESPONDING sy TO ls_msg.
            lv_rpm_msg_txt = lv_message.

            CALL METHOD lr_message_handler_ppm->/rpm/if_message_buffer~add_process_message
              EXPORTING
                in_message_type = 'E'
                in_message_text = lv_rpm_msg_txt.
          CATCH /rpm/cx_api_message_buffer.

        ENDTRY.
      ENDIF.
*Begin of changes by C90007518 for CHG0014884 on 02/05/2025
      IF ls_decision-decision_id = 'ZDP03'.

        CALL FUNCTION 'CONVERSION_EXIT_TPLNR_OUTPUT'
          EXPORTING
            input  = ls_item-zztplnr
          IMPORTING
            output = lv_tplnr.

        DATA(lv_fun_location) = strlen( lv_tplnr ).
        IF lv_fun_location LE 12.
          TRY.
              MESSAGE e058(zppm) INTO lv_message.
              MOVE-CORRESPONDING sy TO ls_msg.
              lv_rpm_msg_txt = lv_message.

              CALL METHOD lr_message_handler_ppm->/rpm/if_message_buffer~add_process_message
                EXPORTING
                  in_message_type = 'E'
                  in_message_text = lv_rpm_msg_txt.
            CATCH /rpm/cx_api_message_buffer.

          ENDTRY.
        ENDIF.
      ENDIF.
*End of changes by C90007518 for CHG0014884 on 02/05/2025
    ELSEIF is_attribute_old-status = 'ZDS03'."Summited for Approval
      IF ls_item-zzplanst = '04'."Pending
        MESSAGE e053(zppm) INTO lv_message.
        DELETE lt_message WHERE msg_txt = lv_message.
      ENDIF.
      IF ls_item-zzplanst = '03' "N/A
        AND ( ls_decision-decision_id = 'ZDP02'
         OR  ls_decision-decision_id = 'ZDP03'
        OR  ls_decision-decision_id = 'ZDP04'
          OR  ls_decision-decision_id = 'ZDP05'
        OR  ls_decision-decision_id = 'ZDP06' ).
        MESSAGE e052(zppm) INTO lv_message.
        DELETE lt_message WHERE msg_txt = lv_message.
      ENDIF.
      IF lt_message IS NOT INITIAL.
        LOOP AT lt_message INTO ls_message.
          lv_rpm_msg_txt = ls_message-msg_txt.
          TRY.
              CALL METHOD lr_message_handler_ppm->/rpm/if_message_buffer~add_process_message
                EXPORTING
                  in_message_type = 'E'
                  in_message_text = lv_rpm_msg_txt.
            CATCH /rpm/cx_api_message_buffer.

          ENDTRY.
        ENDLOOP.
      ELSE.
        lr_message_handler_ppm->/rpm/if_message_buffer~delete_all_object_messages( ).
      ENDIF.
    ENDIF.
  ENDMETHOD.


