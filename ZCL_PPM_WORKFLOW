* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_WORKFLOW=>SET_APP_REJ_STATUS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_LEVEL                       TYPE        INT4
* | [--->] IV_DECISION                    TYPE        SYST-INPUT
* | [--->] IV_USER                        TYPE        SWP_AGENT(optional)
* | [--->] IV_DECISION_GUID               TYPE        RPM_TV_GUID
* | [<-->] ET_APP_STAT                    TYPE        ZPPM_WF_APP_STAT_TT
* | [<-->] ET_APP_STAT_HTML               TYPE        ZTT_SOLISTI1
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD set_app_rej_status.
* based on user decision workflow internal values are updated
* to approved or rejected
   DATA: lv_seqno     TYPE seqno,
        lv_user      TYPE xubname,
        lt_app_stat  TYPE STANDARD TABLE OF zppm044,
        lv_retry     TYPE i VALUE 0,
        lv_locked    TYPE abap_bool VALUE abap_false.

  " 1. Format inputs
  lv_seqno = iv_level.
  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING
      input  = lv_seqno
    IMPORTING
      output = lv_seqno.

  IF iv_user IS NOT INITIAL .
   lv_user = iv_user+2(12).
  ENDIF.

  " 2. Lock Retry Mechanism (Try 3 times with 1 second delay between attempts)
  DO 3 TIMES.
    CALL FUNCTION 'ENQUEUE_EZPPM044'
      EXPORTING
        mode_zppm044     = 'E'
        iv_decision_guid = iv_decision_guid
        " seqno            = lv_seqno            " <-- Pass new lock key field
        _scope           = '2'
      EXCEPTIONS
        foreign_lock     = 1
        system_failure   = 2
        OTHERS           = 3.

    IF sy-subrc = 0.
      lv_locked = abap_true.
      EXIT. " Lock acquired successfully, exit retry loop
    ENDIF.

    " Wait 1 second before the next attempt
    WAIT UP TO 1 SECONDS.
  ENDDO.

  " Exit method if lock could not be acquired after 3 retries
  IF lv_locked = abap_false.
    " Optional: Raise exception or log message for workflow monitoring
    RETURN.
  ENDIF.

  " 3. Read freshest data directly from Database Table ZPPM044
  SELECT * FROM zppm044
    INTO TABLE @lt_app_stat
    WHERE iv_decision_guid = @iv_decision_guid.

  " 4. IF table is empty for first execution, populate from buffer (ET_APP_STAT)
  IF sy-subrc <> 0 OR lt_app_stat IS INITIAL.
    IF et_app_stat IS NOT INITIAL.
      " Copy buffer entries into database format table
      lt_app_stat = CORRESPONDING #( et_app_stat ).

      " Set mandatory key fields for all initial buffer records
      LOOP AT lt_app_stat ASSIGNING FIELD-SYMBOL(<ls_init>).
        <ls_init>-iv_decision_guid = iv_decision_guid.
        IF <ls_init>-status IS INITIAL.
          <ls_init>-status = gc_pending. " Default initial status constant
           CLEAR <ls_init>-ap_datetim .
           CLEAR <ls_init>-ap_time.
        ENDIF.
      ENDLOOP.

      " Insert initial records into ZPPM044 database table
      INSERT zppm044 FROM TABLE @lt_app_stat.
    ENDIF.
   ELSE.
     IF lv_seqno = 1.
       "Reset status
       LOOP AT lt_app_stat ASSIGNING <ls_init>.
        IF <ls_init>-status IS NOT INITIAL.
          <ls_init>-status = gc_pending. " Default initial status constant
           <ls_init>-app_by     = ''.
           CLEAR <ls_init>-ap_datetim .
           CLEAR <ls_init>-ap_time.
        ENDIF.
      ENDLOOP.
    ENDIF .
  ENDIF.


  " 5. Update approval status entry for current level (SEQNO)
  LOOP AT lt_app_stat ASSIGNING FIELD-SYMBOL(<ls_app>) WHERE seqno = lv_seqno.

    IF lv_user IS NOT INITIAL.
      DATA(ls_user_info) = zcl_ppm_common=>get_user_info( ov_user = lv_user ).
      <ls_app>-app_by     = ls_user_info-name.
      <ls_app>-ap_datetim = sy-datum.
      <ls_app>-ap_time    = sy-uzeit.
    ENDIF.

    IF iv_decision EQ gc_r.
      <ls_app>-status = gc_rejected.
    ELSEIF iv_decision EQ gc_a.
      <ls_app>-status = gc_approved.
    ENDIF.

  ENDLOOP.

  " 6. Save updated data back to ZPPM044 table
  IF sy-subrc = 0 AND lt_app_stat IS NOT INITIAL.
    MODIFY zppm044 FROM TABLE lt_app_stat.
    COMMIT WORK AND WAIT.
  ENDIF.

  " 7. Release Lock
  CALL FUNCTION 'DEQUEUE_EZPPM044'
    EXPORTING
      mode_zppm044     = 'E'
      iv_decision_guid = iv_decision_guid.
     " seqno            = lv_seqno            " <-- Pass new lock key field.

  " 8. Pass back updated table to workflow container output
  et_app_stat = CORRESPONDING zppm_wf_app_stat_tt( lt_app_stat ).

* BEGIN OF Log issue 218.
  IF et_app_stat IS NOT INITIAL.
    CLEAR et_app_stat_html[].
    CALL FUNCTION 'ZWF_APP_STA_HTML'
      TABLES
        it_app_stat            = et_app_stat
        et_app_stat_html       = et_app_stat_html
              .
  ENDIF.
* END OF Log issue 218.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_WORKFLOW=>VALIDATE_PARALLEL_PROCESS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_DECISION_GUID               TYPE        RPM_TV_GUID
* | [--->] IV_DECISION_ID                 TYPE        RPM_TV_EXTID
* | [--->] IT_AGENTS_ALL                  TYPE        ZPPM_WF_APP_TT
* | [<---] EV_PARALLEL                    TYPE        BOOLE_D
* | [<---] ET_AGENTS_AREA                 TYPE        ZPPM_WF_APP_TT
* | [<---] ET_AGENTS_MANAGING             TYPE        ZPPM_WF_APP_TT
* | [<---] ET_AGENTS_FIN                  TYPE        ZPPM_WF_APP_TT
* | [<---] ET_AGENTS_CEO_CHAIN            TYPE        ZPPM_WF_APP_TT
* | [<---] ET_AGENTS_LEVEL1               TYPE        ZPPM_WF_APP_TT
* | [<---] EV_AGENTS_AREA_EXIST           TYPE        BOOLE_D
* | [<---] EV_AGENTS_MANAGING_EXIST       TYPE        BOOLE_D
* | [<---] EV_AGENTS_FIN_EXIST            TYPE        BOOLE_D
* | [<---] EV_AGENTS_CEO_EXIST            TYPE        BOOLE_D
* | [<---] EV_TOTAL_FIN_APPR              TYPE        INT4
