* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_WORKFLOW=>GET_CATEGORY_WFTYPE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_BUCKET_ID_CHILD             TYPE        /RPM/TV_EXTID
* | [--->] IV_DECISION_GUID               TYPE        RPM_TV_GUID
* | [<---] EV_ZCATEGORY                   TYPE        ZDE_CATEGORY
* | [<---] ET_MSG                         TYPE        /RPM/TT_MESSAGES
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_category_wftype.
***********************************************************************
*  M O D I F I C A T I O N    L O G                                   *
***********************************************************************
*    Date   | TR Number  | Developement/  |       Description         *
*           |            | Modification   |                           *
***********************************************************************
*29.01.2026  DSDK9A07KC   #CHG0029188   Log Issue E457
*                                           Update new Logic to
*                                          DoA list for approval
*                                          to get Category
*
*---------------------------------------------------------------------
    DATA:
    lv_zbucket_parent   TYPE  /rpm/tv_extid,
    lv_zzcomcat         TYPE  zcomponentisation_category,
    lv_phase_id         TYPE  rpm_tv_extid,
    lv_zcep_value       TYPE  /rpm/tv_curr_amount,
    lv_zplaned          TYPE  zplan_status,
    lv_zcategory        TYPE  zde_category,
    lv_study_cost       TYPE /rpm/tv_curr_amount.

    "Bucket Parent ID
      SELECT SINGLE * FROM /rpm/decision INTO @DATA(ls_attributes_new)
                            WHERE guid = @iv_decision_guid.
      CHECK sy-subrc IS INITIAL.
      "Call method to get Bucket Parent ID.

       CALL METHOD zcl_ppm_workflow=>get_parent_bucket_by_extid
         EXPORTING
           bucket_extid_child =     iv_bucket_id_child
         IMPORTING
           bucket_guid_parent =     DATA(lv_bucket_guid_parent)" Guid for application objects
           bucket_id_parent   =     DATA(lv_bucket_id_parent)" Business Object ID
           bucket_name_parent =     DATA(lv_bucket_name_parent)" Name
         .
      lv_zbucket_parent = COND #( WHEN lv_bucket_id_parent IS NOT INITIAL THEN  lv_bucket_id_parent   ELSE '' ).

      " C&CT Sub Category && Plan Status
      SELECT SINGLE * FROM /rpm/item_d INTO @DATA(ls_item)
                              WHERE guid = @ls_attributes_new-item_guid.
      IF sy-subrc IS INITIAL.
        "" C&CT Sub Category
        lv_zzcomcat = COND #( WHEN ls_item-zzcomcat IS NOT INITIAL THEN  ls_item-zzcomcat  ELSE '' ).
        "" Plan Status
        lv_zplaned = COND #( WHEN ls_item-zzplanst IS NOT INITIAL THEN  ls_item-zzplanst   ELSE '' ).
      ENDIF.
      "Phase ID/Decision ID
      lv_phase_id = COND #( WHEN ls_attributes_new-decision_id IS NOT INITIAL THEN  ls_attributes_new-decision_id  ELSE '' ).
****** Get TEC Amount/ CEP Value(TEC AMT) ----------------------------------------------
      CALL METHOD zcl_ppm_common=>get_approval_amt
        EXPORTING
          iv_guid   =     ls_attributes_new-guid
        IMPORTING
          ev_amount =     lv_zcep_value  .

***** Calculate Study cost.-------------------------------------------------------------
      lv_study_cost = 0.
      CALL FUNCTION 'ZPPM_FM_WF_STUDIES_COST_CALC'
        EXPORTING
          iv_item_guid         = ls_attributes_new-item_guid
          iv_decision_id       = ls_attributes_new-decision_id
       IMPORTING
