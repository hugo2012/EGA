* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_WORKFLOW=>CREATE_USER_EMAIL_LIST
* +-------------------------------------------------------------------------------------------------+
* | [--->] IT_ACL                         TYPE        /RPM/TT_ACO_PERMISSIONS
* | [--->] IV_OBJECT_TYPE                 TYPE        /RPM/OBJECT_TYPE
* | [--->] IV_WORKFLOW_ID                 TYPE        /RPM/TV_WF_ID(optional)
* | [<---] ET_USER_TAB                    TYPE        TSWHACTOR
* | [<---] ET_EMAIL_TAB                   TYPE        /RPM/TT_WF_ACTORS
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD create_user_email_list.

  DATA: lt_wf_recipient TYPE /rpm/tt_wf_recip,
        ls_wf_recipient TYPE /rpm/wf_recip,
        ls_acl          TYPE /rpm/ts_aco_permission,
        ls_actor        TYPE swhactor,
        lv_email        TYPE so_name.

* Read recipient configuration from /RPM/WF_RECIP
  SELECT * INTO CORRESPONDING FIELDS OF TABLE lt_wf_recipient
      FROM /rpm/wf_recip
      WHERE object_type EQ iv_object_type
      AND   wf_id EQ iv_workflow_id.

  LOOP AT it_acl INTO ls_acl.

    READ TABLE lt_wf_recipient INTO ls_wf_recipient WITH KEY activity_type = ls_acl-activity.

    IF sy-subrc EQ 0.
*     Get Users
      ls_actor-objid = ls_acl-user.
      ls_actor-otype = 'US'.
      APPEND ls_actor TO et_user_tab.
      CLEAR ls_actor.

*     Get email IDs
      lv_email = ls_acl-email.
      APPEND lv_email TO et_email_tab.
      CLEAR lv_email.
    ENDIF.

  ENDLOOP.

  SORT et_user_tab.
  DELETE ADJACENT DUPLICATES FROM et_user_tab.

  SORT et_email_tab.
  DELETE ADJACENT DUPLICATES FROM et_email_tab.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_WORKFLOW=>GET_APPR_LEVEL_1
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_DECISION_GUID               TYPE        RPM_TV_GUID
* | [--->] IT_PPM030                      TYPE        ZPPM_TT_WF_030
* | [<---] ET_AGENTS_LEVEL_1              TYPE        ZPPM_TT_WF_AGENT
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_appr_level_1.
***********************************************************************
*  M O D I F I C A T I O N    L O G                                   *
***********************************************************************
*    Date   | TR Number  | Developement/  |       Description         *
*           |            | Modification   |                           *
***********************************************************************
*02.10.2026  DSDK9A0FBW  CRQ#CHG0029188   Log Issue E454
*                                          The logic is used for
*                                          getting the Level  1 approver
*
*
*---------------------------------------------------------------------
    CLEAR et_agents_level_1.
    IF it_ppm030 IS NOT INITIAL.
      et_agents_level_1 = VALUE #(
            FOR ls_lv11 IN it_ppm030
            WHERE ( seqno = 1 )
            (
              otype = ls_lv11-otype
              agentid    = ls_lv11-appr
              seqno = ls_lv11-seqno  parvw = ls_lv11-parvw )
          ).

    ELSE.
      " 1. Select Level 1 approvers (P3 / Sequence 1) from ZPPM030
      SELECT otype AS otype,
             appr AS agent_id,
             seqno AS seq_no,
             parvw
        FROM zppm030
        WHERE guid   = @iv_decision_guid
          AND seqno = 1                  " Sequence 1 = Level 1 (P3)
        ORDER BY seq_no ASCENDING
        INTO TABLE @DATA(lt_l1_approvers).
         " 2. Populate target table with combined AGENTID and ZZDE_SEQNO
          IF sy-subrc = 0.
            et_agents_level_1 = VALUE #(
              FOR ls_lv1 IN lt_l1_approvers
              (
                otype = ls_lv1-otype
                agentid    = ls_lv1-agent_id
                seqno = ls_lv1-seq_no  parvw = ls_lv1-parvw )
            ).
          ENDIF.
    ENDIF.

  ENDMETHOD. "#EC CI_VALPAR


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_WORKFLOW=>GET_APPR_ROUTE_AREA
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_DECISION_GUID               TYPE        RPM_TV_GUID
* | [--->] IT_PPM030                      TYPE        ZPPM_TT_WF_030
* | [<---] ET_AGENTS_AREA                 TYPE        ZPPM_TT_WF_AGENT
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_appr_route_area.

***********************************************************************
*  M O D I F I C A T I O N    L O G                                   *
***********************************************************************
*    Date   | TR Number  | Developement/  |       Description         *
*           |            | Modification   |                           *
***********************************************************************
*02.10.2026  DSDK9A0FBW  CRQ#CHG0029188   Log Issue E454
*                                          The logic is used for
*                                          getting approver role routing Area
*
*
*---------------------------------------------------------------------
    CLEAR et_agents_area.
    IF it_ppm030 IS NOT INITIAL.
      " 1. Select matching PARVW routes from ZPPM043
      SELECT parvw
        FROM zppm043
        WHERE route = @zcl_ppm_workflow=>gc_area_route_appr
        INTO TABLE @DATA(lt_zppm043).

      IF sy-subrc = 0 AND lt_zppm043 IS NOT INITIAL.
        " 2. Filter IT_PPM030 using a LOOP with READ TABLE to check existence
        LOOP AT it_ppm030 ASSIGNING FIELD-SYMBOL(<fs_030>) WHERE guid = iv_decision_guid.
          READ TABLE lt_zppm043 WITH KEY parvw = <fs_030>-parvw TRANSPORTING NO FIELDS.
          IF sy-subrc = 0.
            APPEND VALUE #(
              otype     = <fs_030>-otype
              agentid    =  <fs_030>-appr
              seqno = <fs_030>-seqno
              parvw = <fs_030>-parvw
            ) TO et_agents_area.
          ENDIF.
        ENDLOOP.
      ENDIF.

    ELSE.
      SELECT a~otype, a~appr AS agent_id,a~seqno
        FROM zppm030 AS a
        INNER JOIN zppm043 AS b
          ON a~parvw = b~parvw
        WHERE a~guid  = @iv_decision_guid
          AND b~route =  @zcl_ppm_workflow=>gc_area_route_appr" Route 01 = Area
        ORDER BY a~seqno ASCENDING     " Preserves sequence 1 -> 2 -> 3
        INTO TABLE @DATA(lt_area_approvers).
        IF sy-subrc IS INITIAL.
          et_agents_area = VALUE #(
            FOR ls_area IN lt_area_approvers (
              otype     = ls_area-otype
              agentid    = ls_area-agent_id
              seqno = ls_area-seqno
              parvw = <fs_030>-parvw
            )
          ).
        ENDIF.

     ENDIF.

  ENDMETHOD. "#EC CI_VALPAR


