* | Static Public Method ZCL_PPM_WORKFLOW=>GET_PORTAL_LINK
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_ITEM_ATTRIBUTES             TYPE        RPM_TS_PROJECT_INT(optional)
* | [--->] IV_ITEM_NAME                   TYPE        RPM_TV_SHARED_DESCRIPTION(optional)
* | [--->] IS_PORTFOLIO_ATTRIBUTES        TYPE        /RPM/TS_PORTFOLIO_INT(optional)
* | [--->] IV_PORTFOLIO_NAME              TYPE        /RPM/TV_SHARED_DESCRIPTION(optional)
* | [--->] IV_DP_FLAG                     TYPE        XFELD(optional)
* | [<---] EV_LINK                        TYPE        /RPM/PORTAL_LINK
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD GET_PORTAL_LINK.

  DATA: lv_logsys TYPE logsys,
        lt_ws_param TYPE olr3_tt_webserver_url_par,
        ls_ws_param_url TYPE olr3_url_srv_par,
        ls_ws_param_pcd TYPE olr3_url_srv_par,
        lv_link TYPE /rpm/portal_link,
        lv_str TYPE string.
* Read the logical system for the current client
  SELECT SINGLE logsys INTO lv_logsys FROM t000 WHERE mandt = sy-mandt.

* Read the webserver parameters corresponding to this logical system
  SELECT * FROM olr3_url_srv_par INTO TABLE lt_ws_param WHERE web_server = lv_logsys.

* Read the parameter 'PORTALLINK'
  READ TABLE lt_ws_param INTO ls_ws_param_url WITH KEY name = 'PORTALLINK'.
  TRANSLATE ls_ws_param_url-value TO LOWER CASE.         "#EC TRANSLANG

* Read the parameter 'PORTALPCDLOCATION'
  READ TABLE lt_ws_param INTO ls_ws_param_pcd WITH KEY name = 'PORTALPCDLOCATION'.
  TRANSLATE ls_ws_param_pcd-value TO LOWER CASE.         "#EC TRANSLANG

* Store portal opening page URL in local variable
  lv_link = ls_ws_param_url-value.
  CONDENSE lv_link.

*  IF is_item_attributes IS SUPPLIED.
*
**   Compose the URL
*
*    CONCATENATE  lv_link '?' 'NavigationTarget=ROLES://' ls_ws_param_pcd-value
*    '/com.sap.pct.cprxrpm.port_mgmt/com.sap.pct.cprxrpm.port_mgmt_ep/com.sap.pct.cprxrpm.port_mgmt&DynamicParameter=PortfolioGUID%3D'
*    INTO lv_link.
*
*    lv_str = is_item_attributes-rpm_project-portfolio_guid.
*
*    CONCATENATE lv_link lv_str '%26PortfolioName%3D' iv_portfolio_name '%26ObjectGUID%3D' INTO lv_link.
*
*    lv_str = is_item_attributes-rpm_project-portfl_item_guid.
*
*    CONCATENATE lv_link lv_str '%26ObjectName%3D' iv_item_name '%26ObjectType%3DRIH%26LinkID%3D0122' INTO lv_link.
*
*  ENDIF.

* Export the link
  ev_link = lv_link.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_WORKFLOW=>GET_WF_RECIPIENT_LIST
* +-------------------------------------------------------------------------------------------------+
* | [--->] OBJECT_TYPE                    TYPE        /RPM/OBJECT_TYPE
* | [--->] PORTFOLIO_GUID                 TYPE        /RPM/TV_GUID
* | [--->] PORTFL_ITEM_GUID               TYPE        /RPM/TV_GUID
* | [--->] WORKFLOW_ID                    TYPE        /RPM/TV_WF_ID
* | [<-->] ACTOR_TAB                      TYPE        TSWHACTOR
* | [<-->] RECIPIENTS                     TYPE        /RPM/TT_WF_ACTORS
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD GET_WF_RECIPIENT_LIST.

  DATA: ls_context      TYPE  /rpm/ts_object_hier,
        lt_acl          TYPE /rpm/tt_aco_permissions,
        lt_acl_derived  TYPE /rpm/tt_aco_permissions,
        lt_msg          TYPE /rpm/tt_messages,
        lt_msg_derived  TYPE rpm_tt_messages,
        lv_rc           TYPE i,
        lv_rc_derived   TYPE i,
        ls_guid         TYPE /rpm/ts_guid.
* Fill in the context variable to retrieve the ACL
  ls_context-object_guid    = portfl_item_guid.
  ls_context-portfolio_guid = portfolio_guid.

  SELECT SINGLE guid FROM inm_initiative INTO CORRESPONDING FIELDS OF ls_guid WHERE guid = portfl_item_guid.
  IF sy-subrc IS INITIAL.
    ls_context-object_type    = /rpm/cl_co=>sc_acotype_initiative.
  ELSE.
    ls_context-object_type    = /rpm/cl_co=>sc_acotype_item.
  ENDIF.

* Retrieve the Item ACL
  CALL FUNCTION '/RPM/ACL_DISPLAY'
    EXPORTING
      is_context = ls_context
    IMPORTING
      et_acl     = lt_acl
      et_msg     = lt_msg
      ev_rc      = lv_rc.

* Retrieve Inherited ACL
  CALL FUNCTION '/RPM/GET_DERIVED_AUTHORIZATION'
    EXPORTING
      iv_guid        = portfl_item_guid
      iv_object_type = ls_context-object_type
    IMPORTING
      et_acl         = lt_acl_derived
      ev_rc          = lv_rc_derived
      et_msg         = lt_msg_derived.

* Append to Inherited ACL
  APPEND LINES OF lt_acl_derived TO lt_acl.

* Create list of recipient users and their emails
  CALL METHOD /rpm/cl_workflow=>create_user_email_list
    EXPORTING
      it_acl         = lt_acl
      iv_object_type = object_type
      iv_workflow_id = workflow_id
    IMPORTING
      et_user_tab    = actor_tab
      et_email_tab   = recipients.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_WORKFLOW=>GET_WORKFLOW_TYPE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IT_DECISION_NEW                TYPE        RPM_TT_DECISION_INT(optional)
* | [--->] IT_DECISION_OLD                TYPE        RPM_TT_DECISION_INT(optional)
* | [--->] IS_DECISION_OLD                TYPE        RPM_TS_DECISION_INT(optional)
* | [--->] IS_DECISION_NEW                TYPE        RPM_TS_DECISION_INT(optional)
* | [<---] EV_ZCATEGORY                   TYPE        ZDE_CATEGORY
* | [<---] ET_MSG                         TYPE        /RPM/TT_MESSAGES
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_workflow_type.

***********************************************************************
*  M O D I F I C A T I O N    L O G                                   *
***********************************************************************
*    Date   | TR Number  | Developement/  |       Description         *
*           |            | Modification   |                           *
***********************************************************************
*29.01.2026  DSDK9A07KC   CRQ#CHG0029188   Log Issue E457
*                                          The logic is used for Determination
*                                          and return Category.
*
*
*---------------------------------------------------------------------

    DATA:
    lv_zbucket_parent   TYPE  /rpm/tv_extid,
    lv_zzcomcat         TYPE  zcomponentisation_category,
    lv_phase_id         TYPE  rpm_tv_extid,
    lv_zcep_value       TYPE  /rpm/tv_curr_amount,
    lv_zplaned          TYPE  zplan_status,
    lv_zcategory        TYPE  zde_category,
    lv_study_cost       TYPE /rpm/tv_curr_amount.

    "Bucket Parent ID
      IF it_decision_new IS NOT INITIAL AND it_decision_old IS NOT INITIAL.
       DATA(ls_attributes_new) = it_decision_new[ status = 'ZDS03' ].

       DATA(ls_attributes_old) = it_decision_old[ decision_id = ls_attributes_new-decision_id ].
     ELSE.
       ls_attributes_new = is_decision_new.
       ls_attributes_old = is_decision_old.
      ENDIF.

       CHECK ls_attributes_new IS NOT INITIAL.

       CALL METHOD cl_rpm_decision=>get_data_attr_chg_wf
            EXPORTING
              is_attributes_old       = ls_attributes_old
              is_attributes_new       = ls_attributes_new
            IMPORTING
              es_portfolio_attributes =  DATA(ls_portfolio_attributes)
              es_bucket_attributes    =  DATA(ls_bucket_attributes)
              es_item_attributes      =  DATA(ls_item_attributes)
              ev_portfolio_name       =  DATA(lv_portfolio_name)
              ev_bucket_name          =  DATA(lv_bucket_name)
              ev_item_name            =  DATA(lv_item_name)
              es_init_attributes      =  DATA(ls_init_attributes).

      "Call method to get Bucket Parent ID.

       CALL METHOD zcl_ppm_workflow=>get_parent_bucket_by_extid
         EXPORTING
           bucket_extid_child =     ls_bucket_attributes-external_id
         IMPORTING
           bucket_guid_parent =     DATA(lv_bucket_guid_parent)" Guid for application objects
           bucket_id_parent   =     DATA(lv_bucket_id_parent)" Business Object ID
           bucket_name_parent =     DATA(lv_bucket_name_parent)" Name
         .
      lv_zbucket_parent = COND #( WHEN lv_bucket_id_parent IS NOT INITIAL THEN  lv_bucket_id_parent   ELSE '' ).

      " C&CT Sub Category && Plan Status
      SELECT SINGLE * FROM /rpm/item_d INTO @DATA(ls_item)
                              WHERE guid = @ls_attributes_new-item_guid.
      IF sy-subrc IS INITIAL.
        "" C&CT Sub Category
        lv_zzcomcat = COND #( WHEN ls_item-zzcomcat IS NOT INITIAL THEN  ls_item-zzcomcat  ELSE '' ).
        "" Plan Status
        lv_zplaned = COND #( WHEN ls_item-zzplanst IS NOT INITIAL THEN  ls_item-zzplanst   ELSE '' ).
      ENDIF.
      "Phase ID/Decision ID
      lv_phase_id = COND #( WHEN ls_attributes_new-decision_id IS NOT INITIAL THEN  ls_attributes_new-decision_id  ELSE '' ).
****** Get TEC Amount/ CEP Value(TEC AMT) ----------------------------------------------
      CALL METHOD zcl_ppm_common=>get_approval_amt
        EXPORTING
          iv_guid   =     ls_attributes_new-guid
        IMPORTING
          ev_amount =     lv_zcep_value  .

***** Calculate Study cost.-------------------------------------------------------------
      lv_study_cost = 0.
      CALL FUNCTION 'ZPPM_FM_WF_STUDIES_COST_CALC'
        EXPORTING
          iv_item_guid         = ls_attributes_new-item_guid
          iv_decision_id       = ls_attributes_new-decision_id
       IMPORTING
         ev_study_cost        = lv_study_cost
                .

****************************************************************************************

    CALL FUNCTION 'ZPPM_FM_WF_DETERMINE_CATGORY'
      EXPORTING
        iv_zbucket_parent       = lv_zbucket_parent
        iv_zzcomcat             = lv_zzcomcat
