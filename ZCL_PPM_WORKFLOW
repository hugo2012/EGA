* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_WORKFLOW=>GET_CEO_END_CHAIN
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_DECISION_GUID               TYPE        RPM_TV_GUID
* | [--->] IT_PPM030                      TYPE        ZPPM_TT_WF_030
* | [<---] ET_AGENTS_CEO_CHAIN            TYPE        ZPPM_TT_WF_AGENT
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_ceo_end_chain.

***********************************************************************
*  M O D I F I C A T I O N    L O G                                   *
***********************************************************************
*    Date   | TR Number  | Developement/  |       Description         *
*           |            | Modification   |                           *
***********************************************************************
*02.10.2026  DSDK9A0FBW  CRQ#CHG0029188   Log Issue E454
*                                          The logic is used for
*                                          getting Final chain approver
*
*
*---------------------------------------------------------------------

  DATA: lt_all_approvers TYPE zppm_tt_wf_030.

   CLEAR et_agents_ceo_chain.

  " 1. Select all entries for the GUID ordered by sequence number ascending
  IF it_ppm030 IS NOT INITIAL.
    lt_all_approvers = CORRESPONDING #( it_ppm030 ).
  ELSE.
    SELECT otype ,"     AS otype,
           appr, "AS agent_id,
           seqno, "  AS seq_no,
           parvw  "  AS funct
      FROM zppm030
      WHERE guid = @iv_decision_guid
      ORDER BY seqno ASCENDING
      INTO CORRESPONDING FIELDS OF TABLE @lt_all_approvers.
    IF sy-subrc <> 0 OR lt_all_approvers IS INITIAL.
      RETURN.
    ENDIF.
  ENDIF.


  " 2. Find the index position where FUNCT = 'YE' (CEO)
  READ TABLE lt_all_approvers WITH KEY parvw  = 'YE' TRANSPORTING NO FIELDS.
  IF sy-subrc = 0.
    DATA(lv_start_idx) = sy-tabix.
    " Extract from 'YE' to the end of the list
    et_agents_ceo_chain = VALUE #(
      FOR i = lv_start_idx THEN i + 1 WHILE i <= lines( lt_all_approvers )
      (
        otype = lt_all_approvers[ i ]-otype
        agentid    =  lt_all_approvers[ i ]-appr
        seqno = lt_all_approvers[ i ]-seqno
        parvw = lt_all_approvers[ i ]-parvw )
    ).

  ENDIF.
  ENDMETHOD. "#EC CI_VALPAR


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_WORKFLOW=>GET_PARENT_BUCKET
