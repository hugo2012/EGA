* | [<---] EV_TOTAL_AREA_APPR             TYPE        INT4
* | [<---] EV_TOTAL_FINAL_APPR            TYPE        INT4
* | [<---] ET_WF_ACTOR_N3FIN              TYPE        BAPI_ECMVAL_WF_ADDRESS_TAB
* | [<---] EV_WF_ACTOR_N3FIN              TYPE        BOOLE_D
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD validate_parallel_process.

***********************************************************************
*  M O D I F I C A T I O N    L O G                                   *
***********************************************************************
*    Date   | TR Number  | Developement/  |       Description         *
*           |            | Modification   |                           *
***********************************************************************
*02.10.2026  DSDK9A0FBW  CRQ#CHG0029188   Log Issue E454
*                                          The logic is used for
*                                          Identify the logic for parallel route
*                                          Or Sequential route
*
*---------------------------------------------------------------------
    DATA: ls_user_data  TYPE bapiaddr3,
          lv_username TYPE bapibname-bapibname.
    DATA  lt_return   TYPE bapirettab.
    DATA  lw_address  TYPE bapi_ecmval_wf_address.

    " Default to Sequential Process (abap_false)
    ev_parallel = abap_false.

    " Data declarations for route tables
    DATA: lt_area_agents TYPE zppm_tt_wf_agent,
          lt_mt_agents   TYPE zppm_tt_wf_agent,
          lt_fin_agents  TYPE zppm_tt_wf_agent,
          lt_final_chain TYPE zppm_tt_wf_agent,
          lt_first_agent TYPE zppm_tt_wf_agent,
          lt_all_approvers  TYPE zppm_tt_wf_030.

    IF iv_decision_id = 'ZDP00' OR iv_decision_id = 'ZDP04' OR iv_decision_id = 'ZDP05'
      OR iv_decision_id = 'ZDP06'.
       ev_parallel = abap_false.
      RETURN.
    ELSEIF iv_decision_id = 'ZDP01' OR iv_decision_id = 'ZDP02' OR iv_decision_id = 'ZDP03'.
*      ZDP01, ZDP02, ZDP03
      SORT it_agents_all ASCENDING BY seqno.


      " ------------------------------------------------------------------
      " Get All the approvers
      " ------------------------------------------------------------------
        SELECT guid,
          seqno,
          otype,
          appr,
          apprname,
          appamt,
          status,
          approle,
          single_multi,
          parvw,
          optional,
          optemail_user
        FROM zppm030 AS a
        "INNER JOIN zppm043 AS b
        "  ON a~parvw = b~parvw
        WHERE a~guid  = @iv_decision_guid
          "AND b~route =  @zcl_ppm_workflow=>gc_area_route_appr" Route 01 = Area
        ORDER BY a~seqno ASCENDING     " Preserves sequence 1 -> 2 -> 3
        INTO  CORRESPONDING FIELDS OF TABLE @lt_all_approvers.

       IF sy-subrc IS NOT INITIAL .
         RETURN.
       ENDIF.

        DATA(ls_last) = lt_all_approvers[ lines( lt_all_approvers ) ].

      " ------------------------------------------------------------------
      " 1. GET LEVEL 1 APPROVER (P3 - Portfolio Office / Sequence 1)
      " ------------------------------------------------------------------
      zcl_ppm_workflow=>get_appr_level_1(
        EXPORTING iv_decision_guid = iv_decision_guid
                  it_ppm030        = lt_all_approvers
        IMPORTING et_agents_level_1    = lt_first_agent
      ).

      et_agents_level1 = VALUE #(
              FOR ls_level1 IN lt_first_agent (

                seqno = ls_level1-seqno
                actor = VALUE #( ( otype     = ls_level1-otype
                                  objid    =  ls_level1-agentid ) )
              )
              ).

      IF  et_agents_level1 IS NOT INITIAL.
        LOOP AT et_agents_level1 ASSIGNING FIELD-SYMBOL(<fs_agent_lv1>).
            DATA(ls_agent_all) = VALUE #( it_agents_all[ seqno = <fs_agent_lv1>-seqno ] OPTIONAL ).
            MOVE-CORRESPONDING ls_agent_all TO <fs_agent_lv1>.
        ENDLOOP.
      ENDIF.

      " ------------------------------------------------------------------
      " 2. GET PARALLEL ROUTES (Area, Managing Team, Finance)
      " ------------------------------------------------------------------
      CALL METHOD zcl_ppm_workflow=>get_appr_route_area
       EXPORTING
         iv_decision_guid = iv_decision_guid
         it_ppm030        = lt_all_approvers
       IMPORTING
         et_agents_area   = lt_area_agents
       .

      et_agents_area = VALUE #(
              FOR ls_area  IN lt_area_agents (
                seqno = ls_area-seqno
                actor = VALUE #( ( otype     = ls_area-otype
                                  objid    =  ls_area-agentid ) )
              )
              ).
      IF  et_agents_area IS NOT INITIAL.
        LOOP AT et_agents_area ASSIGNING FIELD-SYMBOL(<fs_agent_area>).
            IF <fs_agent_area>-seqno <> ls_last-seqno.
               ls_agent_all = VALUE #( it_agents_all[ seqno = <fs_agent_area>-seqno ] OPTIONAL ).
              MOVE-CORRESPONDING ls_agent_all TO <fs_agent_area>.
            ELSE.
              DELETE et_agents_area WHERE seqno = ls_last-seqno.
            ENDIF.
        ENDLOOP.
      ENDIF.
      ev_agents_area_exist = COND #( WHEN et_agents_area IS NOT INITIAL THEN abap_true ELSE abap_false ).

      CALL METHOD zcl_ppm_workflow=>get_appr_route_mngr
       EXPORTING
         iv_decision_guid = iv_decision_guid
         it_ppm030        = lt_all_approvers
       IMPORTING
         et_agents_mngr   = lt_mt_agents
       .

      et_agents_managing = VALUE #(
         FOR ls_managing  IN lt_mt_agents (
            seqno = ls_managing-seqno
                actor = VALUE #( ( otype     = ls_managing-otype
                                  objid    =  ls_managing-agentid ) )
              )
         ).
      IF et_agents_managing IS NOT INITIAL.
        LOOP AT et_agents_managing ASSIGNING FIELD-SYMBOL(<fs_agent_mt>).
           IF <fs_agent_mt>-seqno <> ls_last-seqno.
            ls_agent_all = VALUE #( it_agents_all[ seqno = <fs_agent_mt>-seqno ] OPTIONAL ).
            MOVE-CORRESPONDING ls_agent_all TO <fs_agent_mt>.
           ELSE.
              DELETE et_agents_managing WHERE seqno = ls_last-seqno.
           ENDIF.
        ENDLOOP.
      ENDIF.
       ev_agents_managing_exist = COND #( WHEN  et_agents_managing IS NOT INITIAL THEN abap_true ELSE abap_false ).

      CALL METHOD zcl_ppm_workflow=>get_appr_route_fin
        EXPORTING
          iv_decision_guid = iv_decision_guid
          it_ppm030        = lt_all_approvers
        IMPORTING
          et_agents_fin    = lt_fin_agents.

       DATA(lt_fin_appr) = lt_fin_agents .

       et_agents_fin = VALUE #(
         FOR ls_fin  IN lt_fin_appr (
           seqno = ls_fin-seqno
                actor = VALUE #( ( otype     = ls_fin-otype
                                  objid    =  ls_fin-agentid ) )
              )
         ).
      IF et_agents_fin IS NOT INITIAL.
         LOOP AT et_agents_fin ASSIGNING FIELD-SYMBOL(<fs_agent_fin>).
            IF <fs_agent_fin>-seqno <> ls_last-seqno.
             ls_agent_all = VALUE #( it_agents_all[ seqno = <fs_agent_fin>-seqno ] OPTIONAL ).
             MOVE-CORRESPONDING ls_agent_all TO <fs_agent_fin>.
            ELSE.
              DELETE et_agents_fin WHERE seqno = ls_last-seqno.
            ENDIF.
         ENDLOOP.
       ENDIF.
       ev_agents_fin_exist = COND #( WHEN et_agents_fin  IS NOT INITIAL THEN abap_true ELSE abap_false ).
       IF lt_fin_agents IS NOT INITIAL.
         "Check YD-CFO exist in the Finance chain, then the notification to N-3 Finance.
          DATA(ls_cfo) = VALUE #( lt_fin_agents[ parvw = 'YD' ] OPTIONAL ).
          IF ls_cfo IS NOT INITIAL AND ls_cfo-agentid IS NOT INITIAL.
             LOOP AT lt_fin_agents INTO DATA(ls_user) WHERE parvw ='YS'. "N3-Finance
                 CLEAR: lt_return[],ls_user_data.
                 lv_username  = ls_user-agentid.
                 CALL FUNCTION 'BAPI_USER_GET_DETAIL'
                   EXPORTING
                     username = lv_username
                   IMPORTING
                     address  = ls_user_data
                   TABLES
                     return   = lt_return.
                 IF NOT ls_user_data-e_mail IS INITIAL.
                   CLEAR lw_address.
                   lw_address-e_mail = ls_user_data-e_mail.
                   APPEND lw_address TO et_wf_actor_n3fin.
                 ENDIF.
                 ""Remove N3-Finance - just receive Notification out of the approver chain
                 DELETE et_agents_fin WHERE seqno = ls_user-seqno .
            ENDLOOP.

          ENDIF.
       ENDIF.
        ev_wf_actor_n3fin = COND #( WHEN et_wf_actor_n3fin IS NOT INITIAL THEN abap_true ELSE abap_false ).
      " ------------------------------------------------------------------
      " 3. GET CEO & FINAL CHAIN (Method GET_CEO_END_CHAIN)
      " ------------------------------------------------------------------
       CALL METHOD zcl_ppm_workflow=>get_ceo_end_chain
        EXPORTING
          iv_decision_guid = iv_decision_guid
          it_ppm030        = lt_all_approvers
        IMPORTING
          et_agents_ceo_chain    = lt_final_chain
        .

       et_agents_ceo_chain = VALUE #(
         FOR ls_ceo_chain  IN lt_final_chain (
           seqno = ls_ceo_chain-seqno
                actor = VALUE #( ( otype     = ls_ceo_chain-otype
                                  objid    =  ls_ceo_chain-agentid ) )
              )
         ).

        IF et_agents_ceo_chain IS NOT INITIAL.
         LOOP AT et_agents_ceo_chain ASSIGNING FIELD-SYMBOL(<fs_agent_ceo>).
             ls_agent_all = VALUE #( it_agents_all[ seqno = <fs_agent_ceo>-seqno ] OPTIONAL ).
             MOVE-CORRESPONDING ls_agent_all TO <fs_agent_ceo>.
         ENDLOOP.
        ENDIF.

      " In case of No CEO
       " 2. Fallback A: Grab the highest sequence approver in ZPPM030
        IF et_agents_ceo_chain IS INITIAL.
            ls_agent_all = VALUE #( it_agents_all[ seqno = ls_last-seqno ] OPTIONAL ).
            APPEND ls_agent_all TO et_agents_ceo_chain .
        ENDIF.

        ev_agents_ceo_exist = COND #( WHEN et_agents_ceo_chain IS NOT INITIAL THEN abap_true ELSE abap_false ).
      " ------------------------------------------------------------------
      " 4. Check for missing/unassigned agents across all routes
      " An unassigned agent occurs if the list is initial or AGENTID is blank/invalid (e.g., length <= 2)
      " ------------------------------------------------------------------
      LOOP AT lt_area_agents ASSIGNING FIELD-SYMBOL(<fs_area>).
        IF <fs_area>-agentid IS INITIAL OR strlen( <fs_area>-agentid ) <= 2.
          RETURN. " Fallback to sequential (ev_parallel remains initial)
        ENDIF.
      ENDLOOP.

      LOOP AT lt_mt_agents ASSIGNING FIELD-SYMBOL(<fs_mt>).
        IF <fs_mt>-agentid IS INITIAL OR strlen( <fs_mt>-agentid ) <= 2.
          RETURN. " Fallback to sequential (ev_parallel remains initial)
        ENDIF.
      ENDLOOP.

      LOOP AT lt_fin_agents ASSIGNING FIELD-SYMBOL(<fs_fin>).
        IF <fs_fin>-agentid IS INITIAL OR strlen( <fs_fin>-agentid ) <= 2.
          RETURN. " Fallback to sequential (ev_parallel remains initial)
        ENDIF.
      ENDLOOP.

       LOOP AT lt_final_chain ASSIGNING FIELD-SYMBOL(<fs_ceo>).
        IF <fs_ceo>-agentid IS INITIAL OR strlen( <fs_ceo>-agentid ) <= 2.
          RETURN. " Fallback to sequential (ev_parallel remains initial)
        ENDIF.
      ENDLOOP.


      " ------------------------------------------------------------------
      " 5. EVALUATE PARALLEL SWITCH CRITERIA
      " ------------------------------------------------------------------
      " Total parallel approvers in the middle tier (Area + MT + Finance)
      DATA(lv_parallel_count) = lines( et_agents_area ) + lines( et_agents_managing ) + lines( et_agents_fin ).

      ev_total_area_appr = lines( et_agents_area ).
      ev_total_mt_appr = lines( et_agents_managing  ).
      ev_total_fin_appr =  lines( et_agents_fin ).
      ev_total_final_appr =  lines( et_agents_ceo_chain ).

      " RULE 1: If there are 0 or only 1 parallel approvers, run Sequential
      IF lv_parallel_count <= 1.
        ev_parallel = abap_false.
        RETURN.
      ENDIF.

      " RULE 2: If flow is strictly Level 1 (P3) directly into CEO/Final Chain with NO parallel middle steps
      IF lt_first_agent IS NOT INITIAL
         AND lt_final_chain IS NOT INITIAL
         AND lv_parallel_count = 0.
        ev_parallel = abap_false.
        RETURN.
      ENDIF.

      " RULE 3: If 2 or more valid parallel approvers exist across middle routes -> Enable Parallel Path
      IF lv_parallel_count >= 2.
        DATA(lv_parallel_count_area) = lines( et_agents_area  ).
        DATA(lv_parallel_count_mt) = lines( et_agents_managing ).
        DATA(lv_parallel_count_fin) = lines( et_agents_fin ).

        IF lv_parallel_count_area > 0.
          DATA(lv_count) = 1.
        ENDIF.
        IF lv_parallel_count_mt > 0.
         lv_count = lv_count + 1.
        ENDIF.
        IF lv_parallel_count_fin > 0.
         lv_count = lv_count + 1.
        ENDIF.
        IF lv_count >= 2 .
          ev_parallel = abap_true. " Route to Parallel process
        ELSE.
          ev_parallel = abap_false.
           RETURN.
        ENDIF.
      ELSE.
        ev_parallel = abap_false.
        RETURN.
      ENDIF.
    ENDIF.
  ENDMETHOD. "#EC CI_VALPAR
ENDCLASS.
