      SELECT SINGLE a~guid, a~external_id , b~text1
        FROM /rpm/bucket_d AS a
       INNER JOIN cgpl_text AS b
        ON a~guid = b~guid
      WHERE a~external_id = @lv_root_id
       INTO ( @DATA(lv_bucket_id_parent),@DATA(lv_ext_id_parent), @DATA(lv_bucket_name_parent) ).
      IF sy-subrc is INITIAL.
