* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_WORKFLOW=>CREATE_USER_EMAIL_LIST
* +-------------------------------------------------------------------------------------------------+
* | [--->] IT_ACL                         TYPE        /RPM/TT_ACO_PERMISSIONS
* | [--->] IV_OBJECT_TYPE                 TYPE        /RPM/OBJECT_TYPE
* | [--->] IV_WORKFLOW_ID                 TYPE        /RPM/TV_WF_ID(optional)
* | [<---] ET_USER_TAB                    TYPE        TSWHACTOR
* | [<---] ET_EMAIL_TAB                   TYPE        /RPM/TT_WF_ACTORS
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD CREATE_USER_EMAIL_LIST.

  DATA: lt_wf_recipient TYPE /rpm/tt_wf_recip,
        ls_wf_recipient TYPE /rpm/wf_recip,
        ls_acl          TYPE /rpm/ts_aco_permission,
        ls_actor        TYPE swhactor,
        lv_email        TYPE so_name.

* Read recipient configuration from /RPM/WF_RECIP
  SELECT * INTO CORRESPONDING FIELDS OF TABLE lt_wf_recipient
      FROM /rpm/wf_recip
      WHERE object_type EQ iv_object_type
      AND   wf_id EQ iv_workflow_id.

  LOOP AT it_acl INTO ls_acl.

    READ TABLE lt_wf_recipient INTO ls_wf_recipient WITH KEY activity_type = ls_acl-activity.

    IF sy-subrc EQ 0.
*     Get Users
      ls_actor-objid = ls_acl-user.
      ls_actor-otype = 'US'.
      APPEND ls_actor TO et_user_tab.
      CLEAR ls_actor.

*     Get email IDs
      lv_email = ls_acl-email.
      APPEND lv_email TO et_email_tab.
      CLEAR lv_email.
    ENDIF.

  ENDLOOP.

  SORT et_user_tab.
  DELETE ADJACENT DUPLICATES FROM et_user_tab.

  SORT et_email_tab.
  DELETE ADJACENT DUPLICATES FROM et_email_tab.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_WORKFLOW=>GET_CATEGORY_WFTYPE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_BUCKET_ID_CHILD             TYPE        /RPM/TV_EXTID
* | [--->] IV_DECISION_GUID               TYPE        RPM_TV_GUID
* | [<---] EV_ZCATEGORY                   TYPE        ZDE_CATEGORY
* | [<---] ET_MSG                         TYPE        /RPM/TT_MESSAGES
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD GET_CATEGORY_WFTYPE.
***********************************************************************
*  M O D I F I C A T I O N    L O G                                   *
***********************************************************************
*    Date   | TR Number  | Developement/  |       Description         *
*           |            | Modification   |                           *
***********************************************************************
*29.01.2026  DSDK9A07KC   #CHG0029188   Log Issue E457
*                                           Update new Logic to
*                                          DoA list for approval
*                                          to get Category
*
*---------------------------------------------------------------------
    DATA:
    lv_zbucket_parent   TYPE  /rpm/tv_extid,
    lv_zzcomcat         TYPE  zcomponentisation_category,
    lv_phase_id         TYPE  rpm_tv_extid,
    lv_zcep_value       TYPE  /rpm/tv_curr_amount,
    lv_zplaned          TYPE  zplan_status,
    lv_zcategory        TYPE  zde_category,
    lv_study_cost       TYPE /rpm/tv_curr_amount.

    "Bucket Parent ID
      SELECT SINGLE * FROM /rpm/decision INTO @DATA(ls_attributes_new)
                            WHERE guid = @iv_decision_guid.
      CHECK sy-subrc IS INITIAL.
      "Call method to get Bucket Parent ID.

       CALL METHOD zcl_ppm_workflow=>get_parent_bucket_by_extid
         EXPORTING
           bucket_extid_child =     iv_bucket_id_child
         IMPORTING
           bucket_guid_parent =     DATA(lv_bucket_guid_parent)" Guid for application objects
           bucket_id_parent   =     DATA(lv_bucket_id_parent)" Business Object ID
           bucket_name_parent =     DATA(lv_bucket_name_parent)" Name
         .
      lv_zbucket_parent = COND #( WHEN lv_bucket_id_parent IS NOT INITIAL THEN  lv_bucket_id_parent   ELSE '' ).

      " C&CT Sub Category && Plan Status
      SELECT SINGLE * FROM /rpm/item_d INTO @DATA(ls_item)
                              WHERE guid = @ls_attributes_new-item_guid.
      IF sy-subrc IS INITIAL.
        "" C&CT Sub Category
        lv_zzcomcat = COND #( WHEN ls_item-zzcomcat IS NOT INITIAL THEN  ls_item-zzcomcat  ELSE '' ).
        "" Plan Status
        lv_zplaned = COND #( WHEN ls_item-zzplanst IS NOT INITIAL THEN  ls_item-zzplanst   ELSE '' ).
      ENDIF.
      "Phase ID/Decision ID
      lv_phase_id = COND #( WHEN ls_attributes_new-decision_id IS NOT INITIAL THEN  ls_attributes_new-decision_id  ELSE '' ).
****** Get TEC Amount/ CEP Value(TEC AMT) ----------------------------------------------
      CALL METHOD zcl_ppm_common=>get_approval_amt
        EXPORTING
          iv_guid   =     ls_attributes_new-guid
        IMPORTING
          ev_amount =     lv_zcep_value  .

***** Calculate Study cost.-------------------------------------------------------------
      lv_study_cost = 0.
      CALL FUNCTION 'ZPPM_FM_WF_STUDIES_COST_CALC'
        EXPORTING
          iv_item_guid         = ls_attributes_new-item_guid
          iv_decision_id       = ls_attributes_new-decision_id
       IMPORTING
         ev_study_cost        = lv_study_cost
                .

****************************************************************************************

    CALL FUNCTION 'ZPPM_FM_WF_DETERMINE_CATGORY'
      EXPORTING
        iv_zbucket_parent       = lv_zbucket_parent
        iv_zzcomcat             = lv_zzcomcat
        iv_phase_id             = lv_phase_id
        iv_zcep_value           = lv_zcep_value
        iv_study_cost           = lv_study_cost
        iv_zplaned              = lv_zplaned
     IMPORTING
       ev_zcategory              = lv_zcategory
      TABLES
        et_msg                  = et_msg
              .
    ev_zcategory =  COND #( WHEN lv_zcategory IS NOT INITIAL THEN  lv_zcategory  ELSE '' ).
  ENDMETHOD."#EC CI_VALPAR


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_PPM_WORKFLOW=>GET_PARENT_BUCKET
* +-------------------------------------------------------------------------------------------------+
* | [--->] BUCKET_GUID_CHILD              TYPE        /RPM/TV_GUID
* | [<---] BUCKET_GUID_PARENT             TYPE        /RPM/TV_GUID
* | [<---] BUCKET_ID_PARENT               TYPE        /RPM/TV_EXTID
* | [<---] BUCKET_NAME_PARENT             TYPE        /RPM/TV_SHARED_DESCRIPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_parent_bucket.

    CHECK bucket_guid_child IS NOT INITIAL.

    DATA lv_root_id TYPE /rpm/tv_extid.

    SELECT SINGLE a~external_id
      FROM /rpm/bucket_d AS a
    WHERE a~guid = @bucket_guid_child
     INTO ( @DATA(lv_ext_id) ).
    IF sy-subrc IS INITIAL.

      lv_root_id = lv_ext_id+0(2).

      SELECT SINGLE a~guid, a~external_id , b~text1
        FROM /rpm/bucket_d AS a
       INNER JOIN cgpl_text AS b
        ON a~guid = b~guid
      WHERE a~external_id = @lv_root_id
       INTO ( @DATA(lv_bucket_id_parent),@DATA(lv_ext_id_parent), @DATA(lv_bucket_name_parent) ).
      IF sy-subrc is INITIAL.
          bucket_id_parent    = lv_ext_id_parent.
          bucket_guid_parent  = lv_bucket_id_parent.
          bucket_name_parent  = lv_bucket_name_parent.
      ENDIF.
    ENDIF.
  ENDMETHOD.


